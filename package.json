{
  "name": "@holycodex/workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate:codex": "bun scripts/generate-codex-bindings.ts",
    "check": "bun run --parallel generate:codex fmt:check lint",
    "check:fix": "bun run --parallel fmt:write lint:fix",
    "fmt": "oxfmt",
    "fmt:write": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "bun run generate:codex && bun scripts/package-build.ts",
    "test": "bun run generate:codex && bun test",
    "validate": "bun scripts/validate.ts",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:set": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@openai/codex": "latest",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@opentui/core": "^0.5.14",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "effect": "^4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
