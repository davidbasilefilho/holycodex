{
  "name": "@holycodex/workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate:codex": "bun scripts/generate-codex-bindings.ts",
    "check": "bun run generate:codex && bun run fmt:check && bun run lint && bun run typecheck",
    "check:fix": "bun run fmt && bun run lint:fix && bun run typecheck",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check --deny-warnings .",
    "lint:fix": "oxlint --type-aware --type-check --fix .",
    "typecheck": "tsc --noEmit",
    "build": "bun run generate:codex && bun scripts/package-build.ts",
    "test": "bun run generate:codex && bun test",
    "validate": "bun scripts/validate.ts",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:set": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.1",
  "catalog": {
    "@opentui/core": "~0.5.10",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "effect": "^3.22.1",
    "oxfmt": "~0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
