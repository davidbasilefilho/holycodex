+        use std::sync::Arc;
+        use std::sync::Barrier;
+        use std::sync::atomic::AtomicBool;
+        use std::sync::atomic::Ordering;
+        use std::thread;
+
+        let workspace = tempfile::tempdir().unwrap();
+        let outside = tempfile::tempdir().unwrap();
+        let race_path = workspace.path().join("race.txt");
+        let replacement = workspace.path().join("replacement.txt");
+        let temporary_link = workspace.path().join("race.link");
+        let outside_file = outside.path().join("race.txt");
+        fs::write(&race_path, "inside").unwrap();
+        fs::write(&replacement, "inside").unwrap();
+        fs::write(&outside_file, "outside-secret").unwrap();
+
+        let root = Arc::new(Dir::open_ambient_dir(workspace.path(), ambient_authority()).unwrap());
+        let start = Arc::new(Barrier::new(2));
+        let stop = Arc::new(AtomicBool::new(false));
+        let writer_start = Arc::clone(&start);
+        let writer_stop = Arc::clone(&stop);
+        let writer = thread::spawn(move || {
+            writer_start.wait();
+            while !writer_stop.load(Ordering::Relaxed) {
+                let _ = fs::remove_file(&temporary_link);
+                if std::os::unix::fs::symlink(&outside_file, &temporary_link).is_ok() {
+                    let _ = fs::rename(&temporary_link, &race_path);
+                    thread::yield_now();
+                    let _ = fs::rename(&replacement, &race_path);
+                    let _ = fs::write(&replacement, "inside");
+                }
+            }
+        });
+        start.wait();
+        for _ in 0..20_000 {
+            let Ok(entries) = root.entries() else {
+                continue;
+            };
+            for entry in entries.flatten() {
+                if entry.file_name() != "race.txt" {
+                    continue;
+                }
+                if let Ok(mut opened) = entry.open() {
+                    let mut contents = String::new();
+                    opened.read_to_string(&mut contents).unwrap();
+                    assert_eq!(contents, "inside");
+                }
+            }
+        }
+        stop.store(true, Ordering::Relaxed);
+        writer.join().unwrap();
+    }
