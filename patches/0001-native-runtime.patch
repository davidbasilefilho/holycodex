+    pub(crate) writable_roots: Vec<PathUri>,
+    /// Current specialist permissions, captured from host policy.
+    pub(crate) permission_profile: PermissionProfile,
+    /// Parent Root permission snapshot accepted when this authority was bound.
+    /// A changed Root profile invalidates specialist host-tool access until rebind.
+    pub(crate) root_permission_lease: crate::holycodex_identity::RootPermissionLease,
+    /// Replaced on each finalized router build. An empty value means no live
+    /// host registry has authorized this thread yet.
+    pub(crate) actual_tool_grants: Arc<Mutex<Option<BTreeSet<ToolName>>>>,
+    /// Shared current Root ceiling; permission reductions revoke existing
+    /// specialists on their next call.
