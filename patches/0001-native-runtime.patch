+            })
+            .unwrap();
+        assert!(!is_new);
+        assert_eq!(assignment.specialist_id.as_deref(), Some(reserved.as_str()));
+
+        // A default local control has no manager, so child restoration fails at the first
+        // pre-send seam. Dispatch must release this reused reservation and leave the old worker
+        // available; no send was attempted and ownership was never ambiguous.
+        let result = controller
+            .reuse(&assignment, "follow-up input".into())
+            .await;
+        let error = match result {
+            Err(error @ LaunchError::BeforeCreation(_)) => error,
+            Err(LaunchError::Acknowledgement(_)) => {
+                panic!("child restoration failure was misclassified as an ambiguous send")
+            }
+            Ok(_) => panic!("child restoration unexpectedly succeeded"),
+        };
+        let error = controller
+            .resolve_launch_error(&assignment.id, &reserved, is_new, error)
+            .unwrap();
+        assert!(matches!(error, ControllerError::Agent(_)));
+
+        let state = controller.snapshot().unwrap();
+        assert_eq!(state.assignments, vec![previous]);
+        assert!(!state.launching.contains(&assignment.id));
+        assert!(state.specialists[&reserved].idle);
+        assert!(!state.execution_errors.contains_key(&assignment.id));
+    }
