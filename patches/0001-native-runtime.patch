+/// Native runtime implementation of the controller's specialist authority contract.
+///
+/// It intersects canonical route grants with the live Root tool binding and
+/// uses the local runtime's typed reallocation operation for loaded specialists.
+pub(crate) struct SessionSpecialistAuthority {
+    control: LocalAgentControl,
+    root_thread: ThreadId,
+    root_config: Config,
+    root_grants: Arc<Mutex<RootAuthorityGrants>>,
