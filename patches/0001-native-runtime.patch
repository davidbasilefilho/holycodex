+/// Stable sidecar files are never replaced or deleted. Each transaction opens its
+/// own handle so independent instances in one process also contend on the OS lock.
+struct FileLock(File);
+impl FileLock {
+    fn file(path: &Path) -> Result<File, ControllerError> {
+        Ok(OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .open(path)?)
+    }
+    fn acquire(path: &Path) -> Result<Self, ControllerError> {
+        let file = Self::file(path)?;
+        file.lock()?;
+        Ok(Self(file))
+    }
+    fn try_acquire(path: &Path) -> Result<Option<Self>, ControllerError> {
+        let file = Self::file(path)?;
+        match file.try_lock() {
+            Ok(()) => Ok(Some(Self(file))),
+            Err(TryLockError::WouldBlock) => Ok(None),
+            Err(TryLockError::Error(error)) => Err(error.into()),
+        }
+    }
+}
+impl Drop for FileLock {
+    fn drop(&mut self) {
+        let _ = self.0.unlock();
+    }
+}
+
+struct StateStore {
+    path: PathBuf,
+    cache: Arc<Mutex<ControllerState>>,
+}
+impl StateStore {
+    fn open(dir: &Path, intent: Intent) -> Result<Self, ControllerError> {
+        fs::create_dir_all(dir)?;
+        let path = dir.join(STATE_FILE);
+        let _lock = FileLock::acquire(&path.with_extension("lock"))?;
+        let state = if path.exists() {
+            Self::load(&path)?
+        } else if dir.join(LEGACY_STATE_FILE).exists() {
+            let legacy_path = dir.join(LEGACY_STATE_FILE);
+            let state: ControllerState = serde_json::from_slice(&fs::read(legacy_path)?)?;
+            state.validate()?;
+            Self::persist(&path, &state)?;
+            state
+        } else {
+            // Root identity starts at revision zero; the controller's accepted
+            // Intent starts at revision one so policy-state validation can
+            // distinguish an initialized task from an uninitialized record.
+            let mut intent = intent;
+            if intent.revision == 0 {
+                intent.revision = 1;
+            }
+            let state = ControllerState {
+                intent,
+                assignments: Vec::new(),
+                specialists: BTreeMap::new(),
+                launching: BTreeSet::new(),
+                cancellation_requested: BTreeSet::new(),
+                finish_reports: BTreeMap::new(),
+                execution_errors: BTreeMap::new(),
+                ambiguous_reused_launches: BTreeSet::new(),
+            };
+            state.validate()?;
+            Self::persist(&path, &state)?;
+            state
+        };
+        Ok(Self {
+            path,
+            cache: Arc::new(Mutex::new(state)),
+        })
+    }
+    fn load(path: &Path) -> Result<ControllerState, ControllerError> {
+        let state: ControllerState = toml::from_str(&fs::read_to_string(path)?)?;
+        state.validate()?;
+        Ok(state)
+    }
+    fn persist(path: &Path, state: &ControllerState) -> Result<(), ControllerError> {
+        state.validate()?;
+        crate::path_utils::write_atomically(path, &toml::to_string_pretty(state)?)?;
+        Ok(())
+    }
+    fn read(&self) -> Result<ControllerState, ControllerError> {
+        let _lock = FileLock::acquire(&self.path.with_extension("lock"))?;
+        let mut cache = self.cache.lock().map_err(|_| ControllerError::Poisoned)?;
+        *cache = Self::load(&self.path)?;
+        Ok(cache.clone())
+    }
+    fn transaction<T>(
+        &self,
+        operation: impl FnOnce(&mut ControllerState) -> Result<T, ControllerError>,
+    ) -> Result<T, ControllerError> {
+        let _lock = FileLock::acquire(&self.path.with_extension("lock"))?;
+        let mut cache = self.cache.lock().map_err(|_| ControllerError::Poisoned)?;
+        let mut next = Self::load(&self.path)?;
+        let previous = next.clone();
+        let result = operation(&mut next)?;
+        next.validate()?;
+        if next != previous {
+            Self::persist(&self.path, &next)?;
+        }
+        *cache = next;
+        Ok(result)
+    }
+    fn operation_path(&self, id: &str) -> Result<PathBuf, ControllerError> {
+        parse_thread_id(id)?;
+        Ok(self.path.with_file_name(format!("assignment-{id}.lock")))
+    }
+    fn operation_lock(&self, id: &str) -> Result<FileLock, ControllerError> {
+        FileLock::acquire(&self.operation_path(id)?)
+    }
+    fn operation_active(&self, id: &str) -> Result<bool, ControllerError> {
+        Ok(FileLock::try_acquire(&self.operation_path(id)?)?.is_none())
+    }
+}
