+    #[tokio::test]
+    async fn siwc_refresh_uses_isolated_endpoint_and_issued_client() -> anyhow::Result<()> {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/siwc/token"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+                "access_token": "refreshed-access",
+                "refresh_token": "refreshed-refresh",
+                "scope": "openid resource.invoke chatgpt.tokens.use.direct",
+                "expires_in": 3600,
+            })))
+            .expect(1)
+            .mount(&server)
+            .await;
+
+        let registration: crate::siwc::RegistrationMetadata =
+            serde_json::from_value(serde_json::json!({
+                "issuer": crate::siwc::ISSUER,
+                "subject": "test-subject",
+                "client_id": "oaiapp_isolated-test",
+                "ext_agent_host_id": "host-test",
+                "scopes": ["openid", "resource.invoke", "chatgpt.tokens.use.direct"],
+                "expires_at": 4_000_000_000_u64,
+                "authorization_nonce": "test-nonce",
+            }))?;
+        let endpoint = format!("{}/siwc/token", server.uri());
+        let route = crate::test_support::transport_default_auth_route_config();
+        let client = create_default_auth_client(&endpoint, &route)?;
+        let response = request_chatgpt_token_refresh(
+            "original-refresh".to_string(),
+            &client,
+            Some(&registration),
+            &endpoint,
+        )
+        .await?;
+
+        assert_eq!(response.access_token.as_deref(), Some("refreshed-access"));
+        assert_eq!(response.refresh_token.as_deref(), Some("refreshed-refresh"));
+        assert_eq!(response.expires_in, 3600);
+        let requests = server
+            .received_requests()
+            .await
+            .ok_or_else(|| anyhow::anyhow!("mock server stopped before receiving request"))?;
+        assert_eq!(requests.len(), 1);
+        let form: std::collections::HashMap<_, _> = url::form_urlencoded::parse(&requests[0].body)
+            .into_owned()
+            .collect();
+        assert_eq!(
+            form.get("client_id").map(String::as_str),
+            Some("oaiapp_isolated-test")
+        );
+        assert_eq!(
+            form.get("refresh_token").map(String::as_str),
+            Some("original-refresh")
+        );
+        assert_eq!(
+            form.get("resource").map(String::as_str),
+            Some(crate::siwc::RESOURCE)
+        );
+        assert!(!form.contains_key("client_secret"));
+        server.verify().await;
+        Ok(())
+    }
