+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn changed_native_model_contract_rejects_resume_before_sampling() -> Result<()> {
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![sse(vec![
+            ev_response_created("resp-hc-tamper-1"),
+            ev_assistant_message("msg-hc-tamper-1", "initial response"),
+            ev_completed("resp-hc-tamper-1"),
+        ])],
+    )
+    .await;
+    let mut builder = test_codex().with_model("gpt-6.1-sol");
+    let initial = builder.build_with_auto_env(&server).await?;
+    let identity_path = initial
+        .codex_home_path()
+        .join("holycodex")
+        .join("threads")
+        .join(initial.session_configured.thread_id.to_string())
+        .join("intent.toml");
+    initial
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "persist native contract".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&initial.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let mut identity: toml::Value = toml::from_str(&std::fs::read_to_string(&identity_path)?)?;
+    let contracts = identity
+        .get_mut("threads")
+        .and_then(toml::Value::as_table_mut)
+        .context("native contracts table")?;
+    let root_contract = contracts
+        .iter_mut()
+        .map(|(_, value)| value)
+        .next()
+        .and_then(toml::Value::as_table_mut)
+        .context("Root contract")?;
+    root_contract.insert("model".into(), toml::Value::String("gpt-6-luna".into()));
+    std::fs::write(&identity_path, toml::to_string(&identity)?)?;
+
+    let mut resume_builder = test_codex().with_model("gpt-6.1-sol");
+    assert!(resume_builder.restart(&server, &initial).await.is_err());
+    assert_eq!(responses.requests().len(), 1);
+    Ok(())
+}
