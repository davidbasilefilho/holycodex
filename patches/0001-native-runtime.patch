+pub(crate) fn shell_artifact_cache_id(thread_id: ThreadId, workspace: &PathUri) -> String {
+    let mut hasher = DefaultHasher::new();
+    workspace.inferred_native_path_string().hash(&mut hasher);
+    format!("{thread_id}-{:016x}", hasher.finish())
+}
