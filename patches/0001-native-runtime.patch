+mod tests {
+    use super::*;
+    use crate::holycodex_identity::RootAuthorityGrants;
+    use crate::tools::holycodex_tools::tests::test_binding;
+    use codex_protocol::models::PermissionProfile;
+    use codex_utils_path_uri::PathUri;
+    use holycodex_policy::Capability;
+    use holycodex_policy::Mutability;
+    use std::sync::Mutex;
+
+    #[test]
+    fn readonly_root_reduction_blocks_previous_writable_reallocation() {
+        let (_dir, mut binding) = test_binding(HolyCodexPrincipal::specialist("a-1".into()));
+        binding.capabilities = [Capability::RepositoryRead, Capability::FilesystemWrite].into();
+        binding.max_mutability = Mutability::ScopedWrite;
+        binding.ownership_paths = ["src".to_owned()].into();
+        let absolute_write_root = codex_utils_absolute_path::AbsolutePathBuf::try_from(
+            std::env::current_dir().unwrap().join("src"),
+        )
+        .unwrap();
+        binding.writable_roots = vec![PathUri::from_abs_path(&absolute_write_root)];
+        binding.allowed_tools = ["exec_command", "apply_patch"]
+            .into_iter()
+            .map(codex_extension_api::ToolName::plain)
+            .collect();
+        let mut root = RootAuthorityGrants {
+            max_mutability: Mutability::ScopedWrite,
+            ownership_paths: ["src".to_owned()].into(),
+            capabilities: [Capability::RepositoryRead, Capability::FilesystemWrite].into(),
+            allowed_tools: binding.allowed_tools.clone(),
+            writable_roots: binding.writable_roots.clone(),
+            permission_profile: PermissionProfile::read_only(),
+            permission_lease: binding.root_permission_lease.clone(),
+            actual_tool_grants: Arc::new(Mutex::new(Some(binding.allowed_tools.clone()))),
+        };
+        assert!(live_root_authority_covers(
+            &root,
+            &binding.capabilities,
+            binding.max_mutability,
+            &binding.ownership_paths,
+            &binding.allowed_tools,
+            &binding.writable_roots,
+            &binding.root_permission_lease,
+        ));
+
+        root.ownership_paths = [".".to_owned()].into();
+        binding.ownership_paths = ["src/../outside".to_owned()].into();
+        assert!(!live_root_authority_covers(
+            &root,
+            &binding.capabilities,
+            binding.max_mutability,
+            &binding.ownership_paths,
+            &binding.allowed_tools,
+            &binding.writable_roots,
+            &binding.root_permission_lease,
+        ));
+        binding.ownership_paths = ["src".to_owned()].into();
+
+        binding.root_permission_lease.permission_profile = PermissionProfile::workspace_write();
+        assert!(!live_root_authority_covers(
+            &root,
+            &binding.capabilities,
+            binding.max_mutability,
+            &binding.ownership_paths,
+            &binding.allowed_tools,
+            &binding.writable_roots,
+            &binding.root_permission_lease,
+        ));
+        binding.root_permission_lease = root.permission_lease.clone();
+        let current_cwd = binding.root_permission_lease.cwd.clone();
+        binding
+            .root_permission_lease
+            .workspace_roots
+            .push(current_cwd);
+        assert!(!live_root_authority_covers(
+            &root,
+            &binding.capabilities,
+            binding.max_mutability,
+            &binding.ownership_paths,
+            &binding.allowed_tools,
+            &binding.writable_roots,
+            &binding.root_permission_lease,
+        ));
+        binding.root_permission_lease = root.permission_lease.clone();
+
+        root.max_mutability = Mutability::ReadOnly;
+        root.ownership_paths.clear();
+        root.capabilities.remove(&Capability::FilesystemWrite);
+        root.allowed_tools
+            .remove(&codex_extension_api::ToolName::plain("apply_patch"));
+        root.writable_roots.clear();
+        root.permission_profile = PermissionProfile::read_only();
+        assert!(!live_root_authority_covers(
+            &root,
+            &binding.capabilities,
+            binding.max_mutability,
+            &binding.ownership_paths,
+            &binding.allowed_tools,
+            &binding.writable_roots,
+            &binding.root_permission_lease,
+        ));
+    }
