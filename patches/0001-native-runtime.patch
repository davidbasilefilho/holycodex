+pub(crate) fn shell_artifact_root(temporary_root: &PathUri, cache_id: &str) -> Option<PathUri> {
+    let cache_suffix = cache_id
+        .chars()
+        .filter(|character| character.is_ascii_alphanumeric() || matches!(*character, '-' | '_'))
+        .collect::<String>();
+    if cache_suffix.is_empty() {
+        return None;
+    }
+    temporary_root
+        .join(&format!("holycodex-cargo-target-{cache_suffix}"))
+        .ok()
+}
