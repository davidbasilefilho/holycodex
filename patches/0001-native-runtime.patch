+fn shell_authorization_for_invocation(
+    invocation: &ToolInvocation,
+    binding: &crate::tools::holycodex_tools::HolyCodexToolBinding,
+) -> Option<crate::tools::holycodex_tools::ShellInvocationAuthorization> {
+    let ToolPayload::Function { arguments } = &invocation.payload else {
+        return None;
+    };
+    let payload: ShellAuthorizationPayload = serde_json::from_str(arguments).ok()?;
+    let environments = &invocation.step_context.environments;
+    let environment = match payload.environment_id.as_deref() {
+        Some(environment_id) => environments
+            .turn_environments()
+            .find(|environment| environment.selection.environment_id == environment_id)?,
+        None => environments.primary()?,
+    };
+    let workspace_root = environment.selection.cwd.clone();
+    let cwd = workspace_root
+        .join(payload.workdir.as_deref().unwrap_or(""))
+        .ok()?;
+    Some(
+        crate::tools::holycodex_tools::ShellInvocationAuthorization {
+            command: payload.cmd,
+            cwd,
+            artifact_cache_id: crate::tools::holycodex_tools::shell_artifact_cache_id(
+                binding.caller,
+                &workspace_root,
+            ),
+            temporary_directories: environment
+                .temporary_directories
+                .clone()
+                .unwrap_or_default(),
+            sandbox_permissions: payload.sandbox_permissions.unwrap_or_default(),
+            additional_permissions: payload.additional_permissions,
+        },
+    )
+}
