+    model.max_context_window = Some(400_000);
+    let config = ModelsManagerConfig {
+        model_context_window: Some(320_000),
+        ..Default::default()
+    };
+
+    let updated = with_config_overrides(model, &config);
+
+    assert_eq!(updated.context_window, Some(320_000));
+    assert_eq!(updated.max_context_window, Some(400_000));
+    assert_eq!(updated.auto_compact_token_limit, Some(304_000));
+    assert_eq!(updated.auto_compact_token_limit(), Some(288_000));
+}
+
+#[test]
+fn unrelated_models_keep_upstream_context_policy() {
+    let mut model = model_info_from_slug("other-model");
+    model.context_window = Some(128_000);
+    model.max_context_window = Some(256_000);
+    model.auto_compact_token_limit = Some(90_000);
+
+    let updated = with_config_overrides(model.clone(), &ModelsManagerConfig::default());
+
+    assert_eq!(updated, model);
+}
+
+#[test]
+fn explicit_override_cannot_invent_capacity_when_provider_omits_maximum() {
+    let mut model = model_info_from_slug("gpt-6-luna");
+    model.max_context_window = None;
+    model.context_window = Some(272_000);
+    let config = ModelsManagerConfig {
+        model_context_window: Some(800_000),
+        ..Default::default()
+    };
+    let resolved = with_config_overrides(model, &config);
+    assert_eq!(resolved.context_window, Some(272_000));
+    assert_eq!(resolved.max_context_window, None);
+    assert_eq!(resolved.auto_compact_token_limit(), Some(244_800));
+}
