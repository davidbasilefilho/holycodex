+        contracts.insert(root.to_string(), root_contract(root));
+        Ok(())
+    })
+    .expect("initialize Root identity");
+    let barrier = Arc::new(Barrier::new(2));
+    let specialists = [ThreadId::new(), ThreadId::new()];
+    std::thread::scope(|scope| {
+        for thread in specialists {
+            let barrier = Arc::clone(&barrier);
+            let home = home.path();
+            scope.spawn(move || {
+                let contract = specialist_contract(root, thread);
+                barrier.wait();
+                update_identity(home, root, |_intent, contracts| {
