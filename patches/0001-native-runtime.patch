+/// Preserve Root's host registry. Restrict specialist host tools to the effective
+/// Assignment allowlist and remove raw orchestration from every HolyCodex registry.
+pub(crate) fn constrain_tool_registry(
+    registry: &mut crate::tools::registry::ToolRegistry,
+    binding: &HolyCodexToolBinding,
+) {
+    constrain_registry_for_profile(registry, &binding.principal, &binding.allowed_tools);
+}
+
+/// Intersect Assignment-authorized names with the actual Root host registry.
+/// Raw orchestration and Holy lifecycle names are never specialist host grants.
+pub fn intersect_host_tool_grants(
+    registry: &crate::tools::registry::ToolRegistry,
+    assignment_grants: &BTreeSet<ToolName>,
+) -> BTreeSet<ToolName> {
+    let assignment_grants = assignment_grants
+        .iter()
+        .cloned()
+        .map(ToolName::with_default_namespace)
+        .collect::<BTreeSet<_>>();
+    registry
+        .entries()
+        .filter_map(|entry| {
+            let name = entry.runtime.tool_name().with_default_namespace();
+            (assignment_grants.contains(&name)
+                && !is_raw_orchestration_name(&name.name)
+                && !is_holy_control_tool_name(&name.name))
+            .then_some(name)
+        })
+        .collect()
+}
+
+pub(crate) fn constrain_registry_for_profile(
+    registry: &mut crate::tools::registry::ToolRegistry,
+    principal: &HolyCodexPrincipal,
+    allowed_tools: &BTreeSet<ToolName>,
+) {
+    let allowed_tools = allowed_tools
+        .iter()
+        .cloned()
+        .map(ToolName::with_default_namespace)
+        .collect::<BTreeSet<_>>();
+    let remove = registry
+        .entries()
+        .filter_map(|entry| {
+            let name = entry.runtime.tool_name().with_default_namespace();
+            let allowed_holy_tool = if principal.is_root() {
+                ROOT_TOOLS.contains(&name.name.as_str())
+            } else {
+                SPECIALIST_TOOLS.contains(&name.name.as_str())
+            };
+            (is_raw_orchestration_name(&name.name)
+                || (is_holy_control_tool_name(&name.name) && !allowed_holy_tool)
+                || (!principal.is_root()
+                    && !is_holy_control_tool_name(&name.name)
+                    && !allowed_tools.contains(&name)))
+            .then_some(name)
+        })
+        .collect::<Vec<_>>();
+    for name in remove {
+        registry.remove(&name);
+    }
+}
+
+pub(crate) fn publish_actual_tool_grants(thread_store: &ExtensionData, tools: BTreeSet<ToolName>) {
+    let Some(binding) = thread_store.get::<HolyCodexToolBinding>() else {
+        return;
+    };
+    *binding
+        .actual_tool_grants
+        .lock()
+        .expect("grant lock poisoned") = Some(tools.clone());
+    thread_store.insert(ActualHostToolGrantSnapshot {
+        caller: binding.caller,
+        tools,
+        live: Arc::clone(&binding.actual_tool_grants),
+    });
+}
+
+pub(crate) fn invalidate_actual_tool_grants(thread_store: &ExtensionData) {
+    let Some(binding) = thread_store.get::<HolyCodexToolBinding>() else {
+        return;
+    };
+    *binding
+        .actual_tool_grants
+        .lock()
+        .expect("grant lock poisoned") = None;
+    thread_store.insert(ActualHostToolGrantSnapshot {
+        caller: binding.caller,
+        tools: BTreeSet::new(),
+        live: Arc::clone(&binding.actual_tool_grants),
+    });
+}
