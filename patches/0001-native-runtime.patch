+pub(crate) fn hosted_tool_allowed(binding: &HolyCodexToolBinding, tool: &ToolSpec) -> bool {
+    if is_raw_orchestration_name(tool.name()) {
+        return false;
+    }
+    binding.principal.is_root()
+        || (root_permission_lease_current(binding)
+            && match tool {
+                ToolSpec::WebSearch { .. } => binding.capabilities.contains(&Capability::Search),
+                _ => binding
+                    .allowed_tools
+                    .contains(&ToolName::plain(tool.name())),
+            })
+}
+
+fn root_permission_lease_current(binding: &HolyCodexToolBinding) -> bool {
+    binding
+        .root_authority
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .permission_lease
+        == binding.root_permission_lease
+}
+
+pub(crate) fn authorize_shell_invocation(
+    binding: &HolyCodexToolBinding,
+    invocation: Option<&ShellInvocationAuthorization>,
+) -> Result<(), FunctionCallError> {
+    if binding.principal.is_root() {
+        return Ok(());
+    }
+    let Some(invocation) = invocation else {
+        return Err(model_error(
+            "shell invocation arguments are invalid or unavailable",
+        ));
+    };
+    let root_authority = binding
+        .root_authority
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    if root_authority.permission_lease != binding.root_permission_lease {
+        return Err(model_error("Root's live permission lease changed"));
+    }
+    if invocation.sandbox_permissions == SandboxPermissions::RequireEscalated {
+        return Err(model_error(
+            "specialist shell calls cannot bypass Root's filesystem permission ceiling",
+        ));
+    }
+    let workspace_roots = root_authority
+        .permission_lease
+        .workspace_roots
+        .iter()
+        .map(PathUri::from_abs_path)
+        .collect::<Vec<_>>();
+    let mut root_roots = vec![PathUri::from_abs_path(&root_authority.permission_lease.cwd)];
+    root_roots.extend(workspace_roots.iter().cloned());
+    let mut artifact_roots = binding.writable_roots.clone();
+    let live_root_filesystem = root_authority
+        .permission_lease
+        .permission_profile
+        .file_system_sandbox_policy();
+    let root_cwd = PathUri::from_abs_path(&root_authority.permission_lease.cwd);
+    let root_policy_context = FileSystemSandboxPolicyContext {
+        cwd: &root_cwd,
+        workspace_roots: &workspace_roots,
+        user_home_dir: None,
+        temporary_directories: Some(&invocation.temporary_directories),
+    };
+    let permitted_temp_artifacts = invocation
+        .temporary_directories
+        .iter()
+        .filter_map(|temporary_root| {
+            let artifact_root = shell_artifact_root(temporary_root, &invocation.artifact_cache_id)?;
+            (live_root_filesystem.resolve_access(&artifact_root, &root_policy_context)
+                == FileSystemAccessMode::Write)
+                .then_some(artifact_root)
+        })
+        .collect::<Vec<_>>();
+    artifact_roots.extend(permitted_temp_artifacts.iter().cloned());
+    if shell_quality_command_requires_artifacts(&invocation.command)
+        && invocation
+            .temporary_directories
+            .first()
+            .and_then(|temporary_root| {
+                shell_artifact_root(temporary_root, &invocation.artifact_cache_id)
+            })
+            .is_none_or(|artifact_root| !permitted_temp_artifacts.contains(&artifact_root))
+    {
+        return Err(model_error(
+            "Root's live filesystem permissions do not allow a scoped temporary build artifact directory",
+        ));
+    }
+    if !path_uri_within_roots(&invocation.cwd, &root_roots)
+        || !read_only_shell_paths_within_roots(&invocation.command, &invocation.cwd, &root_roots)
+        || !test_build_paths_within_roots(
+            &invocation.command,
+            &invocation.cwd,
+            &root_roots,
+            &artifact_roots,
+        )
+        || (shell_npm_workspace_command(&invocation.command)
+            && !npm_workspace_command_uses_only_relative_paths(&invocation.command))
+        || !additional_permissions_within_roots(
+            invocation.additional_permissions.as_ref(),
+            invocation.sandbox_permissions,
+            &root_authority.permission_lease.permission_profile,
+            &root_roots,
+            &workspace_roots,
+            &binding.writable_roots,
+            &live_root_filesystem,
+            &root_policy_context,
+        )
+    {
+        return Err(model_error(
+            "shell invocation exceeds Root's live CWD, workspace, or Assignment permission ceiling",
+        ));
+    }
+    Ok(())
+}
+
+fn path_uri_within_roots(path: &PathUri, roots: &[PathUri]) -> bool {
+    roots.iter().any(|root| path.starts_with(root))
+}
+
+fn read_only_shell_paths_within_roots(command: &str, cwd: &PathUri, roots: &[PathUri]) -> bool {
+    let parsed = parse_shell_script(command);
+    if parsed
+        .iter()
+        .any(|parsed| matches!(parsed, ParsedCommand::Unknown { .. }))
+    {
+        return true;
+    }
+    parsed.iter().all(|parsed| {
+        let path = match parsed {
+            ParsedCommand::Read { path, .. } => Some(path.to_string_lossy().into_owned()),
+            ParsedCommand::ListFiles { path, .. } | ParsedCommand::Search { path, .. } => {
+                path.as_deref().map(str::to_owned)
+            }
+            ParsedCommand::Unknown { .. } => None,
+        };
+        path.is_none_or(|path| {
+            cwd.join(&path)
+                .is_ok_and(|resolved| path_uri_within_roots(&resolved, roots))
+        })
+    }) && shlex::split(command).is_some_and(|words| {
+        words
+            .iter()
+            .all(|word| !looks_like_path(word) || joined_path_within_roots(cwd, word, roots))
+    })
+}
+
+fn test_build_paths_within_roots(
+    command: &str,
+    cwd: &PathUri,
+    roots: &[PathUri],
+    artifact_roots: &[PathUri],
+) -> bool {
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    if !is_shell_quality_words(&words) {
+        return true;
+    }
+    let cargo_args_start = cargo_quality_command(&words).map(|(_, args_start)| args_start);
+    let is_cargo = cargo_args_start.is_some();
+    let mut index = cargo_args_start.unwrap_or(2);
+    while index < words.len() {
+        let word = &words[index];
+        let (option, inline_path) = word
+            .split_once('=')
+            .map_or((word.as_str(), None), |(option, path)| (option, Some(path)));
+        let path_option = is_cargo && option == "--manifest-path";
+        if path_option {
+            let path = if let Some(path) = inline_path {
+                path
+            } else {
+                index += 1;
+                let Some(path) = words.get(index) else {
+                    return false;
+                };
+                path
+            };
+            if !joined_path_within_roots(cwd, path, roots) {
+                return false;
+            }
+        } else if matches!(
+            option,
+            "--target-dir" | "--lockfile-path" | "--out-dir" | "--prefix" | "--cache"
+        ) {
+            let path = if let Some(path) = inline_path {
+                path
+            } else {
+                index += 1;
+                let Some(path) = words.get(index) else {
+                    return false;
+                };
+                path
+            };
+            if !joined_path_within_roots(cwd, path, artifact_roots) {
+                return false;
+            }
+        } else if (is_cargo && option == "--config")
+            || matches!(
+                option,
+                "--userconfig" | "--globalconfig" | "--cd" | "--justfile" | "--working-directory"
+            )
+        {
+            // These options can redirect build settings, caches, or task cwd in ways
+            // the bounded command parser cannot prove safe.
+            return false;
+        } else if looks_like_path(word) && !joined_path_within_roots(cwd, word, roots) {
+            return false;
+        }
+        index += 1;
+    }
+    true
+}
+
+fn joined_path_within_roots(cwd: &PathUri, path: &str, roots: &[PathUri]) -> bool {
+    !path.starts_with('~')
+        && cwd
+            .join(path)
+            .is_ok_and(|path| path_uri_within_roots(&path, roots))
+}
+
+fn looks_like_path(value: &str) -> bool {
+    value.starts_with('.')
+        || value.starts_with('/')
+        || value.starts_with('~')
+        || value.contains('\\')
+        || (value.contains('/') && !value.starts_with('@'))
+        || matches!(value.as_bytes(), [drive, b':', ..] if drive.is_ascii_alphabetic())
+}
+
+fn additional_permissions_within_roots(
+    additional: Option<&codex_protocol::models::AdditionalPermissionProfile>,
+    sandbox_permissions: SandboxPermissions,
+    root_profile: &PermissionProfile,
+    root_roots: &[PathUri],
+    workspace_roots: &[PathUri],
+    assignment_writable_roots: &[PathUri],
+    root_filesystem: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    root_policy_context: &FileSystemSandboxPolicyContext<'_>,
+) -> bool {
+    let Some(additional) = additional else {
+        return sandbox_permissions != SandboxPermissions::WithAdditionalPermissions;
+    };
+    if additional
+        .network
+        .as_ref()
+        .and_then(|network| network.enabled)
+        .is_some_and(|enabled| enabled && !root_profile.network_sandbox_policy().is_enabled())
+    {
+        return false;
+    }
+    let Some(filesystem) = &additional.file_system else {
+        return true;
+    };
+    filesystem.entries.iter().all(|entry| {
+        if entry.access == FileSystemAccessMode::Deny {
+            return true;
+        }
+        let allowed_roots = if entry.access == FileSystemAccessMode::Write {
+            assignment_writable_roots
+        } else {
+            root_roots
+        };
+        let is_allowed_path = |path: &PathUri| {
+            path_uri_within_roots(path, allowed_roots)
+                && match entry.access {
+                    FileSystemAccessMode::Deny => true,
+                    FileSystemAccessMode::Read => root_filesystem
+                        .resolve_access(path, root_policy_context)
+                        .can_read(),
+                    FileSystemAccessMode::Write => {
+                        root_filesystem.resolve_access(path, root_policy_context)
+                            == FileSystemAccessMode::Write
+                    }
+                }
+        };
+        match &entry.path {
+            FileSystemPath::Path { path } => is_allowed_path(path),
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::ProjectRoots { subpath },
+            } => {
+                let path = subpath.as_deref().unwrap_or("");
+                if !path.is_empty()
+                    && !crate::holycodex_identity::ownership_path_is_within(&path, ".")
+                {
+                    return false;
+                }
+                !workspace_roots.is_empty()
+                    && workspace_roots
+                        .iter()
+                        .all(|root| root.join(&path).is_ok_and(|path| is_allowed_path(&path)))
+            }
+            FileSystemPath::GlobPattern { .. } | FileSystemPath::Special { .. } => false,
+        }
+    })
+}
+
+pub(crate) fn authorize_tool_call(
+    binding: &HolyCodexToolBinding,
+    tool_name: &ToolName,
+    is_external: bool,
+    shell_command: Option<&str>,
+    current_permission_profile: &PermissionProfile,
+) -> Result<(), FunctionCallError> {
+    let actual = binding
+        .actual_tool_grants
+        .lock()
+        .expect("grant lock poisoned")
+        .clone();
+    if !actual.is_some_and(|tools| tools.contains(&tool_name.clone().with_default_namespace())) {
+        return Err(model_error(
+            "tool is absent from the live host tool registry",
+        ));
+    }
+    if is_raw_orchestration_name(&tool_name.name) {
+        return Err(model_error(
+            "raw agent orchestration is disabled for HolyCodex threads",
+        ));
+    }
+    if binding.principal.is_root() {
+        return Ok(());
+    }
+    if tool_name.name == "assignment.finish" {
+        return Ok(());
+    }
+    if !root_permission_lease_current(binding) {
+        return Err(model_error(
+            "specialist authority was revoked because Root's permission profile changed; rebind the Assignment to resume host tools",
+        ));
+    }
+    let root_authority = binding
+        .root_authority
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    let Some(root_actual_tools) = root_authority
+        .actual_tool_grants
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+    else {
+        return Err(model_error(
+            "Root's live host tool registry is unavailable; specialist authority is suspended",
+        ));
+    };
+    let root_actual_tools = root_actual_tools
+        .iter()
+        .map(|tool| tool.clone().with_default_namespace())
+        .collect::<BTreeSet<_>>();
+    let actual_capabilities_available = binding.capabilities.iter().all(|capability| {
+        let required_tool = match capability {
+            Capability::RepositoryRead | Capability::Search | Capability::Shell => {
+                Some(ToolName::plain("exec_command"))
+            }
+            Capability::FilesystemWrite => Some(ToolName::plain("apply_patch")),
+            Capability::VisualInspection => Some(ToolName::plain("view_image")),
+            Capability::BrowserUse | Capability::ComputerUse | Capability::Sites => None,
+        };
+        required_tool.is_none_or(|tool| root_actual_tools.contains(&tool.with_default_namespace()))
+    });
+    let capabilities_bounded = binding.capabilities.is_subset(&root_authority.capabilities);
+    let mutability_bounded =
+        mutability_rank(binding.max_mutability) <= mutability_rank(root_authority.max_mutability);
+    let tools_bounded = binding
+        .allowed_tools
+        .is_subset(&root_authority.allowed_tools);
+    let actual_tools_bounded = binding
+        .allowed_tools
+        .iter()
+        .all(|tool| root_actual_tools.contains(&tool.clone().with_default_namespace()));
+    let ownership_bounded = binding.ownership_paths.iter().all(|path| {
+        root_authority
+            .ownership_paths
+            .iter()
+            .any(|root| crate::holycodex_identity::ownership_path_is_within(path, root))
+    });
+    if !(capabilities_bounded
+        && mutability_bounded
+        && tools_bounded
+        && actual_tools_bounded
+        && actual_capabilities_available
+        && ownership_bounded)
+    {
+        return Err(model_error(
+            "specialist authority was revoked by Root's live permission profile",
+        ));
+    }
+    if !binding.allowed_tools.contains(tool_name) && tool_name.name != "assignment.finish" {
+        return Err(model_error(
+            "tool is not granted by this Assignment profile",
+        ));
+    }
+    if tool_name.name == "exec_command" {
+        if !assignment_permission_profile_is_bounded(binding, current_permission_profile)
+            || !shell_command.is_some_and(|command| is_safe_specialist_shell(command))
+            || (shell_command.is_some_and(is_shell_quality_command)
+                && !binding.capabilities.contains(&Capability::Shell))
+        {
+            return Err(model_error(
+                "shell execution is limited to scoped commands under the Assignment permission profile",
+            ));
+        }
+        return Ok(());
+    }
+    if tool_name.name == "write_stdin" {
+        return Err(model_error(
+            "persistent shell processes are unavailable to specialists",
+        ));
+    }
+    if tool_name.name == "apply_patch" {
+        if binding.max_mutability == Mutability::ReadOnly
+            || binding.writable_roots.is_empty()
+            || !assignment_permission_profile_is_bounded(binding, current_permission_profile)
+        {
+            return Err(model_error(
+                "this Assignment has no scoped filesystem-write authority",
+            ));
+        }
+        return Ok(());
+    }
+    if is_external && !has_host_tool_capability(&binding.capabilities) {
+        return Err(model_error(
+            "external tool lacks a granted host capability for this Assignment",
+        ));
+    }
+    if !is_known_read_only_tool(&tool_name.name) && !has_host_tool_capability(&binding.capabilities)
+    {
+        return Err(model_error(
+            "host tool lacks a granted capability for this Assignment",
+        ));
+    }
+    Ok(())
+}
+
+fn has_host_tool_capability(capabilities: &BTreeSet<Capability>) -> bool {
+    [
+        Capability::Search,
+        Capability::BrowserUse,
+        Capability::ComputerUse,
+        Capability::Sites,
+    ]
+    .iter()
+    .any(|capability| capabilities.contains(capability))
+}
+
+pub(crate) fn paths_within_assignment_scope(
+    binding: &HolyCodexToolBinding,
+    paths: &[PathUri],
+) -> bool {
+    !paths.is_empty()
+        && !binding.writable_roots.is_empty()
+        && paths.iter().all(|path| {
+            binding
+                .writable_roots
+                .iter()
+                .any(|root| path.starts_with(root))
+        })
+}
+
+fn is_raw_orchestration_name(name: &str) -> bool {
+    matches!(
+        name,
+        "spawn_agent"
+            | "send_input"
+            | "resume_agent"
+            | "wait_agent"
+            | "close_agent"
+            | "send_message"
+            | "followup_task"
+            | "interrupt_agent"
+            | "list_agents"
+    )
+}
+
+fn is_holy_control_tool_name(name: &str) -> bool {
+    ROOT_TOOLS.contains(&name) || SPECIALIST_TOOLS.contains(&name)
+}
+
+fn is_known_read_only_tool(name: &str) -> bool {
+    matches!(
+        name,
+        "current_time"
+            | "get_context_remaining"
+            | "view_image"
+            | "list_mcp_resources"
+            | "list_mcp_resource_templates"
+            | "read_mcp_resource"
+            | "tool_search"
+            | "assignment.finish"
+    )
+}
