+++ b/codex-rs/core/src/agent/control/holycodex_identity.rs
@@ -0,0 +1,437 @@
+use super::LocalAgentControl;
+use crate::holycodex_identity::NativeThreadContract;
+use crate::holycodex_identity::ReallocateSpecialistRequest;
+use crate::holycodex_identity::RootAuthorityGrants;
+use crate::holycodex_identity::RootPermissionLease;
+use crate::holycodex_identity::update_identity;
+use crate::holycodex_identity::validate_contract;
+use crate::tools::holycodex_tools::HolyCodexPrincipal;
+use crate::tools::holycodex_tools::HolyCodexToolBinding;
+use codex_protocol::SessionId;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::AgentStatus;
+use holycodex_policy::AssignmentStatus;
+use holycodex_policy::ModelId;
+use holycodex_policy::RoleTask;
+use holycodex_policy::route_policy;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+impl LocalAgentControl {
+    pub(crate) async fn holycodex_thread(
+        &self,
+        thread_id: ThreadId,
+    ) -> CodexResult<Arc<crate::codex_thread::CodexThread>> {
+        self.runtime.upgrade()?.get_thread(thread_id).await
+    }
+
+    pub(super) async fn reallocate_specialist_runtime(
+        &self,
+        mut request: ReallocateSpecialistRequest,
+    ) -> CodexResult<crate::codex_thread::ThreadConfigSnapshot> {
+        let root_id = ThreadId::from(self.session_id());
+        if root_id != request.caller_root || request.target == request.caller_root {
+            return Err(invalid(
+                "specialist reallocation caller is not the native Root",
+            ));
+        }
+        let state = self.runtime.upgrade()?;
+        let root = state.get_thread(request.caller_root).await?;
+        let target = state.get_thread(request.target).await?;
+        let root_snapshot = root.config_snapshot().await;
+        if root.session.session_id() != SessionId::from(request.caller_root)
+            || root_snapshot.session_source.is_non_root_agent()
+        {
+            return Err(invalid(
+                "specialist reallocation caller is not a Root session",
+            ));
+        }
+        if !Arc::ptr_eq(
+            &root.session.services.local_agent_runtime.registry,
+            &target.session.services.local_agent_runtime.registry,
+        ) {
+            return Err(invalid("target is outside Root's live agent tree"));
+        }
+        let root_binding = root
+            .thread_extension_data()
+            .get::<HolyCodexToolBinding>()
+            .ok_or_else(|| invalid("Root has no live HolyCodex tool binding"))?;
+        if !matches!(root_binding.principal, HolyCodexPrincipal::Root)
+            || root_binding.caller != request.caller_root
+            || !Arc::ptr_eq(&root_binding.controller, &request.binding.controller)
+        {
+            return Err(invalid(
+                "Root controller binding does not match the request",
+            ));
+        }
+        let live_root_settings = root.session.holycodex_root_authority_settings().await;
+        crate::holycodex_identity::refresh_root_authority_settings(
+            &root.thread_extension_data(),
+            &live_root_settings,
+            &root.session.tool_policy,
+        );
+        let root_authority = root_binding
+            .root_authority
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let actual_root_grants = root
+            .thread_extension_data()
+            .get::<crate::tools::holycodex_tools::ActualHostToolGrantSnapshot>()
+            .ok_or_else(|| invalid("Root has no finalized live host tool registry"))?;
+        if actual_root_grants.caller != request.caller_root
+            || !Arc::ptr_eq(&actual_root_grants.live, &root_binding.actual_tool_grants)
+            || root_binding
+                .actual_tool_grants
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .as_ref()
+                != Some(&actual_root_grants.tools)
+        {
+            return Err(invalid("Root's finalized tool grants are stale"));
+        }
+
+        let old_binding = target
+            .thread_extension_data()
+            .get::<HolyCodexToolBinding>()
+            .ok_or_else(|| invalid("target has no live specialist tool binding"))?;
+        if !matches!(old_binding.principal, HolyCodexPrincipal::Specialist { .. })
+            || !Arc::ptr_eq(&old_binding.controller, &root_binding.controller)
+            || old_binding.caller != request.target
+        {
+            return Err(invalid("target is not bound to this Root's controller"));
+        }
+        let snapshot = target.config_snapshot().await;
+        let target_status = target.agent_status().await;
+        if snapshot.parent_thread_id != Some(request.caller_root)
+            || snapshot.model != ModelId::Gpt6Luna.as_str()
+            || snapshot.permission_profile != old_binding.permission_profile
+            || !matches!(
+                target_status,
+                AgentStatus::Completed(_) | AgentStatus::Errored(_) | AgentStatus::Interrupted
+            )
+        {
+            return Err(invalid(
+                "target must be a quiescent direct child with matching live settings",
+            ));
+        }
+        // Serialize the no-active-turn check and settings commit against turn start.
+        let active_turn = target.session.active_turn.lock().await;
+        if active_turn.is_some() {
+            return Err(invalid("specialist is not quiescent"));
+        }
+
+        let route = route_policy(request.assignment.role)
+            .ok_or_else(|| invalid("unknown specialist Role.task"))?;
+        let required = route.capabilities.iter().copied().collect::<BTreeSet<_>>();
+        let target_id = request.target.to_string();
+        if request.assignment.status != AssignmentStatus::Ready
+            || request.assignment.role == RoleTask::Root
+            || request.assignment.specialist_id.as_deref() != Some(target_id.as_str())
+            || !matches!(
+                &request.binding.principal,
+                HolyCodexPrincipal::Specialist { assignment_id }
+                    if assignment_id == &request.assignment.id
+            )
+            || !required.is_subset(&root_authority.capabilities)
+            || request.binding.capabilities != required
+            || !live_root_authority_covers(
+                &root_authority,
+                &request.binding.capabilities,
+                request.binding.max_mutability,
+                &request.binding.ownership_paths,
+                &request.binding.allowed_tools,
+                &request.binding.writable_roots,
+                &request.binding.root_permission_lease,
+            )
+            || request.binding.root_permission_lease != root_authority.permission_lease
+            || request.binding.max_mutability != request.assignment.mutability
+            || request.binding.ownership_paths != request.assignment.metadata.ownership_paths
+            || !Arc::ptr_eq(
+                &request.binding.root_authority,
+                &root_binding.root_authority,
+            )
+            || request.contract.grants != request.binding.capabilities
+            || request.binding.permission_profile
+                != request.config.permissions.effective_permission_profile()
+        {
+            return Err(invalid(
+                "requested specialist contract exceeds Root's live grants",
+            ));
+        }
+        request.contract.assignment = Some(request.assignment.clone());
+        validate_contract(&request.contract).map_err(|error| invalid(&error.to_string()))?;
+        if request.contract.root_thread_id != request.caller_root.to_string()
+            || request.contract.thread_id != request.target.to_string()
+            || request.contract.role != request.assignment.role
+            || request.contract.model != ModelId::Gpt6Luna
+            || request.config.model.as_deref() != Some(ModelId::Gpt6Luna.as_str())
+            || request.config.model_reasoning_effort.as_ref()
+                != Some(&to_protocol_effort(request.contract.effort))
+        {
+            return Err(invalid(
+                "prepared session config does not match its typed contract",
+            ));
+        }
+        let visible_tools = request
+            .binding
+            .allowed_tools
+            .iter()
+            .map(|tool| tool.name.as_str())
+            .collect::<BTreeSet<_>>();
+        if [
+            "spawn_agent",
+            "send_input",
+            "resume_agent",
+            "wait_agent",
+            "close_agent",
+            "send_message",
+            "followup_task",
+            "interrupt_agent",
+            "list_agents",
+        ]
+        .iter()
+        .any(|name| visible_tools.contains(name))
+        {
+            return Err(invalid("specialist delegation must remain disabled"));
+        }
+
+        let mut old_contract = None;
+        update_identity(
+            &request.codex_home,
+            request.caller_root,
+            |intent, contracts| {
+                let canonical_intent = request.binding.controller.snapshot()?.intent;
+                if canonical_intent != request.intent {
+                    return Err(crate::holycodex::ControllerError::InvalidState(
+                        "controller Intent changed before specialist reallocation".into(),
+                    ));
+                }
+                // The controller state is authoritative; synchronize the
+                // identity copy while its per-Root lock protects this merge.
+                *intent = canonical_intent;
+                old_contract = contracts.get(&request.target.to_string()).cloned();
+                if let Some(previous) = &old_contract {
+                    request.contract.native_id = previous.native_id.clone();
+                }
+                validate_contract(&request.contract)?;
+                contracts.insert(request.target.to_string(), request.contract.clone());
+                Ok(())
+            },
+        )
+        .map_err(|error| invalid(&error.to_string()))?;
+
+        request.binding.caller = request.target;
+        let applied = target
+            .session
+            .apply_holycodex_reallocation(
+                &request.config,
+                request.binding.clone(),
+                request.contract.clone(),
+            )
+            .await;
+        match applied {
+            Ok(snapshot)
+                if snapshot.model == ModelId::Gpt6Luna.as_str()
+                    && snapshot.reasoning_effort
+                        == Some(to_protocol_effort(request.contract.effort))
+                    && target
+                        .thread_extension_data()
+                        .get::<HolyCodexToolBinding>()
+                        .is_some_and(|binding| {
+                            binding.permission_profile == snapshot.permission_profile
+                        }) =>
+            {
+                Ok(snapshot)
+            }
+            Ok(_) => {
+                restore_identity(&request, old_contract);
+                Err(invalid(
+                    "live session did not publish the requested specialist contract",
+                ))
+            }
+            Err(error) => {
+                restore_identity(&request, old_contract);
+                Err(invalid(&error.to_string()))
+            }
+        }
+    }
+}
+
+fn restore_identity(
+    request: &ReallocateSpecialistRequest,
+    old_contract: Option<NativeThreadContract>,
+) {
+    let _ = update_identity(
+        &request.codex_home,
+        request.caller_root,
+        |_intent, contracts| {
+            if let Some(contract) = old_contract {
+                contracts.insert(request.target.to_string(), contract);
+            } else {
+                contracts.remove(&request.target.to_string());
+            }
+            Ok(())
+        },
+    );
+}
+
+fn to_protocol_effort(
+    effort: holycodex_policy::ReasoningEffort,
+) -> codex_protocol::openai_models::ReasoningEffort {
+    match effort {
+        holycodex_policy::ReasoningEffort::Low => {
+            codex_protocol::openai_models::ReasoningEffort::Low
+        }
+        holycodex_policy::ReasoningEffort::Medium => {
+            codex_protocol::openai_models::ReasoningEffort::Medium
+        }
+        holycodex_policy::ReasoningEffort::High => {
+            codex_protocol::openai_models::ReasoningEffort::High
+        }
+    }
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.to_owned())
+}
+
+fn live_root_authority_covers(
+    root: &RootAuthorityGrants,
+    capabilities: &BTreeSet<holycodex_policy::Capability>,
+    mutability: holycodex_policy::Mutability,
+    ownership_paths: &BTreeSet<String>,
+    allowed_tools: &BTreeSet<codex_tools::ToolName>,
+    writable_roots: &[codex_utils_path_uri::PathUri],
+    root_permission_lease: &RootPermissionLease,
+) -> bool {
+    root_permission_lease == &root.permission_lease
+        && capabilities.is_subset(&root.capabilities)
+        && mutability_rank(mutability) <= mutability_rank(root.max_mutability)
+        && ownership_paths.iter().all(|path| {
+            root.ownership_paths
+                .iter()
+                .any(|root| crate::holycodex_identity::ownership_path_is_within(path, root))
+        })
+        && allowed_tools.is_subset(&root.allowed_tools)
+        && writable_roots.iter().all(|path| {
+            root.writable_roots
+                .iter()
+                .any(|root| path.starts_with(root))
+        })
+}
+
+fn mutability_rank(value: holycodex_policy::Mutability) -> u8 {
+    match value {
+        holycodex_policy::Mutability::ReadOnly => 0,
+        holycodex_policy::Mutability::ScopedWrite => 1,
+        holycodex_policy::Mutability::Operational => 2,
+    }
