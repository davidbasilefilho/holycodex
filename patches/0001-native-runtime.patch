+/// Host-derived callable names in the finalized per-thread model tool registry.
+#[derive(Clone)]
+pub struct ActualHostToolGrantSnapshot {
+    pub(crate) caller: ThreadId,
+    pub(crate) tools: BTreeSet<ToolName>,
+    pub(crate) live: Arc<Mutex<Option<BTreeSet<ToolName>>>>,
+}
+
+/// Attach trusted runtime context to the extension thread store. Session setup
+/// must call this only after resolving the root/specialist identity and its
+/// effective tool profile; model arguments never supply these values.
+/// Compact normalized absolute roots using PathUri's containment semantics.
+/// Inputs must already be host-normalized PathUris from the trusted adapter.
+pub fn normalize_writable_roots(paths: impl IntoIterator<Item = PathUri>) -> Vec<PathUri> {
+    let mut roots: Vec<PathUri> = Vec::new();
+    for root in paths {
+        if roots.iter().any(|existing| root.starts_with(existing)) {
+            continue;
+        }
+        roots.retain(|existing| !existing.starts_with(&root));
+        roots.push(root);
+    }
+    roots
+}
+
+pub fn normalize_holycodex_tool_binding(binding: &mut HolyCodexToolBinding) {
+    binding.writable_roots = normalize_writable_roots(std::mem::take(&mut binding.writable_roots));
+}
