+/// The socket belongs to an app-server built from a different runtime.
+#[derive(Debug)]
+pub struct ForeignAppServerRuntime;
+
+impl fmt::Display for ForeignAppServerRuntime {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("the selected background server is not a compatible HolyCodex runtime")
+    }
+}
