+            serde_json::to_value(&refresh)?,
+            serde_json::json!({
+                "grant_type": "refresh_token",
+                "client_id": "oaiapp_test-client",
+                "refresh_token": "refresh-token",
+                "resource": RESOURCE,
+            })
+        );
+        assert!(!format!("{refresh:?}").contains("refresh-token"));
+        Ok(())
+    }
+
+    #[test]
+    fn missing_plan_usage_scope_is_not_authorized() -> Result<(), Box<dyn std::error::Error>> {
+        let identity = validate_id_token(
+            &signed_token(valid_claims())?,
+            &test_jwks()?,
+            issued_client()?,
+            "nonce-123",
+        )?;
+        let metadata = RegistrationMetadata::from_verified_identity(
+            identity,
+            AgentHostId::parse("host-id")?,
+            vec!["openid".to_string(), "resource.invoke".to_string()],
+            4_000_000_000,
+        )?;
+        assert!(matches!(
+            metadata.require_plan_usage(),
+            Err(SiwcError::PlanUsageNotGranted)
+        ));
+        Ok(())
+    }
+
+    #[test]
+    fn deserialization_rejects_unissued_ids_and_untrusted_issuer() {
+        let dynamic_client = r#"{"issuer":"https://auth.openai.com","subject":"s","client_id":"dynamic_agent_client","ext_agent_host_id":"host","scopes":["openid"],"expires_at":100}"#;
+        assert!(serde_json::from_str::<RegistrationMetadata>(dynamic_client).is_err());
+        let wrong_issuer = r#"{"issuer":"https://evil.example","subject":"s","client_id":"oaiapp_valid","ext_agent_host_id":"host","scopes":["openid"],"expires_at":100}"#;
+        assert!(serde_json::from_str::<RegistrationMetadata>(wrong_issuer).is_err());
+        assert!(IssuedClientId::parse("app_official_codex_client").is_err());
+    }
+
+    #[test]
+    fn refresh_serializes_as_a_public_client_form_without_scope_or_secret()
+    -> Result<(), Box<dyn std::error::Error>> {
+        let refresh = RefreshTokenRequest::new(issued_client()?, "token+with&reserved=bytes")?;
+        let request = reqwest::Client::builder()
+            .build()?
+            .post(TOKEN_ENDPOINT)
+            .form(&refresh)
+            .build()?;
+        assert_eq!(request.url().as_str(), TOKEN_ENDPOINT);
+        assert_eq!(
+            request
+                .headers()
+                .get("content-type")
+                .ok_or("missing content type")?,
+            "application/x-www-form-urlencoded"
+        );
+        let body = request
+            .body()
+            .and_then(reqwest::Body::as_bytes)
+            .ok_or("missing form body")?;
+        let pairs: std::collections::HashMap<_, _> = url::form_urlencoded::parse(body).collect();
+        assert_eq!(pairs.len(), 4);
+        assert_eq!(
+            pairs.get("refresh_token").map(|value| value.as_ref()),
+            Some("token+with&reserved=bytes")
+        );
+        assert_eq!(
+            pairs.get("client_id").map(|value| value.as_ref()),
+            Some("oaiapp_test-client")
+        );
+        assert_eq!(
+            pairs.get("resource").map(|value| value.as_ref()),
+            Some(RESOURCE)
+        );
+        assert_eq!(
+            pairs.get("grant_type").map(|value| value.as_ref()),
+            Some("refresh_token")
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn rejects_missing_claims_unknown_keys_and_algorithm_confusion()
+    -> Result<(), Box<dyn std::error::Error>> {
+        for field in ["iss", "sub", "aud", "exp", "iat", "nonce"] {
+            let mut claims = valid_claims();
+            claims
+                .as_object_mut()
+                .ok_or("claims are not an object")?
+                .remove(field);
+            assert!(
+                validate_id_token(
+                    &signed_token(claims)?,
+                    &test_jwks()?,
+                    issued_client()?,
+                    "nonce-123"
+                )
+                .is_err(),
+                "accepted missing {field}"
+            );
+        }
+        let token = signed_token(valid_claims())?;
+        assert!(
+            validate_id_token(
+                &token,
+                &JwkSet { keys: vec![] },
+                issued_client()?,
+                "nonce-123"
+            )
+            .is_err()
+        );
+        let mut header = Header::new(Algorithm::HS256);
+        header.kid = Some("test-key".to_string());
+        let token = jsonwebtoken::encode(
+            &header,
+            &valid_claims(),
+            &EncodingKey::from_secret(b"untrusted secret"),
+        )?;
+        assert!(validate_id_token(&token, &test_jwks()?, issued_client()?, "nonce-123").is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn returning_identity_and_actual_grants_are_checked() -> Result<(), Box<dyn std::error::Error>>
+    {
+        let verify = |claims| {
+            validate_id_token(
+                &signed_token(claims)?,
+                &test_jwks()?,
+                issued_client()?,
+                "nonce-123",
+            )
+            .map_err(Into::<Box<dyn std::error::Error>>::into)
+        };
+        let metadata = RegistrationMetadata::from_verified_identity(
+            verify(valid_claims())?,
+            AgentHostId::parse("host")?,
+            parse_granted_scopes("openid resource.invoke chatgpt.tokens.use.direct")?,
+            4_000_000_000,
+        )?;
+        metadata.validate_returning_identity(&verify(valid_claims())?)?;
+        let mut other = valid_claims();
+        other["sub"] = serde_json::json!("other-account");
+        assert!(matches!(
+            metadata.validate_returning_identity(&verify(other)?),
+            Err(SiwcError::IdentityMismatch)
+        ));
+        metadata.require_plan_usage()?;
+        let refreshed =
+            metadata.with_refreshed_grant(parse_granted_scopes("openid")?, 4_000_000_001)?;
+        assert_eq!(refreshed.issuer(), metadata.issuer());
+        assert_eq!(refreshed.subject(), metadata.subject());
+        assert_eq!(refreshed.client_id(), metadata.client_id());
+        assert_eq!(refreshed.host_id(), metadata.host_id());
+        assert_eq!(refreshed.expires_at(), 4_000_000_001);
+        assert!(!refreshed.has_scope("resource.invoke"));
+        for scope in [
+            "openid resource.invoke",
+            "openid chatgpt.tokens.use.direct",
+            "",
+            "resource.invoke chatgpt.tokens.use.direct.extra",
+        ] {
+            let reduced = RegistrationMetadata::from_verified_identity(
+                verify(valid_claims())?,
+                AgentHostId::parse("host")?,
+                parse_granted_scopes(scope)?,
+                4_000_000_000,
+            )?;
+            assert!(reduced.require_plan_usage().is_err());
+        }
+        for scope in [
+            "openid\nprofile",
+            "openid\tprofile",
+            "bad\0scope",
+            "scope\\name",
+            "scope\"name",
+        ] {
+            assert!(parse_granted_scopes(scope).is_err());
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn audience_and_key_usage_constraints_are_verified() -> Result<(), Box<dyn std::error::Error>> {
+        let mut claims = valid_claims();
+        claims["aud"] = serde_json::json!(["oaiapp_test-client"]);
+        validate_id_token(
+            &signed_token(claims.clone())?,
+            &test_jwks()?,
+            issued_client()?,
+            "nonce-123",
+        )?;
+        claims["aud"] = serde_json::json!(["oaiapp_test-client", "other-audience"]);
+        assert!(
+            validate_id_token(
+                &signed_token(claims.clone())?,
+                &test_jwks()?,
+                issued_client()?,
+                "nonce-123"
+            )
+            .is_err()
+        );
+        claims["azp"] = serde_json::json!("oaiapp_test-client");
+        validate_id_token(
+            &signed_token(claims.clone())?,
+            &test_jwks()?,
+            issued_client()?,
+            "nonce-123",
+        )?;
+        claims["azp"] = serde_json::json!("oaiapp_wrong-client");
+        assert!(
+            validate_id_token(
+                &signed_token(claims)?,
+                &test_jwks()?,
+                issued_client()?,
+                "nonce-123"
+            )
+            .is_err()
+        );
+
+        let token = signed_token(valid_claims())?;
+        let mut jwks = test_jwks()?;
+        let key = jwks.keys.first_mut().ok_or("missing fixture key")?;
+        key.common.public_key_use = Some(jsonwebtoken::jwk::PublicKeyUse::Encryption);
+        assert!(validate_id_token(&token, &jwks, issued_client()?, "nonce-123").is_err());
+        let mut jwks = test_jwks()?;
+        let key = jwks.keys.first_mut().ok_or("missing fixture key")?;
+        key.common.key_operations = Some(vec![jsonwebtoken::jwk::KeyOperations::Sign]);
+        assert!(validate_id_token(&token, &jwks, issued_client()?, "nonce-123").is_err());
+        let mut jwks = test_jwks()?;
+        let key = jwks.keys.first_mut().ok_or("missing fixture key")?;
+        key.common.key_algorithm = Some(jsonwebtoken::jwk::KeyAlgorithm::RS512);
+        assert!(validate_id_token(&token, &jwks, issued_client()?, "nonce-123").is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn rejects_untrusted_redirects_and_invalid_pkce() -> Result<(), Box<dyn std::error::Error>> {
+        let mut request = AuthorizationRequest {
+            client: AuthorizationClient::InitialRegistration,
+            host_id: AgentHostId::parse("host")?,
+            redirect_uri: Url::parse("http://127.0.0.1:1455/auth/callback")?,
+            state: "state".to_string(),
+            nonce: "nonce".to_string(),
+            code_challenge: "A".repeat(43),
+        };
+        for uri in [
+            "https://evil.example/callback",
+            "http://localhost:1455/auth/callback",
+            "http://127.0.0.1:1455/auth/callback#fragment",
+            "http://user@127.0.0.1:1455/auth/callback",
+        ] {
+            request.redirect_uri = Url::parse(uri)?;
+            assert!(request.to_url().is_err());
+        }
+        request.redirect_uri = Url::parse("http://127.0.0.1:1455/auth/callback")?;
+        request.code_challenge = "invalid".to_string();
+        assert!(request.to_url().is_err());
+        Ok(())
+    }
+}
