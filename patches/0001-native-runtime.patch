+            assert!(npm_workspace_command_uses_only_relative_paths(&format!(
+                "{command} --coverageDirectory=reports/coverage"
+            )));
+            for traversal in [
+                "--coverageDirectory=../../victim",
+                "--coverageDirectory ../../victim",
+                "--prefix=../../victim",
+                "--workspace=reports/../../victim",
+                "'--coverageDirectory=..\\\\..\\\\victim'",
+            ] {
+                assert!(
+                    !npm_workspace_command_uses_only_relative_paths(&format!(
+                        "{command} {traversal}"
+                    )),
+                    "accepted escaping npm path argument: {command} {traversal}"
+                );
+            }
+            for path in [
+                "/workspace/app",
+                "\\victim",
+                "C:/workspace/app",
+                "C:victim",
+                "//server/share/app",
+            ] {
+                for flag in [
+                    "--prefix ",
+                    "--prefix=",
+                    "-C=",
+                    "-w=",
+                    "--coverageDirectory=",
+                ] {
+                    assert!(
+                        !npm_workspace_command_uses_only_relative_paths(&format!(
+                            "{command} {flag}'{path}'"
+                        )),
+                        "accepted absolute npm path argument: {command} {flag}{path}"
+                    );
+                }
+            }
+        }
+        assert!(!shell_npm_workspace_command("npm install"));
+        assert!(!shell_npm_workspace_command("npm run publish"));
+        for command in [
+            "npm test -- --coverageDirectory=../../victim",
+            "npm run test -- --coverageDirectory=../../victim",
+            "npm test -- --coverageDirectory ../../victim",
+        ] {
+            assert!(shell_npm_workspace_command(command));
