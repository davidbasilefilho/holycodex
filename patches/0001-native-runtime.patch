index 0000000..d3de904
--- /dev/null
+++ b/codex-rs/login/src/siwc_login.rs
@@ -0,0 +1,205 @@
+//! SIWC lifecycle boundaries. No official Codex client identity is accepted here.
+#![forbid(unsafe_code)]
+
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::time::Duration;
+use std::time::Instant;
+
+use crate::siwc::AgentHostId;
+use crate::siwc::AuthorizationClient;
+use crate::siwc::IssuedClientId;
+use crate::siwc::RegistrationMetadata;
+use crate::siwc::{self};
+use crate::token_data::TokenData;
+use crate::token_data::parse_chatgpt_jwt_claims;
+use jsonwebtoken::jwk::JwkSet;
+
+pub(crate) const SIGN_IN_REQUIRED: &str = "This ChatGPT credential is not a HolyCodex SIWC registration. Sign in again using browser login; official Codex credentials cannot be reused.";
+
+pub(crate) fn host_id(home: &Path) -> io::Result<AgentHostId> {
+    std::fs::create_dir_all(home)?;
+    let path = home.join("siwc-host.json");
+    match std::fs::read(&path) {
+        Ok(bytes) => return serde_json::from_slice(&bytes).map_err(io::Error::other),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error),
+    }
+    let id = AgentHostId::parse(crate::oauth::generate_state()).map_err(io::Error::other)?;
+    let mut temporary = tempfile::NamedTempFile::new_in(home)?;
+    temporary.write_all(&serde_json::to_vec(&id)?)?;
+    temporary.as_file().sync_all()?;
+    match temporary.persist_noclobber(&path) {
+        Ok(_) => Ok(id),
+        Err(error) if error.error.kind() == io::ErrorKind::AlreadyExists => {
+            serde_json::from_slice(&std::fs::read(path)?).map_err(io::Error::other)
+        }
+        Err(error) => Err(error.error),
+    }
+}
+
+/// Cross-process serialization for rotating tokens, login commits, and logout.
+pub(crate) async fn session_lock(home: &Path) -> io::Result<std::fs::File> {
+    let home = home.to_owned();
+    tokio::task::spawn_blocking(move || {
+        std::fs::create_dir_all(&home)?;
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true).write(true).create(true).truncate(false);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(home.join("siwc-session.lock"))?;
+        file.lock()?;
+        Ok(file)
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+pub(crate) struct PendingLogin {
+    pub client: AuthorizationClient,
+    pub registration: Option<RegistrationMetadata>,
+    pub host: AgentHostId,
+    pub nonce: String,
+    deadline: Instant,
+    consumed: bool,
+}
+
+impl PendingLogin {
+    pub fn new(registration: Option<RegistrationMetadata>, host: AgentHostId) -> Self {
+        // Registrations belong to this host; copying credentials is not registration transfer.
+        let registration = registration.filter(|registration| registration.host_id() == &host);
+        let client = registration
+            .as_ref()
+            .map_or(AuthorizationClient::InitialRegistration, |registration| {
+                AuthorizationClient::Returning(registration.client_id().clone())
+            });
+        Self {
+            client,
+            registration,
+            host,
+            nonce: crate::oauth::generate_state(),
+            deadline: Instant::now() + Duration::from_secs(600),
+            consumed: false,
+        }
+    }
+
+    pub fn consume(&mut self, expected_state: &str, url: &url::Url) -> io::Result<IssuedClientId> {
+        if self.consumed || Instant::now() >= self.deadline {
+            return Err(io::Error::other(
+                "Login attempt expired or already consumed. Start browser login again.",
+            ));
+        }
+        let value = |name: &str| -> io::Result<Option<String>> {
+            let mut matches = url.query_pairs().filter(|(key, _)| key == name);
+            let first = matches.next().map(|(_, value)| value.into_owned());
+            if matches.next().is_some() {
+                return Err(io::Error::other("Duplicate OAuth callback parameter"));
+            }
+            Ok(first)
+        };
+        let state = value("state")?;
+        let client = value("client_id")?;
+        for name in ["code", "error", "error_description"] {
+            value(name)?;
+        }
+        let client = siwc::validate_callback_client_id(
+            &self.client,
+            expected_state,
+            state.as_deref().unwrap_or_default(),
+            client.as_deref(),
+        )
+        .map_err(io::Error::other)?;
+        self.consumed = true;
+        Ok(client)
+    }
+
+    pub fn validate_tokens(
+        &self,
+        response: &crate::server::ExchangedTokens,
+        jwks: &JwkSet,
+        client: IssuedClientId,
+    ) -> io::Result<TokenData> {
+        validate_token_string(&response.access_token)?;
+        validate_token_string(&response.refresh_token)?;
+        let identity = siwc::validate_id_token(&response.id_token, jwks, client, &self.nonce)
+            .map_err(io::Error::other)?;
+        if let Some(registration) = &self.registration {
+            registration
+                .validate_returning_identity(&identity)
+                .map_err(io::Error::other)?;
+        }
+        let registration = RegistrationMetadata::from_verified_identity(
+            identity,
+            self.host.clone(),
+            siwc::parse_granted_scopes(&response.scope).map_err(io::Error::other)?,
+            expires_at(response.expires_in)?,
+        )
+        .map_err(io::Error::other)?;
+        let id_token = parse_chatgpt_jwt_claims(&response.id_token).map_err(io::Error::other)?;
+        Ok(TokenData {
+            account_id: id_token.chatgpt_account_id.clone(),
+            id_token,
+            access_token: response.access_token.clone(),
+            refresh_token: response.refresh_token.clone(),
+            siwc: Some(registration),
+        })
+    }
+}
+
+pub(crate) fn expires_at(expires_in: u64) -> io::Result<u64> {
+    if expires_in == 0 {
+        return Err(io::Error::other("Missing or invalid access-token lifetime"));
+    }
+    jsonwebtoken::get_current_timestamp()
+        .checked_add(expires_in)
+        .ok_or_else(|| io::Error::other("Invalid access-token lifetime"))
+}
+
+pub(crate) fn validate_token_string(token: &str) -> io::Result<()> {
+    if token.trim().is_empty() || token.chars().any(char::is_control) {
+        return Err(io::Error::other("Invalid token response"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn host_is_persistent_and_not_shared_between_homes() -> io::Result<()> {
+        let first = tempfile::tempdir()?;
+        let second = tempfile::tempdir()?;
+        let id = host_id(first.path())?;
+        assert_eq!(id, host_id(first.path())?);
+        assert_ne!(id, host_id(second.path())?);
+        std::fs::write(first.path().join("siwc-host.json"), b"invalid")?;
+        assert!(host_id(first.path()).is_err());
+        Ok(())
+    }
+    #[test]
+    fn callbacks_are_one_time_exact_and_unambiguous() -> io::Result<()> {
+        let home = tempfile::tempdir()?;
+        let mut pending = PendingLogin::new(None, host_id(home.path())?);
+        for query in [
+            "state=wrong&client_id=oaiapp_test",
+            "state=state&client_id=dynamic_agent_client",
+            "state=state&state=state&client_id=oaiapp_test",
+            "state=state&client_id=oaiapp_test&code=x&code=y",
+        ] {
+            let url = url::Url::parse(&format!("http://127.0.0.1:1455/auth/callback?{query}"))
+                .map_err(io::Error::other)?;
+            assert!(pending.consume("state", &url).is_err());
+        }
+        let url = url::Url::parse(
+            "http://127.0.0.1:1455/auth/callback?state=state&client_id=oaiapp_test&code=x",
+        )
+        .map_err(io::Error::other)?;
+        assert!(pending.consume("state", &url).is_ok());
+        assert!(pending.consume("state", &url).is_err());
+        Ok(())
+    }
+}
