+fn allowed_tools_for(
+    capabilities: &BTreeSet<Capability>,
+    root_tools: &BTreeSet<codex_tools::ToolName>,
+) -> Result<BTreeSet<codex_tools::ToolName>, ControllerError> {
+    let mut names = BTreeSet::new();
+    if capabilities.contains(&Capability::RepositoryRead)
+        || capabilities.contains(&Capability::Search)
+        || capabilities.contains(&Capability::Shell)
+    {
+        names.insert("exec_command");
+    }
+    if capabilities.contains(&Capability::FilesystemWrite) {
+        names.insert("apply_patch");
+    }
+    if capabilities.contains(&Capability::VisualInspection) {
+        names.insert("view_image");
+    }
+    let tools = names
+        .into_iter()
+        .map(codex_tools::ToolName::plain)
+        .filter(|name| root_tools.contains(name))
+        .collect::<BTreeSet<_>>();
+    let required = [
+        (Capability::RepositoryRead, "exec_command"),
+        (Capability::Search, "exec_command"),
+        (Capability::Shell, "exec_command"),
+        (Capability::FilesystemWrite, "apply_patch"),
+        (Capability::VisualInspection, "view_image"),
+    ];
+    if required.iter().any(|(capability, name)| {
+        capabilities.contains(capability) && !tools.iter().any(|tool| tool.name == *name)
+    }) || capabilities.iter().any(|capability| {
+        matches!(
+            capability,
+            Capability::BrowserUse | Capability::ComputerUse | Capability::Sites
+        )
+    }) {
+        return Err(ControllerError::Agent(
+            "Root's live tool profile cannot provide a required specialist capability".into(),
+        ));
+    }
+    Ok(tools)
+}
