+// Config paths may use a canonical Windows name without its device prefix,
+// while permission keys retain the original temporary directory spelling.
+fn normalize_fixture_paths(value: &str, root: &Path, canonical_root: &Path) -> String {
+    let root = root.display().to_string();
+    let canonical_root = canonical_root.display().to_string();
+    let normalized_canonical_root =
+        normalize_windows_device_path(&canonical_root).unwrap_or_else(|| canonical_root.clone());
+    let mut value = value.replace('\\', "/");
+    for root in [&canonical_root, &normalized_canonical_root, &root] {
+        value = value.replace(&root.replace('\\', "/"), "FIXTURE");
+    }
+    value
+}
+
+#[test]
+fn fixture_path_normalization_handles_windows_aliases_and_mixed_provenance() {
+    let root = Path::new(r"C:\Users\RUNNER~1\AppData\Local\Temp\.tmpABC");
+    let canonical = Path::new(r"\\?\C:\Users\runneradmin\AppData\Local\Temp\.tmpABC");
+    for path in [
+        r"C:\Users\RUNNER~1\AppData\Local\Temp\.tmpABC\home\config.toml",
+        r"\\?\C:\Users\runneradmin\AppData\Local\Temp\.tmpABC\home\config.toml",
+        r"C:\Users\runneradmin\AppData\Local\Temp\.tmpABC\home\config.toml",
+        "C:/Users/runneradmin/AppData/Local/Temp/.tmpABC/home/config.toml",
+    ] {
+        assert_eq!(
+            normalize_fixture_paths(path, root, canonical),
+            "FIXTURE/home/config.toml"
+        );
+    }
+    assert_eq!(
+        normalize_fixture_paths(
+            r"permissions.diagnostic.filesystem.C:\Users\RUNNER~1\AppData\Local\Temp\.tmpABC\workspace\probe-existing in user (C:/Users/runneradmin/AppData/Local/Temp/.tmpABC/home/config.toml)",
+            root,
+            canonical,
+        ),
+        "permissions.diagnostic.filesystem.FIXTURE/workspace/probe-existing in user (FIXTURE/home/config.toml)"
+    );
+}
+
+#[test]
+fn fixture_path_normalization_preserves_unix_and_unc_aliases() {
+    for (root, canonical, paths) in [
+        (
+            "/var/tmp/fixture",
+            "/private/var/tmp/fixture",
+            [
+                "/var/tmp/fixture/home/config.toml",
+                "/private/var/tmp/fixture/home/config.toml",
+            ],
+        ),
+        (
+            r"\\server\share\fixture",
+            r"\\?\UNC\server\share\fixture",
+            [
+                r"\\?\UNC\server\share\fixture\home\config.toml",
+                "//server/share/fixture/home/config.toml",
+            ],
+        ),
+    ] {
