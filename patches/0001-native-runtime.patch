+struct HolyCodexToolContributor;
+
+impl ToolContributor for HolyCodexToolContributor {
+    fn tools(
+        &self,
+        _session_store: &ExtensionData,
+        thread_store: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(binding) = thread_store.get::<HolyCodexToolBinding>() else {
+            return Vec::new();
+        };
+        let names = visible_tools(&binding.principal);
+        names
+            .iter()
+            .map(|name| {
+                Arc::new(HolyCodexTool {
+                    binding: binding.as_ref().clone(),
+                    name,
+                }) as Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>
+            })
+            .collect()
+    }
+}
+
+struct HolyCodexTool {
+    binding: HolyCodexToolBinding,
+    name: &'static str,
+}
+
+impl<'call> ToolExecutor<ToolCall<'call>> for HolyCodexTool {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain(self.name)
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let (description, schema) = tool_definition(self.name);
+        ToolSpec::Function(ResponsesApiTool {
+            name: self.name.to_string(),
+            description: description.into(),
+            strict: true,
+            parameters: codex_tools::parse_tool_input_schema(&schema)
+                .expect("static HolyCodex tool schema is valid"),
+            output_schema: None,
+            defer_loading: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, call: ToolCall<'call>) -> ToolExecutorFuture<'a>
+    where
+        'call: 'a,
+    {
+        Box::pin(async move {
+            let args: ToolEnvelope = serde_json::from_str(call.function_arguments()?)
+                .map_err(|error| FunctionCallError::RespondToModel(error.to_string()))?;
+            let result = self.execute(args.payload).await?;
+            Ok(Box::new(FunctionToolOutput::from_text(result, Some(true)))
+                as Box<dyn codex_tools::ToolOutput>)
+        })
+    }
+}
+
+impl HolyCodexTool {
+    async fn execute(&self, payload: String) -> Result<String, FunctionCallError> {
+        if !visible_tools(&self.binding.principal).contains(&self.name) {
+            return Err(model_error("tool is not authorized for this thread"));
+        }
+        let controller = &self.binding.controller;
+        match self.name {
+            "intent.update" => {
+                let input: IntentUpdate = decode_model_payload(&payload)?;
+                let changed = controller
+                    .update_intent(input.objective, input.accepted_scope, input.requirements)
+                    .map_err(controller_error)?;
+                encode_model_result(&IntentUpdateOutput {
+                    updated: changed,
+                    intent: controller.snapshot().map_err(controller_error)?.intent,
+                })
+            }
+            "assignment.dispatch" => {
+                let request = self.dispatch_request(decode_model_payload(&payload)?)?;
+                let assignment = controller
+                    .dispatch(request)
+                    .await
+                    .map_err(controller_error)?;
+                encode_assignment_result(&assignment)
+            }
+            "assignment.wait" => {
+                let input: AssignmentWaitRequest = decode_model_payload(&payload)?;
+                let timeout_ms = assignment_wait_timeout_ms(input.timeout_ms)?;
+                let assignment_id = input.assignment_id;
+                let (timed_out, assignment) =
+                    wait_until_or_snapshot(timeout_ms, controller.wait(&assignment_id), || {
+                        let snapshot = controller.snapshot()?;
+                        Ok(snapshot.assignment(&assignment_id)?.clone())
+                    })
+                    .await
+                    .map_err(controller_error)?;
+                encode_model_result(&AssignmentWaitOutput {
+                    timed_out,
+                    assignment: assignment_projection(&assignment),
+                })
+            }
+            "assignment.followup" => {
+                let input: FollowupRequest = decode_model_payload(&payload)?;
+                let request = self.dispatch_request(input.assignment)?;
+                let assignment = controller
+                    .followup(&input.prior_assignment_id, request)
+                    .await
+                    .map_err(controller_error)?;
+                encode_assignment_result(&assignment)
+            }
+            "assignment.cancel" => {
+                let input: AssignmentId = decode_model_payload(&payload)?;
+                let assignment = controller
+                    .cancel(&input.assignment_id)
+                    .await
+                    .map_err(controller_error)?;
+                encode_assignment_result(&assignment)
+            }
+            "assignment.finish" => {
+                let input: FinishRequest = decode_model_payload(&payload)?;
+                if !may_finish(&self.binding.principal, &input.assignment_id) {
+                    return Err(model_error(
+                        "specialist may finish only its assigned Assignment",
+                    ));
+                }
+                let assignment = controller
+                    .finish(
+                        self.binding.caller,
+                        &input.assignment_id,
+                        input.result,
+                        input.success,
+                    )
+                    .map_err(controller_error)?;
+                encode_assignment_result(&assignment)
+            }
+            _ => return Err(model_error("unknown HolyCodex tool")),
+        }
+    }
+
+    fn dispatch_request(
+        &self,
+        input: AssignmentInput,
+    ) -> Result<DispatchRequest, FunctionCallError> {
+        let role = role_task(&input.role)?;
+        let mutability = parse_mutability(&input.mutability)?;
+        if role == RoleTask::Root {
+            return Err(model_error(
+                "assignment.dispatch requires a specialist Role.task",
+            ));
+        }
+        let route =
+            route_policy(role).ok_or_else(|| model_error("unknown specialist Role.task"))?;
+        let actual_tools = self
+            .binding
+            .actual_tool_grants
+            .lock()
+            .expect("grant lock poisoned")
+            .clone()
+            .ok_or_else(|| model_error("Root has no finalized live host tool registry"))?;
+        let root_authority = self
+            .binding
+            .root_authority
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let required_tools = route
+            .capabilities
+            .iter()
+            .filter_map(|capability| match capability {
+                Capability::RepositoryRead | Capability::Search | Capability::Shell => {
+                    Some(ToolName::plain("exec_command"))
+                }
+                Capability::FilesystemWrite => Some(ToolName::plain("apply_patch")),
+                Capability::VisualInspection => Some(ToolName::plain("view_image")),
+                Capability::BrowserUse | Capability::ComputerUse | Capability::Sites => None,
+            });
+        if required_tools
+            .into_iter()
+            .any(|tool| !actual_tools.contains(&tool.with_default_namespace()))
+        {
+            return Err(model_error(
+                "specialist capability is absent from Root's finalized host tool registry",
+            ));
+        }
+        if !route
+            .capabilities
+            .iter()
+            .all(|capability| root_authority.capabilities.contains(capability))
+        {
+            return Err(model_error(
+                "specialist capability requirements exceed Root's live tool profile",
+            ));
+        }
+        let metadata = AssignmentMetadata {
+            ownership_paths: input.ownership_paths.into_iter().collect(),
+            symbols: input.symbols.into_iter().collect(),
+            domains: input.domains.into_iter().collect(),
+            dependencies: input.dependencies.into_iter().collect(),
+            related_assignments: BTreeSet::new(),
+            independent_review_of: input.independent_review_of.into_iter().collect(),
+        };
+        if mutability != Mutability::ReadOnly {
+            if mutability_rank(mutability) > mutability_rank(root_authority.max_mutability) {
+                return Err(model_error(
+                    "requested mutability exceeds the bound tool profile",
+                ));
+            }
+            if mutability == Mutability::ScopedWrite
+                && !root_authority
+                    .capabilities
+                    .contains(&Capability::FilesystemWrite)
+            {
+                return Err(model_error(
+                    "scoped writes exceed Root's live filesystem-write grant",
+                ));
+            }
+            if mutability == Mutability::ScopedWrite
+                && (metadata.ownership_paths.is_empty()
+                    || !metadata.ownership_paths.iter().all(|path| {
+                        let owned = root_authority.ownership_paths.iter().any(|root| {
+                            crate::holycodex_identity::ownership_path_is_within(path, root)
+                        });
+                        let assigned = PathUri::from_abs_path(
+                            &self.binding.root_permission_lease.cwd.join(path),
+                        );
+                        owned
+                            && root_authority
+                                .writable_roots
+                                .iter()
+                                .any(|root| assigned.starts_with(root))
+                    }))
+            {
+                return Err(model_error(
+                    "writable ownership paths exceed the bound tool profile",
+                ));
+            }
+        }
+        Ok(DispatchRequest {
+            role,
+            objective: input.objective,
+            bounded_scope: input.bounded_scope,
+            constraints: input.constraints,
+            acceptance_criteria: input.acceptance_criteria,
+            required_evidence: input.required_evidence,
+            mutability,
+            metadata,
+        })
+    }
+}
+
+fn tool_definition(name: &str) -> (String, Value) {
+    let description = match name {
+        "intent.update" => "Update accepted Intent facts; payload is TOON with objective, accepted_scope, and requirements.".to_owned(),
+        "assignment.dispatch" => "Create a bounded Assignment; TOON fields: role, objective, bounded_scope, constraints, acceptance_criteria, required_evidence, mutability, ownership_paths, symbols, domains, dependencies, independent_review_of.".to_owned(),
+        "assignment.followup" => "Create a new bounded Assignment; payload is TOON with prior_assignment_id and assignment fields.".to_owned(),
+        "assignment.wait" => "Wait for one Assignment to finish or until timeout_ms; payload is TOON with assignment_id and optional timeout_ms (default and maximum 900000 milliseconds; minimum 1). On timeout, returns timed_out=true with the latest observed Assignment state so Root can continue or cancel.".to_owned(),
+        "assignment.cancel" => "Cancel one Assignment; payload is TOON with assignment_id.".to_owned(),
+        "assignment.finish" => "Record this specialist's result; payload is TOON with assignment_id, result, and success.".to_owned(),
+        _ => String::new(),
+    };
+    let description = if matches!(name, "assignment.dispatch" | "assignment.followup") {
+        let roles = RoleTask::SPECIALISTS
+            .iter()
+            .map(|role| role.as_str())
+            .collect::<Vec<_>>()
+            .join(", ");
+        let mutability = MUTABILITY_TOOL_VALUES
+            .iter()
+            .map(|(_, value)| *value)
+            .collect::<Vec<_>>()
+            .join(", ");
+        format!(
+            "{description} Canonical specialist role IDs: {roles}. Mutability values: {mutability}."
+        )
+    } else {
+        description
+    };
+    (
+        description,
+        json!({
+            "type":"object",
+            "properties":{"payload":{"type":"string","description":"TOON 4.1 semantic payload."}},
+            "required":["payload"],
+            "additionalProperties":false
+        }),
+    )
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ToolEnvelope {
+    payload: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct IntentUpdate {
+    objective: String,
+    accepted_scope: Vec<String>,
+    requirements: Vec<String>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AssignmentInput {
+    role: String,
+    objective: String,
+    bounded_scope: Vec<String>,
+    constraints: Vec<String>,
+    acceptance_criteria: Vec<String>,
+    required_evidence: Vec<String>,
+    mutability: String,
+    ownership_paths: Vec<String>,
+    symbols: Vec<String>,
+    domains: Vec<String>,
+    dependencies: Vec<String>,
+    independent_review_of: Vec<String>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FollowupRequest {
+    prior_assignment_id: String,
+    assignment: AssignmentInput,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AssignmentId {
+    assignment_id: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AssignmentWaitRequest {
+    assignment_id: String,
+    #[serde(default)]
+    timeout_ms: Option<u64>,
+}
+#[derive(Serialize)]
+struct AssignmentWaitOutput {
+    timed_out: bool,
+    assignment: AssignmentProjection,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FinishRequest {
+    assignment_id: String,
+    result: String,
+    success: bool,
+}
+
+#[derive(Deserialize, Serialize)]
+struct IntentUpdateOutput {
+    updated: bool,
+    intent: holycodex_policy::Intent,
+}
+
+fn decode_model_payload<T: serde::de::DeserializeOwned + 'static>(
+    payload: &str,
+) -> Result<T, FunctionCallError> {
+    decode_toon(payload).map_err(|error| model_error(format!("invalid TOON payload: {error}")))
+}
+
+fn encode_model_result<T: Serialize>(value: &T) -> Result<String, FunctionCallError> {
+    encode_toon(value).map_err(|error| FunctionCallError::Fatal(error.to_string()))
+}
+
+fn encode_assignment_result(
+    assignment: &holycodex_policy::Assignment,
+) -> Result<String, FunctionCallError> {
+    let projection: AssignmentProjection = assignment_projection(assignment);
+    encode_model_result(&projection)
+}
+
+fn assignment_wait_timeout_ms(timeout_ms: Option<u64>) -> Result<u64, FunctionCallError> {
+    let timeout_ms = timeout_ms.unwrap_or(ASSIGNMENT_WAIT_DEFAULT_TIMEOUT_MS);
+    if !(1..=ASSIGNMENT_WAIT_MAX_TIMEOUT_MS).contains(&timeout_ms) {
+        return Err(model_error(format!(
+            "assignment.wait timeout_ms must be between 1 and {ASSIGNMENT_WAIT_MAX_TIMEOUT_MS}"
+        )));
+    }
+    Ok(timeout_ms)
+}
+
+async fn wait_until_or_snapshot<T, E, Fut, Snapshot>(
+    timeout_ms: u64,
+    future: Fut,
+    snapshot: Snapshot,
+) -> Result<(bool, T), E>
+where
+    Fut: std::future::Future<Output = Result<T, E>>,
+    Snapshot: FnOnce() -> Result<T, E>,
+{
+    match tokio::time::timeout(Duration::from_millis(timeout_ms), future).await {
+        Ok(result) => result.map(|value| (false, value)),
+        Err(_) => snapshot().map(|value| (true, value)),
+    }
+}
+
+fn parse_mutability(value: &str) -> Result<Mutability, FunctionCallError> {
+    MUTABILITY_TOOL_VALUES
+        .iter()
+        .find_map(|(mutability, canonical)| (*canonical == value).then_some(*mutability))
+        .ok_or_else(|| model_error("unknown Assignment mutability"))
+}
+fn role_task(role: &str) -> Result<RoleTask, FunctionCallError> {
+    RoleTask::parse(role)
+        .filter(|role| *role != RoleTask::Root)
+        .ok_or_else(|| model_error("unknown specialist Role.task"))
+}
+fn mutability_rank(value: Mutability) -> u8 {
+    match value {
+        Mutability::ReadOnly => 0,
+        Mutability::ScopedWrite => 1,
+        Mutability::Operational => 2,
+    }
+}
+fn visible_tools(principal: &HolyCodexPrincipal) -> &'static [&'static str] {
+    if principal.is_root() {
+        ROOT_TOOLS
+    } else {
+        SPECIALIST_TOOLS
+    }
+}
+fn may_finish(principal: &HolyCodexPrincipal, requested_assignment: &str) -> bool {
+    matches!(principal, HolyCodexPrincipal::Specialist { assignment_id } if assignment_id == requested_assignment)
+}
+fn model_error(message: impl Into<String>) -> FunctionCallError {
+    FunctionCallError::RespondToModel(message.into())
+}
+fn controller_error(error: impl std::fmt::Display) -> FunctionCallError {
+    model_error(error.to_string())
+}
