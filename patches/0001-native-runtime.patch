@@ -0,0 +1,142 @@
+use super::retain_available_holy_workflows;
+use crate::HolyCodexOptionalWorkflows;
+use crate::catalog::SkillAuthority;
+use crate::catalog::SkillCatalog;
+use crate::catalog::SkillCatalogEntry;
+use crate::catalog::SkillPackageId;
+use crate::catalog::SkillResourceId;
+use crate::catalog::SkillSourceKind;
+use codex_protocol::protocol::SkillScope;
+
+fn entry(name: &str, path: &str, scope: SkillScope) -> SkillCatalogEntry {
+    SkillCatalogEntry::new(
+        SkillPackageId(path.to_string()),
+        SkillAuthority::new(SkillSourceKind::Host, "host"),
+        name,
+        "test skill",
+        SkillResourceId::new(path),
+    )
+    .with_prompt_scope(scope)
+}
+
+fn catalog() -> SkillCatalog {
+    SkillCatalog {
+        entries: vec![
+            entry(
+                "auto-reset",
+                "/codex/skills/.system/auto-reset/SKILL.md",
+                SkillScope::System,
+            ),
+            entry(
+                "session-audit",
+                "/codex/skills/.system/session-audit/SKILL.md",
+                SkillScope::System,
+            ),
+            entry(
+                "auto-reset",
+                "/plugins/host/skills/auto-reset/SKILL.md",
+                SkillScope::System,
+            ),
+            entry(
+                "session-audit",
+                "/home/user/skills/session-audit/SKILL.md",
+                SkillScope::User,
+            ),
+            entry(
+                "codebase-onboarding",
+                "/codex/skills/.system/codebase-onboarding/SKILL.md",
+                SkillScope::System,
+            ),
+        ],
+        warnings: vec!["host warning".to_string()],
+    }
+}
+
+#[test]
+fn optional_workflows_require_enabled_config_and_root_identity() {
+    let mut root_catalog = catalog();
+    retain_available_holy_workflows(
+        &mut root_catalog,
+        HolyCodexOptionalWorkflows {
+            session_audit: true,
+            auto_reset: true,
+        },
+        true,
+    );
+    assert_eq!(root_catalog.entries.len(), 5);
+
+    let mut defaults_catalog = catalog();
+    retain_available_holy_workflows(
+        &mut defaults_catalog,
+        HolyCodexOptionalWorkflows::default(),
+        true,
+    );
+    assert_eq!(defaults_catalog.entries.len(), 3);
+    assert_eq!(defaults_catalog.warnings, ["host warning"]);
+
+    let mut specialist_catalog = catalog();
+    retain_available_holy_workflows(
+        &mut specialist_catalog,
+        HolyCodexOptionalWorkflows {
+            session_audit: true,
+            auto_reset: true,
+        },
+        false,
+    );
+    assert_eq!(specialist_catalog.entries.len(), 3);
+}
+
+#[test]
+fn absent_host_workflows_stay_absent_and_options_are_independent() {
+    let mut absent_catalog = SkillCatalog {
+        entries: Vec::new(),
+        warnings: Vec::new(),
+    };
+    retain_available_holy_workflows(
+        &mut absent_catalog,
+        HolyCodexOptionalWorkflows {
+            session_audit: true,
+            auto_reset: true,
+        },
