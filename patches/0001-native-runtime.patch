+fn initialize_response(id: &Value, codex_home: &Path, holy_runtime: bool) -> Value {
+    let user_agent = if holy_runtime {
+        format!(
+            "codex_cli_rs/{} {} codex_upstream/{}",
+            env!("CARGO_PKG_VERSION"),
+            codex_app_server_protocol::HOLYCODEX_RUNTIME_MARKER,
+            env!("CARGO_PKG_VERSION"),
+        )
+    } else {
+        "codex_cli_rs/0.0.0-test".to_string()
+    };
+    json!({
+        "id": id,
+        "result": {
+            "userAgent": user_agent,
+            "codexHome": codex_home,
+            "platformFamily": std::env::consts::FAMILY,
+            "platformOs": std::env::consts::OS,
+        },
+    })
+}
+
+#[cfg(unix)]
+async fn respond_to_identity_probe<S>(stream: S, codex_home: &Path) -> Result<()>
+where
+    S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    let mut websocket = accept_async(stream).await?;
+    let initialize = websocket
+        .next()
+        .await
+        .context("missing identity initialize")??;
+    let initialize: Value = serde_json::from_str(initialize.to_text()?)?;
+    assert_eq!(initialize["method"], "initialize");
+    // The passive probe leaves experimental API disabled (omitted means false).
+    assert_ne!(
+        initialize["params"]["capabilities"]["experimentalApi"],
+        true
+    );
+    websocket
+        .send(Message::Text(
+            initialize_response(&initialize["id"], codex_home, true)
+                .to_string()
+                .into(),
+        ))
+        .await?;
+    let initialized = websocket
+        .next()
+        .await
+        .context("missing identity initialized")??;
+    let initialized: Value = serde_json::from_str(initialized.to_text()?)?;
+    assert_eq!(initialized["method"], "initialized");
+    Ok(())
+}
