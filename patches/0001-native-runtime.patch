+const IDENTITY_SCHEMA: u32 = 1;
+const SPECIALIST_INSTRUCTIONS: &str = holycodex_policy::SPECIALIST_INSTRUCTIONS;
+const ROOT_INSTRUCTIONS: &str = holycodex_policy::ROOT_INSTRUCTIONS;
+
+/// Durable runtime contract for one native Root or specialist thread.
+///
+/// Its grant record is checked against the live extension binding on resume;
+/// it is never accepted as evidence that the grant is still effective.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct NativeThreadContract {
+    pub schema: u32,
+    pub native_id: String,
+    pub root_thread_id: String,
+    pub thread_id: String,
+    pub role: RoleTask,
+    pub assignment: Option<Assignment>,
+    pub model: ModelId,
+    pub effort: ReasoningEffort,
+    pub profile: Profile,
+    pub instruction_sha1: String,
+    pub grants: BTreeSet<Capability>,
+    pub authority: NativeAuthorityContract,
+    pub effects: BTreeSet<NativeEffect>,
+}
+
+/// Typed upper bound persisted for later validation against live runtime state.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct NativeAuthorityContract {
+    pub max_mutability: Mutability,
+    pub ownership_paths: BTreeSet<String>,
+    pub allowed_tools: BTreeSet<String>,
+    pub delegation_disabled: bool,
+    pub max_agent_depth: u8,
+}
+
+/// Observable effects available to the bound session.
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum NativeEffect {
+    RepositoryRead,
+    RepositoryWrite,
+    Shell,
+    VisualInspection,
+    AssignmentFinish,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct IntentFile {
+    schema: u32,
+    root_thread_id: String,
+    intent: Intent,
+    #[serde(default)]
+    threads: BTreeMap<String, NativeThreadContract>,
+}
+
+/// Returns the stable native identity path for a Root thread.
+pub(crate) fn identity_path(codex_home: &Path, root_thread_id: ThreadId) -> PathBuf {
+    codex_home
+        .join("holycodex")
+        .join("threads")
+        .join(root_thread_id.to_string())
+        .join("intent.toml")
+}
+
+pub(crate) fn read_identity(
+    codex_home: &Path,
+    root_thread_id: ThreadId,
+) -> Result<Option<(Intent, BTreeMap<String, NativeThreadContract>)>, ControllerError> {
+    let path = identity_path(codex_home, root_thread_id);
+    let _lock = identity_lock(&path)?;
+    read_identity_locked(&path, root_thread_id)
+}
+
+fn read_identity_locked(
+    path: &Path,
+    root_thread_id: ThreadId,
+) -> Result<Option<(Intent, BTreeMap<String, NativeThreadContract>)>, ControllerError> {
+    let text = match fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let file: IntentFile =
+        toml::from_str(&text).map_err(|error| ControllerError::StateEncoding(error.to_string()))?;
+    if file.schema != IDENTITY_SCHEMA || file.root_thread_id != root_thread_id.to_string() {
+        return Err(ControllerError::InvalidState(
+            "native Intent identity does not match its path or schema".into(),
+        ));
+    }
+    for (thread_id, contract) in &file.threads {
+        validate_contract(contract)?;
+        if thread_id != &contract.thread_id || contract.root_thread_id != file.root_thread_id {
+            return Err(ControllerError::InvalidState(
+                "native thread contract identity does not match its record".into(),
+            ));
+        }
+    }
+    Ok(Some((file.intent, file.threads)))
+}
+
+/// Atomically merge one Root identity update with the latest persisted record.
+/// The synchronous closure runs under the stable per-Root OS lock.
+pub(crate) fn update_identity(
+    codex_home: &Path,
+    root_thread_id: ThreadId,
+    update: impl FnOnce(
+        &mut Intent,
+        &mut BTreeMap<String, NativeThreadContract>,
+    ) -> Result<(), ControllerError>,
+) -> Result<(), ControllerError> {
+    update_identity_inner(
+        identity_path(codex_home, root_thread_id),
+        root_thread_id,
+        None,
+        update,
+    )
+    .map(|_| ())
+}
+
+/// Merge into an existing Root identity beside its controller state file.
+pub(crate) fn update_existing_identity_in_directory(
+    thread_directory: &Path,
+    root_thread_id: ThreadId,
+    update: impl FnOnce(
+        &mut Intent,
+        &mut BTreeMap<String, NativeThreadContract>,
+    ) -> Result<(), ControllerError>,
+) -> Result<bool, ControllerError> {
+    update_identity_inner(
+        thread_directory.join("intent.toml"),
+        root_thread_id,
+        None,
+        update,
+    )
+}
+
+fn update_identity_or_initialize(
+    codex_home: &Path,
+    root_thread_id: ThreadId,
+    initial_intent: Intent,
+    update: impl FnOnce(
+        &mut Intent,
+        &mut BTreeMap<String, NativeThreadContract>,
+    ) -> Result<(), ControllerError>,
+) -> Result<(), ControllerError> {
+    update_identity_inner(
+        identity_path(codex_home, root_thread_id),
+        root_thread_id,
+        Some(initial_intent),
+        update,
+    )
+    .map(|_| ())
+}
+
+fn update_identity_inner(
+    path: PathBuf,
+    root_thread_id: ThreadId,
+    initial_intent: Option<Intent>,
+    update: impl FnOnce(
+        &mut Intent,
+        &mut BTreeMap<String, NativeThreadContract>,
+    ) -> Result<(), ControllerError>,
+) -> Result<bool, ControllerError> {
+    let _lock = identity_lock(&path)?;
+    let (mut intent, mut threads) = match read_identity_locked(&path, root_thread_id)? {
+        Some(identity) => identity,
+        None => match initial_intent {
+            Some(intent) => (intent, BTreeMap::new()),
+            None => return Ok(false),
+        },
+    };
+    update(&mut intent, &mut threads)?;
+    write_identity_locked(&path, root_thread_id, intent, threads)?;
+    Ok(true)
+}
+
+fn write_identity_locked(
+    path: &Path,
+    root_thread_id: ThreadId,
+    intent: Intent,
+    threads: BTreeMap<String, NativeThreadContract>,
+) -> Result<(), ControllerError> {
+    for (thread_id, contract) in &threads {
+        validate_contract(contract)?;
+        if thread_id != &contract.thread_id || contract.root_thread_id != root_thread_id.to_string()
+        {
+            return Err(ControllerError::InvalidState(
+                "native thread contract identity does not match its record".into(),
+            ));
+        }
+    }
+    if path.parent().is_none() {
+        return Err(ControllerError::InvalidState(
+            "invalid native identity path".into(),
+        ));
+    }
+    let file = IntentFile {
+        schema: IDENTITY_SCHEMA,
+        root_thread_id: root_thread_id.to_string(),
+        intent,
+        threads,
+    };
+    let encoded = toml::to_string(&file)
+        .map_err(|error| ControllerError::StateEncoding(error.to_string()))?;
+    crate::path_utils::write_atomically(&path, &encoded)?;
+    Ok(())
+}
+
+/// A stable sidecar lock serializes identity read/merge/replace across processes.
+fn identity_lock(path: &Path) -> Result<File, ControllerError> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let lock_path = path.with_extension("lock");
+    let file = OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .read(true)
+        .write(true)
+        .open(lock_path)?;
+    file.lock()?;
+    Ok(file)
+}
+
+pub(crate) fn validate_contract(contract: &NativeThreadContract) -> Result<(), ControllerError> {
+    let route = route_policy(contract.role)
+        .ok_or_else(|| ControllerError::InvalidState("unknown native Role.task".into()))?;
+    let required_model = if contract.role == RoleTask::Root {
+        ModelId::Gpt61Sol
+    } else {
+        ModelId::Gpt6Luna
+    };
+    if contract.schema != IDENTITY_SCHEMA
+        || contract.native_id.is_empty()
+        || contract.root_thread_id.is_empty()
+        || contract.thread_id.is_empty()
+        || contract.model != required_model
+        || (contract.role != RoleTask::Root
+            && (contract
+                .grants
+                .iter()
+                .any(|grant| !route.capabilities.contains(grant))
+                || !route
+                    .capabilities
+                    .iter()
+                    .all(|grant| contract.grants.contains(grant))))
+        || contract.authority.max_agent_depth != 1
+        || !contract.authority.delegation_disabled
+        || contract.instruction_sha1
+            != contract.assignment.as_ref().map_or_else(
+                || instruction_sha1(contract.role),
+                assignment_instruction_sha1,
+            )
+        || contract.effort != route.effort(contract.profile)
+        || contract.assignment.as_ref().is_some_and(|assignment| {
+            assignment.role != contract.role
+                || assignment.specialist_id.as_deref() != Some(contract.thread_id.as_str())
+        })
+    {
+        return Err(ControllerError::InvalidState(
+            "native thread contract violates the canonical role or authority policy".into(),
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn instruction_sha1(role: RoleTask) -> String {
+    use sha1::Digest;
+    let route = route_policy(role).expect("validated role has a route");
+    let base = if role == RoleTask::Root {
+        ROOT_INSTRUCTIONS
+    } else {
+        SPECIALIST_INSTRUCTIONS
+    };
+    format!(
+        "{:x}",
+        sha1::Sha1::digest(format!("{base}\n{}", route.assignment_fragment))
+    )
+}
+
+/// Fingerprint the stable role base plus the Assignment-local payload emitted
+/// by `AssignmentController::render_assignment`; runtime identity is validated
+/// separately because the controller replaces its reserved ID with the live ID.
+fn assignment_instruction_sha1(assignment: &Assignment) -> String {
+    use sha1::Digest;
+    let route = route_policy(assignment.role).expect("validated role has a route");
+    let mut task = assignment.clone();
+    task.specialist_id = None;
+    format!(
+        "{:x}",
+        sha1::Sha1::digest(format!(
+            "{}\n{}\n\n{}",
+            SPECIALIST_INSTRUCTIONS,
+            route.assignment_fragment,
+            serde_json::to_string(&task).expect("Assignment serializes")
+        ))
+    )
+}
+
+fn same_assignment_contract(current: &Assignment, contract: &Assignment) -> bool {
+    current.id == contract.id
+        && current.intent_id == contract.intent_id
+        && current.role == contract.role
+        && current.objective == contract.objective
+        && current.bounded_scope == contract.bounded_scope
+        && current.constraints == contract.constraints
+        && current.acceptance_criteria == contract.acceptance_criteria
+        && current.required_evidence == contract.required_evidence
+        && current.mutability == contract.mutability
+        && current.metadata == contract.metadata
+        && current.specialist_id == contract.specialist_id
+}
