+        let state = controller.snapshot().unwrap();
+        assert!(!state.launching.contains(&assignment.id));
+        assert!(state.ambiguous_reused_launches.contains(&assignment.id));
+        assert!(terminal_result(&state, &assignment.id, stale_terminal.clone()).is_none());
+        assert!(!state.specialists[&reserved].idle);
+
+        // Observing Running after the acknowledgement is another valid signal
+        // that this is a current turn.
+        let mut after_running = state.clone();
+        after_running
+            .observe_reused_turn_running(&assignment.id)
+            .unwrap();
+        assert!(terminal_result(&after_running, &assignment.id, stale_terminal.clone()).is_some());
+
+        // Exercise the production finish path as the other correlated signal.
+        // The assignment remains Failed because the send acknowledgement was
+        // lost, but its report makes the terminal status safe to consume.
+        controller
+            .finish(
+                parse_thread_id(&reserved).unwrap(),
+                &assignment.id,
+                "current assignment finished".into(),
+                true,
+            )
+            .unwrap();
+        let state = controller.snapshot().unwrap();
+        assert!(terminal_result(&state, &assignment.id, stale_terminal.clone()).is_some());
+        let (status, result) = terminal_result(&state, &assignment.id, stale_terminal).unwrap();
+        assert_eq!(status, AssignmentStatus::Failed);
+        assert!(result.contains("ack lost"));
+        controller
+            .store
+            .transaction(|state| state.observe_terminal(&assignment.id, status, result, false))
+            .unwrap();
+        let state = controller.snapshot().unwrap();
+        assert!(state.specialists[&reserved].idle);
+        assert!(!state.ambiguous_reused_launches.contains(&assignment.id));
+    }
