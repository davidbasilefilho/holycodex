+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn first_root_input_persists_one_intent_across_followups() -> Result<()> {
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-hc-root-1"),
+                ev_assistant_message("msg-hc-root-1", "first response"),
+                ev_completed("resp-hc-root-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-hc-root-2"),
+                ev_assistant_message("msg-hc-root-2", "follow-up response"),
+                ev_completed("resp-hc-root-2"),
+            ]),
+        ],
+    )
+    .await;
+    let mut builder = test_codex().with_model("gpt-6.1-sol");
+    let test = builder.build_with_auto_env(&server).await?;
+    let root_id = test.session_configured.thread_id;
+    let identity_path = test
+        .codex_home_path()
+        .join("holycodex")
+        .join("threads")
+        .join(root_id.to_string())
+        .join("intent.toml");
+
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "first top-level task".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let initial_identity = std::fs::read_to_string(&identity_path)?;
+    assert!(initial_identity.contains("objective = \"first top-level task\""));
+    assert!(
+        responses
+            .requests()
+            .iter()
+            .any(|request| request_has_prompt_and_model(request, "first top-level task"))
+    );
+
+    let mut resume_builder = test_codex().with_model("gpt-6.1-sol");
+    let resumed = resume_builder.restart(&server, &test).await?;
+    let resumed_identity = std::fs::read_to_string(&identity_path)?;
+    assert_eq!(resumed_identity, initial_identity);
+    assert_eq!(resumed.session_configured.model, "gpt-6.1-sol");
+    resumed
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "follow-up message".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&resumed.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let resumed_identity = std::fs::read_to_string(&identity_path)?;
+    assert_eq!(resumed_identity, initial_identity);
+    assert!(
+        responses
+            .requests()
+            .iter()
+            .any(|request| request_has_prompt_and_model(request, "follow-up message"))
+    );
+    Ok(())
+}
