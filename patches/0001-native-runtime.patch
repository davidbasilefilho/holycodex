@@ -0,0 +1,1216 @@
+#![forbid(unsafe_code)]
+
+//! Typed primitives for Sign in with ChatGPT (SIWC) open-source registration.
+//!
+//! This module deliberately stops at authorization construction, callback/identity
+//! validation, and typed registration metadata. It does not own credential storage
+//! or connect SIWC tokens to Codex's existing authentication manager.
+
+use std::time::Duration;
+
+use codex_http_client::HttpClient;
+use jsonwebtoken::Algorithm;
+use jsonwebtoken::DecodingKey;
+use jsonwebtoken::Validation;
+use jsonwebtoken::decode;
+use jsonwebtoken::decode_header;
+use jsonwebtoken::jwk::JwkSet;
+use serde::Deserialize;
+use serde::Serialize;
+use serde::de::Error as _;
+use thiserror::Error;
+use url::Url;
+
+/// The production SIWC OpenID Connect issuer.
+pub const ISSUER: &str = "https://auth.openai.com";
+/// The SIWC production authorization endpoint.
+pub const AUTHORIZE_ENDPOINT: &str = "https://auth.openai.com/api/accounts/authorize";
+/// The SIWC production token endpoint.
+pub const TOKEN_ENDPOINT: &str = "https://auth.openai.com/api/accounts/oauth/token";
+/// OpenAI's published production OIDC signing keys.
+pub const JWKS_ENDPOINT: &str = "https://auth.openai.com/.well-known/jwks.json";
+/// Resource identifier used by SIWC plan-usage requests.
+pub const RESOURCE: &str = "https://api.openai.com/v1";
+/// Initial-registration label; never included when reauthorizing an issued client.
+pub const AGENT_NAME_HINT: &str = "HolyCodex";
+/// Dynamic registration entrypoint; it is not a persistent client identity.
+pub const DYNAMIC_CLIENT_ID: &str = "dynamic_agent_client";
+/// Requested SIWC scopes. The provider's actual grant must be stored separately.
+pub const REQUESTED_SCOPES: &[&str] = &[
+    "openid",
+    "profile",
+    "email",
+    "offline_access",
+    "resource.invoke",
+    "chatgpt.tokens.use.direct",
+];
+
+const JWT_CLOCK_SKEW_SECONDS: u64 = 5;
+const JWKS_FETCH_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// Errors produced while constructing or validating SIWC data.
+#[derive(Debug, Error)]
+pub enum SiwcError {
+    #[error("invalid SIWC {0}")]
+    InvalidValue(&'static str),
+    #[error("the callback state does not match the authorization attempt")]
+    StateMismatch,
+    #[error("the callback client ID does not match the selected registration")]
+    ClientIdMismatch,
+    #[error("the verified identity does not match the selected registration")]
+    IdentityMismatch,
+    #[error("the token grant does not include ChatGPT plan-usage scopes")]
+    PlanUsageNotGranted,
+    #[error("the ID token could not be verified")]
+    InvalidIdToken,
+    #[error("failed to fetch OpenAI's published SIWC signing keys: {0}")]
+    JwksFetch(#[from] codex_http_client::HttpError),
+    #[error("failed to decode OpenAI's published SIWC signing keys: {0}")]
+    JwksDecode(#[from] serde_json::Error),
+}
+
+/// An issued SIWC client ID. The dynamic first-registration sentinel is rejected.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct IssuedClientId(String);
+
+impl IssuedClientId {
+    /// Validate an issued `oaiapp_...` client identifier.
+    pub fn parse(value: impl Into<String>) -> Result<Self, SiwcError> {
+        let value = value.into();
+        let suffix = value.strip_prefix("oaiapp_");
+        if suffix.is_none_or(|suffix| {
+            suffix.is_empty()
+                || !suffix
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+        }) {
+            return Err(SiwcError::InvalidValue("issued client ID"));
+        }
+        Ok(Self(value))
+    }
+
+    /// Return the validated issued client ID.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl<'de> Deserialize<'de> for IssuedClientId {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        Self::parse(String::deserialize(deserializer)?).map_err(D::Error::custom)
+    }
+}
+
+/// A stable, host-specific opaque identifier sent as `ext_agent_host_id`.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct AgentHostId(String);
+
+impl AgentHostId {
+    /// Validate a persistent host ID without deriving it from account identity.
+    pub fn parse(value: impl Into<String>) -> Result<Self, SiwcError> {
+        let value = value.into();
+        if value.is_empty()
+            || value.len() > 512
+            || value.trim() != value
+            || value.chars().any(char::is_whitespace)
+            || value.chars().any(char::is_control)
+        {
+            return Err(SiwcError::InvalidValue("agent host ID"));
+        }
+        Ok(Self(value))
+    }
+
+    /// Return the host ID to reuse on this host's later authorizations.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl<'de> Deserialize<'de> for AgentHostId {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        Self::parse(String::deserialize(deserializer)?).map_err(D::Error::custom)
+    }
+}
+
+/// Whether this authorization creates a registration or reuses a saved one.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum AuthorizationClient {
+    /// First registration; the callback must return its issued `oaiapp_...` ID.
+    InitialRegistration,
+    /// Returning sign-in; the issued ID is reused, never dynamically re-registered.
+    Returning(IssuedClientId),
+}
+
+/// Fresh transaction data needed to form the SIWC authorization URL.
+#[derive(Clone, Debug)]
+pub struct AuthorizationRequest {
+    pub client: AuthorizationClient,
+    pub host_id: AgentHostId,
+    pub redirect_uri: Url,
+    pub state: String,
+    pub nonce: String,
+    pub code_challenge: String,
+}
+
+impl AuthorizationRequest {
+    /// Build the official SIWC authorization URL with resource and PKCE parameters.
+    pub fn to_url(&self) -> Result<Url, SiwcError> {
+        validate_redirect_uri(&self.redirect_uri)?;
+        validate_transaction_value(&self.state, "state")?;
+        validate_transaction_value(&self.nonce, "nonce")?;
+        validate_transaction_value(&self.code_challenge, "PKCE code challenge")?;
+        if self.code_challenge.len() != 43
+            || !self
+                .code_challenge
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+        {
+            return Err(SiwcError::InvalidValue("S256 PKCE code challenge"));
+        }
+
+        let mut url = Url::parse(AUTHORIZE_ENDPOINT)
+            .map_err(|_| SiwcError::InvalidValue("authorization endpoint"))?;
+        {
+            let mut query = url.query_pairs_mut();
+            let client_id = match &self.client {
+                AuthorizationClient::InitialRegistration => DYNAMIC_CLIENT_ID,
+                AuthorizationClient::Returning(client_id) => client_id.as_str(),
+            };
+            query.append_pair("client_id", client_id);
+            query.append_pair("resource", RESOURCE);
+            query.append_pair("scope", &REQUESTED_SCOPES.join(" "));
+            query.append_pair("response_type", "code");
+            query.append_pair("redirect_uri", self.redirect_uri.as_str());
+            query.append_pair("ext_agent_host_id", self.host_id.as_str());
+            if matches!(self.client, AuthorizationClient::InitialRegistration) {
+                query.append_pair("agent_name_hint", AGENT_NAME_HINT);
+            }
+            query.append_pair("state", &self.state);
+            query.append_pair("nonce", &self.nonce);
+            query.append_pair("code_challenge_method", "S256");
+            query.append_pair("code_challenge", &self.code_challenge);
+        }
+        Ok(url)
+    }
+}
+
+fn validate_redirect_uri(uri: &Url) -> Result<(), SiwcError> {
+    if uri.scheme() != "http"
+        || uri.host_str() != Some("127.0.0.1")
+        || uri.port().is_none()
+        || !uri.username().is_empty()
+        || uri.password().is_some()
+        || uri.query().is_some()
+        || uri.fragment().is_some()
+        || uri.path() == "/"
+    {
+        return Err(SiwcError::InvalidValue("loopback redirect URI"));
+    }
+    Ok(())
+}
+
+fn validate_transaction_value(value: &str, name: &'static str) -> Result<(), SiwcError> {
+    if value.trim().is_empty() || value.len() > 1024 || value.chars().any(char::is_control) {
+        return Err(SiwcError::InvalidValue(name));
+    }
+    Ok(())
+}
+
+/// Validate callback state and apply SIWC's initial/returning client-ID rules.
+///
+/// Call only after the callback handler has rejected OAuth errors. The handler
+/// owns one-time transaction consumption, code presence, and transaction expiry.
+pub fn validate_callback_client_id(
+    client: &AuthorizationClient,
+    expected_state: &str,
+    callback_state: &str,
+    callback_client_id: Option<&str>,
+) -> Result<IssuedClientId, SiwcError> {
+    validate_transaction_value(expected_state, "state")?;
+    if expected_state != callback_state {
+        return Err(SiwcError::StateMismatch);
+    }
+    match client {
+        AuthorizationClient::InitialRegistration => IssuedClientId::parse(
+            callback_client_id.ok_or(SiwcError::InvalidValue("initial callback client ID"))?,
+        ),
+        AuthorizationClient::Returning(issued) => {
+            if let Some(callback_id) = callback_client_id
+                && callback_id != issued.as_str()
+            {
+                return Err(SiwcError::ClientIdMismatch);
+            }
+            Ok(issued.clone())
+        }
+    }
+}
+
+/// Build the form fields for a public-client SIWC refresh request.
+#[derive(Clone, PartialEq, Eq, Serialize)]
+pub struct RefreshTokenRequest {
+    grant_type: &'static str,
+    client_id: IssuedClientId,
+    refresh_token: String,
+    resource: &'static str,
+}
+
+impl std::fmt::Debug for RefreshTokenRequest {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("RefreshTokenRequest")
+            .field("client_id", &self.client_id)
+            .field("refresh_token", &"[REDACTED]")
+            .field("resource", &self.resource)
+            .finish()
+    }
+}
+
+impl RefreshTokenRequest {
+    /// Create a refresh form using the saved issued ID, not the dynamic sentinel.
+    pub fn new(
+        client_id: IssuedClientId,
+        refresh_token: impl Into<String>,
+    ) -> Result<Self, SiwcError> {
+        let refresh_token = refresh_token.into();
+        if refresh_token.is_empty() || refresh_token.chars().any(char::is_control) {
+            return Err(SiwcError::InvalidValue("refresh token"));
+        }
+        Ok(Self {
+            grant_type: "refresh_token",
+            client_id,
+            refresh_token,
+            resource: RESOURCE,
+        })
+    }
+
+    /// Return ordered form pairs suitable for an HTTP form POST to [`TOKEN_ENDPOINT`].
+    pub fn form_pairs(&self) -> [(&'static str, &str); 4] {
+        [
+            ("grant_type", self.grant_type),
+            ("client_id", self.client_id.as_str()),
+            ("refresh_token", &self.refresh_token),
+            ("resource", self.resource),
+        ]
+    }
+}
+
+/// Fetch only the fixed, official OpenAI production SIWC JWKS endpoint through
+/// the auth transport configured by the caller.
+pub async fn fetch_openai_jwks(client: &HttpClient) -> Result<JwkSet, SiwcError> {
+    fetch_jwks_from_endpoint(client, JWKS_ENDPOINT).await
+}
+
+async fn fetch_jwks_from_endpoint(
+    client: &HttpClient,
+    endpoint: &str,
+) -> Result<JwkSet, SiwcError> {
+    let bytes = client
+        .get(endpoint)
+        .timeout(JWKS_FETCH_TIMEOUT)
+        .send()
+        .await?
+        .error_for_status()?
+        .bytes()
+        .await?;
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(untagged)]
+enum Audience {
+    One(String),
+    Many(Vec<String>),
+}
+
+#[derive(Clone, Debug, Deserialize)]
+struct IdTokenClaims {
+    iss: String,
+    sub: String,
+    aud: Audience,
+    exp: u64,
+    iat: u64,
+    #[serde(default)]
+    nonce: String,
+    #[serde(default)]
+    azp: Option<String>,
+}
+
+/// Verified identity claims safe to associate with an issued SIWC registration.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedIdentity {
+    issuer: String,
+    subject: String,
+    client_id: IssuedClientId,
+    expires_at: u64,
+    nonce: String,
+}
+
+impl VerifiedIdentity {
+    /// The validated OIDC issuer.
+    pub fn issuer(&self) -> &str {
+        &self.issuer
+    }
+
+    /// The validated OIDC subject (an account identity, not a workspace ID).
+    pub fn subject(&self) -> &str {
+        &self.subject
+    }
+
+    /// The issued SIWC client ID used as the expected JWT audience.
+    pub fn client_id(&self) -> &IssuedClientId {
+        &self.client_id
+    }
+
+    /// The verified ID token expiration in Unix seconds.
+    pub fn expires_at(&self) -> u64 {
+        self.expires_at
+    }
+
+    /// The nonce validated against the one-time authorization attempt.
+    pub fn nonce(&self) -> &str {
+        &self.nonce
+    }
+}
+
+/// Verify an ID token's RS256 signature and SIWC issuer, audience, expiry, subject, and nonce.
+pub fn validate_id_token(
+    id_token: &str,
+    jwks: &JwkSet,
+    client_id: IssuedClientId,
+    expected_nonce: &str,
+) -> Result<VerifiedIdentity, SiwcError> {
+    validate_transaction_value(expected_nonce, "nonce")?;
+    validate_token_identity(id_token, jwks, client_id, Some(expected_nonce))
+}
+
+/// A refresh ID token has no new authorization transaction and may omit `nonce`.
+/// The caller must additionally enforce the stored issuer/subject/client registration.
+pub fn validate_refresh_id_token(
+    id_token: &str,
+    jwks: &JwkSet,
+    client_id: IssuedClientId,
+    original_nonce: &str,
+) -> Result<VerifiedIdentity, SiwcError> {
+    let identity = validate_token_identity(id_token, jwks, client_id, None)?;
+    if !identity.nonce.is_empty() && identity.nonce != original_nonce {
+        return Err(SiwcError::InvalidIdToken);
+    }
+    Ok(identity)
+}
+
+fn validate_token_identity(
+    id_token: &str,
+    jwks: &JwkSet,
+    client_id: IssuedClientId,
+    expected_nonce: Option<&str>,
+) -> Result<VerifiedIdentity, SiwcError> {
+    let header = decode_header(id_token).map_err(|_| SiwcError::InvalidIdToken)?;
+    if header.alg != Algorithm::RS256 {
+        return Err(SiwcError::InvalidIdToken);
+    }
+    let kid = header.kid.ok_or(SiwcError::InvalidIdToken)?;
+    let jwk = jwks.find(&kid).ok_or(SiwcError::InvalidIdToken)?;
+    if jwk
+        .common
+        .public_key_use
+        .as_ref()
+        .is_some_and(|usage| *usage != jsonwebtoken::jwk::PublicKeyUse::Signature)
+        || jwk
+            .common
+            .key_algorithm
+            .is_some_and(|algorithm| algorithm != jsonwebtoken::jwk::KeyAlgorithm::RS256)
+        || jwk
+            .common
+            .key_operations
+            .as_ref()
+            .is_some_and(|operations| {
+                !operations.contains(&jsonwebtoken::jwk::KeyOperations::Verify)
+            })
+    {
+        return Err(SiwcError::InvalidIdToken);
+    }
+    let decoding_key = DecodingKey::from_jwk(jwk).map_err(|_| SiwcError::InvalidIdToken)?;
+    let mut validation = Validation::new(Algorithm::RS256);
+    validation.set_issuer(&[ISSUER]);
+    validation.set_audience(&[client_id.as_str()]);
+    validation.leeway = JWT_CLOCK_SKEW_SECONDS;
+    validation.validate_nbf = true;
+    validation
+        .required_spec_claims
+        .extend(["iss", "sub", "aud", "exp"].into_iter().map(str::to_string));
+    let claims = decode::<IdTokenClaims>(id_token, &decoding_key, &validation)
+        .map_err(|_| SiwcError::InvalidIdToken)?
+        .claims;
+    if claims.iss != ISSUER
+        || claims.sub.trim().is_empty()
+        || claims.sub.chars().any(char::is_control)
+        || expected_nonce.is_some_and(|nonce| claims.nonce != nonce)
+        || !audience_contains(&claims.aud, client_id.as_str())
+        || claims.iat > jsonwebtoken::get_current_timestamp().saturating_add(JWT_CLOCK_SKEW_SECONDS)
+        || claims
+            .azp
+            .as_deref()
+            .is_some_and(|azp| azp != client_id.as_str())
+        || matches!(&claims.aud, Audience::Many(audiences) if audiences.len() > 1 && claims.azp.is_none())
+    {
+        return Err(SiwcError::InvalidIdToken);
+    }
+    Ok(VerifiedIdentity {
+        issuer: claims.iss,
+        subject: claims.sub,
+        client_id,
+        expires_at: claims.exp,
+        nonce: claims.nonce,
+    })
+}
+
+fn audience_contains(audience: &Audience, expected: &str) -> bool {
+    match audience {
+        Audience::One(value) => value == expected,
+        Audience::Many(values) => values.iter().any(|value| value == expected),
+    }
+}
+
+/// Metadata to persist alongside upstream `TokenData` in the protected credential store.
+///
+/// Identity is `(issuer, subject)`; registrations additionally retain their issued
+/// client ID. `subject` is never a workspace ID. Deserialization validates structure
+/// only and assumes the credential store protects the record's integrity. New
+/// metadata can be constructed only from a cryptographically verified identity.
+/// Token strings and their upstream serde representation remain owned by `TokenData`.
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub struct RegistrationMetadata {
+    issuer: String,
+    subject: String,
+    client_id: IssuedClientId,
+    ext_agent_host_id: AgentHostId,
+    scopes: Vec<String>,
+    expires_at: u64,
+    authorization_nonce: String,
+}
+
+#[derive(Deserialize)]
+struct RegistrationMetadataWire {
+    issuer: String,
+    subject: String,
+    client_id: IssuedClientId,
+    ext_agent_host_id: AgentHostId,
+    scopes: Vec<String>,
+    expires_at: u64,
+    authorization_nonce: String,
+}
+
+impl<'de> Deserialize<'de> for RegistrationMetadata {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        let wire = RegistrationMetadataWire::deserialize(deserializer)?;
+        Self::try_from(wire).map_err(D::Error::custom)
+    }
+}
+
+impl TryFrom<RegistrationMetadataWire> for RegistrationMetadata {
+    type Error = SiwcError;
+
+    fn try_from(wire: RegistrationMetadataWire) -> Result<Self, Self::Error> {
+        if wire.issuer != ISSUER {
+            return Err(SiwcError::InvalidValue("registration issuer"));
+        }
+        validate_subject(&wire.subject)?;
+        validate_transaction_value(&wire.authorization_nonce, "registration nonce")?;
+        validate_scopes(&wire.scopes)?;
+        if wire.expires_at == 0 {
+            return Err(SiwcError::InvalidValue("registration expiration"));
+        }
+        Ok(Self {
+            issuer: wire.issuer,
+            subject: wire.subject,
+            client_id: wire.client_id,
+            ext_agent_host_id: wire.ext_agent_host_id,
+            scopes: wire.scopes,
+            expires_at: wire.expires_at,
+            authorization_nonce: wire.authorization_nonce,
+        })
+    }
+}
+
+impl RegistrationMetadata {
+    /// Create protected registration metadata from a verified identity and actual grant.
+    pub fn from_verified_identity(
+        identity: VerifiedIdentity,
+        host_id: AgentHostId,
+        granted_scopes: Vec<String>,
+        expires_at: u64,
+    ) -> Result<Self, SiwcError> {
+        Self::try_from(RegistrationMetadataWire {
+            issuer: identity.issuer,
+            subject: identity.subject,
+            client_id: identity.client_id,
+            ext_agent_host_id: host_id,
+            scopes: granted_scopes,
+            expires_at,
+            authorization_nonce: identity.nonce,
+        })
+    }
+
+    /// Verified issuer.
+    pub fn issuer(&self) -> &str {
+        &self.issuer
+    }
+
+    /// Verified subject; it is intentionally not interpreted as a workspace ID.
+    pub fn subject(&self) -> &str {
+        &self.subject
+    }
+
+    /// OpenAI-issued client ID associated with this registration.
+    pub fn client_id(&self) -> &IssuedClientId {
+        &self.client_id
+    }
+
+    /// Persistent host ID to reuse for this installation.
+    pub fn host_id(&self) -> &AgentHostId {
+        &self.ext_agent_host_id
+    }
+
+    /// Scopes actually granted by the provider.
+    pub fn scopes(&self) -> &[String] {
+        &self.scopes
+    }
+
+    /// Check an exact scope in the provider's actual grant.
+    pub fn has_scope(&self, scope: &str) -> bool {
+        self.scopes.iter().any(|granted| granted == scope)
+    }
+
+    /// Token expiration in Unix seconds, supplied from the token response.
+    pub fn expires_at(&self) -> u64 {
+        self.expires_at
+    }
+
+    /// Original authorization nonce, retained to validate optional refresh ID tokens.
+    pub fn authorization_nonce(&self) -> &str {
+        &self.authorization_nonce
+    }
+
+    /// Compare stable registration identity independently of rotating grant metadata.
+    pub fn same_registration(&self, other: &Self) -> bool {
+        self.issuer == other.issuer
+            && self.subject == other.subject
+            && self.client_id == other.client_id
+            && self.ext_agent_host_id == other.ext_agent_host_id
+    }
+
+    /// Require both scopes that authorize ChatGPT plan usage for inference.
+    pub fn require_plan_usage(&self) -> Result<(), SiwcError> {
+        if self.has_scope("resource.invoke") && self.has_scope("chatgpt.tokens.use.direct") {
+            Ok(())
+        } else {
+            Err(SiwcError::PlanUsageNotGranted)
+        }
+    }
+
+    /// Update grant metadata after a successful refresh while retaining registration identity.
+    ///
+    /// If the refresh response omits scope, the caller must retain `self.scopes()`.
+    /// Store this result atomically with upstream tokens, including a rotating refresh token.
+    pub fn with_refreshed_grant(
+        &self,
+        granted_scopes: Vec<String>,
+        expires_at: u64,
+    ) -> Result<Self, SiwcError> {
+        Self::try_from(RegistrationMetadataWire {
+            issuer: self.issuer.clone(),
+            subject: self.subject.clone(),
+            client_id: self.client_id.clone(),
+            ext_agent_host_id: self.ext_agent_host_id.clone(),
+            scopes: granted_scopes,
+            expires_at,
+            authorization_nonce: self.authorization_nonce.clone(),
+        })
+    }
+
+    /// Ensure a refreshed/returning verified identity belongs to this registration.
+    pub fn validate_returning_identity(
+        &self,
+        identity: &VerifiedIdentity,
+    ) -> Result<(), SiwcError> {
+        if self.issuer == identity.issuer
+            && self.subject == identity.subject
+            && self.client_id == identity.client_id
+        {
+            Ok(())
+        } else {
+            Err(SiwcError::IdentityMismatch)
+        }
+    }
+}
+
+fn validate_subject(subject: &str) -> Result<(), SiwcError> {
+    if subject.trim().is_empty() || subject.chars().any(char::is_control) {
+        return Err(SiwcError::InvalidValue("registration subject"));
+    }
+    Ok(())
+}
+
+fn validate_scopes(scopes: &[String]) -> Result<(), SiwcError> {
+    if scopes.iter().any(|scope| {
+        scope.is_empty()
+            || !scope.bytes().all(|byte| {
+                byte == 0x21 || (0x23..=0x5b).contains(&byte) || (0x5d..=0x7e).contains(&byte)
+            })
+    }) {
+        return Err(SiwcError::InvalidValue("granted scopes"));
+    }
+    Ok(())
+}
+
+/// Parse the token response's space-separated granted scope value.
+///
+/// These are actual grants; the requested scopes or callback scope must not be
+/// substituted for a missing token-response scope.
+pub fn parse_granted_scopes(scope: &str) -> Result<Vec<String>, SiwcError> {
+    let scopes: Vec<String> = scope
+        .split(' ')
+        .filter(|value| !value.is_empty())
+        .map(str::to_string)
+        .collect();
+    validate_scopes(&scopes)?;
+    Ok(scopes)
+}
