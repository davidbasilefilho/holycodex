+    #[test]
+    fn all_tool_inputs_cross_the_function_json_envelope_as_typed_toon() {
+        let assignment = json!({
+            "role":"Worker.implementation", "objective":"implement", "bounded_scope":["src"],
+            "constraints":[], "acceptance_criteria":["works"], "required_evidence":["tests"],
+            "mutability":"read_only", "ownership_paths":[], "symbols":[], "domains":[],
+            "dependencies":[], "independent_review_of":[]
+        });
+        let payloads = [
+            (
+                "intent.update",
+                json!({"objective":"new","accepted_scope":["src"],"requirements":[]}),
+            ),
+            ("assignment.dispatch", assignment.clone()),
+            (
+                "assignment.followup",
+                json!({"prior_assignment_id":"a-1","assignment":assignment}),
+            ),
+            (
+                "assignment.wait",
+                json!({"assignment_id":"a-1", "timeout_ms":900000}),
+            ),
+            ("assignment.cancel", json!({"assignment_id":"a-1"})),
+            (
+                "assignment.finish",
+                json!({"assignment_id":"a-1","result":"done","success":true}),
+            ),
+        ];
+        for (name, value) in payloads {
+            let payload = encode_toon(&value).unwrap();
+            let envelope = serde_json::to_string(&json!({"payload":payload})).unwrap();
+            let envelope: ToolEnvelope = serde_json::from_str(&envelope).unwrap();
+            let definition = tool_definition(name);
+            assert_eq!(definition.1["properties"]["payload"]["type"], "string");
+            match name {
+                "intent.update" => {
+                    decode_model_payload::<IntentUpdate>(&envelope.payload).unwrap();
+                }
+                "assignment.dispatch" => {
+                    decode_model_payload::<AssignmentInput>(&envelope.payload).unwrap();
+                }
+                "assignment.followup" => {
+                    decode_model_payload::<FollowupRequest>(&envelope.payload).unwrap();
+                }
+                "assignment.wait" => {
+                    decode_model_payload::<AssignmentWaitRequest>(&envelope.payload).unwrap();
+                }
+                "assignment.cancel" => {
+                    decode_model_payload::<AssignmentId>(&envelope.payload).unwrap();
+                }
+                "assignment.finish" => {
+                    decode_model_payload::<FinishRequest>(&envelope.payload).unwrap();
+                }
+                _ => unreachable!(),
+            }
+        }
+        assert!(
+            serde_json::from_str::<ToolEnvelope>(r#"{"payload":"objective: x","extra":true}"#)
+                .is_err()
+        );
+        let mut unknown_field = encode_toon(&json!({
+            "objective":"x", "accepted_scope":[], "requirements":[]
+        }))
+        .unwrap();
+        unknown_field.push_str("\nextra: no");
+        assert!(decode_model_payload::<IntentUpdate>(&unknown_field).is_err());
+        assert!(parse_mutability("unrestricted").is_err());
+        assert_eq!(
+            parse_mutability("scoped_write").unwrap(),
+            Mutability::ScopedWrite
+        );
+    }
