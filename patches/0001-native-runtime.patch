+pub(crate) fn read_only_profile_with_root_temp_write(
+    root_profile: &PermissionProfile,
+) -> Option<PermissionProfile> {
+    let root_filesystem = root_profile.file_system_sandbox_policy();
+    let tmpdir_path = FileSystemPath::Special {
+        value: FileSystemSpecialPath::Tmpdir,
+    };
+    let root_path = FileSystemPath::Special {
+        value: FileSystemSpecialPath::Root,
+    };
+    let tmpdir_entries = root_filesystem
+        .entries
+        .iter()
+        .filter(|entry| entry.path == tmpdir_path)
+        .map(|entry| entry.access)
+        .collect::<Vec<_>>();
+    let root_grants_temp_write = if !tmpdir_entries.is_empty() {
+        tmpdir_entries
+            .iter()
+            .all(|access| *access == FileSystemAccessMode::Write)
+    } else {
+        root_filesystem.kind == codex_protocol::permissions::FileSystemSandboxKind::Unrestricted
+            || root_filesystem
+                .entries
+                .iter()
+                .any(|entry| entry.path == root_path && entry.access == FileSystemAccessMode::Write)
+    };
+    let mut read_only = root_profile.intersect_with_read_only()?;
+    if !root_grants_temp_write {
+        return Some(read_only);
+    }
+    let mut filesystem = read_only.file_system_sandbox_policy();
+    let existing_tmpdir = filesystem
+        .entries
+        .iter_mut()
+        .find(|entry| entry.path == tmpdir_path);
+    if let Some(entry) = existing_tmpdir {
+        entry.access = FileSystemAccessMode::Write;
+    } else {
+        filesystem
+            .entries
+            .push(codex_protocol::permissions::FileSystemSandboxEntry::new(
+                tmpdir_path,
+                FileSystemAccessMode::Write,
+            ));
+    }
+    read_only =
+        PermissionProfile::from_runtime_permissions(&filesystem, NetworkSandboxPolicy::Restricted);
+    Some(read_only)
+}
