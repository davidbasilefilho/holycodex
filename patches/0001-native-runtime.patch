+/// Resolve an effective native prompt only after the runtime source and model are both known.
+/// The model catalog is shared with maintenance sessions, so a model slug alone cannot authorize
+/// replacing its upstream instructions.
+pub(crate) fn native_model_instructions(
+    source: &SessionSource,
+    model_slug: &str,
+) -> Option<&'static str> {
+    match (
+        native_prompt_role(source)?,
+        codex_models_manager::model_info::holy_model_id(model_slug)?,
+    ) {
+        (RoleTask::Root, holycodex_policy::ModelId::Gpt61Sol) => {
+            Some(holycodex_policy::ROOT_INSTRUCTIONS)
+        }
+        (role, holycodex_policy::ModelId::Gpt6Luna) if role != RoleTask::Root => {
+            Some(holycodex_policy::SPECIALIST_INSTRUCTIONS)
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn native_prompt_role(source: &SessionSource) -> Option<RoleTask> {
+    match source {
+        SessionSource::Internal(_)
+        | SessionSource::SubAgent(
+            SubAgentSource::Review | SubAgentSource::Compact | SubAgentSource::MemoryConsolidation,
+        ) => None,
+        SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            agent_path: Some(path),
+            agent_role: Some(role),
+            ..
+        }) if is_native_specialist_path(path) => {
+            RoleTask::parse(role).filter(|role| *role != RoleTask::Root)
+        }
+        SessionSource::SubAgent(_) => None,
+        _ => Some(RoleTask::Root),
+    }
+}
+
+const NATIVE_SPECIALIST_PATH_PREFIX: &str = "hc_";
+
+pub(crate) fn is_native_specialist_path(path: &AgentPath) -> bool {
+    reserved_specialist_id(path).is_some()
+}
+
+pub(crate) fn specialist_path_segment(reserved_id: &str) -> Result<String, String> {
+    let reserved_id = Uuid::parse_str(reserved_id)
+        .map_err(|_| "reserved specialist ID must be a UUID".to_owned())?;
+    Ok(format!(
+        "{NATIVE_SPECIALIST_PATH_PREFIX}{}",
+        reserved_id.to_string().replace('-', "_")
+    ))
+}
+
+pub(crate) fn reserved_specialist_id(path: &AgentPath) -> Option<String> {
+    let encoded_id = path.name().strip_prefix(NATIVE_SPECIALIST_PATH_PREFIX)?;
+    let parsed_id = Uuid::parse_str(&encoded_id.replace('_', "-")).ok()?;
+    let reserved_id = parsed_id.to_string();
+    (specialist_path_segment(&reserved_id).ok()? == path.name()).then_some(reserved_id)
+}
+
+const STATE_FILE: &str = "holycodex-intent.toml";
+const LEGACY_STATE_FILE: &str = "holycodex-intent.json";
+
+/// Semantic dispatch arguments. Model, effort and specialist identity are runtime-owned.
+#[derive(Clone, Debug)]
+pub struct DispatchRequest {
+    pub role: RoleTask,
+    pub objective: String,
+    pub bounded_scope: Vec<String>,
+    pub constraints: Vec<String>,
+    pub acceptance_criteria: Vec<String>,
+    pub required_evidence: Vec<String>,
+    pub mutability: holycodex_policy::Mutability,
+    pub metadata: AssignmentMetadata,
+}
+
+/// Grants confirmed by the live native authority adapter.
+///
+/// Delegation must be disabled in both the visible tool surface and effective
+/// dispatch authority. Merely observing a configured spawn depth is insufficient.
+#[derive(Clone, Debug)]
+pub struct SpecialistGrants {
+    pub capabilities: BTreeSet<Capability>,
+    pub supports_role_rebinding: bool,
+    pub delegation_disabled: bool,
+}
+
+/// Restricted specialist configuration prepared by the runtime adapter.
+pub struct PreparedSpecialist {
+    pub config: Config,
+    pub grants: SpecialistGrants,
+}
+
+/// Authority boundary for the later native tool adapter.
+///
+/// Implementations inspect actual tool/permission grants. Preparation must build
+/// specialist base instructions, scoped authority and a restricted tool profile.
+/// Rebinding must apply role instructions, effort and authority to an already
+/// loaded thread before returning; changing only its resume config is insufficient.
+/// There is deliberately no permissive Root-config fallback.
+pub trait SpecialistAuthority: Send + Sync {
+    fn prepare<'a>(
+        &'a self,
+        assignment: &'a Assignment,
+        profile: Profile,
+    ) -> BoxFuture<'a, Result<PreparedSpecialist, ControllerError>>;
+    fn inspect(&self, thread: ThreadId)
+    -> BoxFuture<'_, Result<SpecialistGrants, ControllerError>>;
+    fn rebind<'a>(
+        &'a self,
+        thread: ThreadId,
+        assignment: &'a Assignment,
+        profile: Profile,
+    ) -> BoxFuture<'a, Result<PreparedSpecialist, ControllerError>>;
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+struct FinishReport {
+    result: String,
+    success: bool,
+}
+
+/// Persisted policy plus execution receipts still awaiting runtime termination.
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ControllerState {
+    pub intent: Intent,
+    pub assignments: Vec<Assignment>,
+    pub specialists: BTreeMap<String, SpecialistContext>,
+    #[serde(default)]
+    launching: BTreeSet<String>,
+    #[serde(default)]
+    cancellation_requested: BTreeSet<String>,
+    #[serde(default)]
+    finish_reports: BTreeMap<String, FinishReport>,
+    #[serde(default)]
+    execution_errors: BTreeMap<String, String>,
+    /// A reused child may have accepted a turn even when its send acknowledgement
+    /// was lost. Its previous terminal status cannot resolve this Assignment.
+    #[serde(default)]
+    ambiguous_reused_launches: BTreeSet<String>,
+}
+
+/// TOON-safe semantic projection avoids exposing serde enum encodings as a
+/// string-only TOON scalar; Role.task and lifecycle values stay validated text.
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct AssignmentProjection {
+    pub id: String,
+    pub intent_id: String,
+    pub role: String,
+    pub objective: String,
+    pub bounded_scope: Vec<String>,
+    pub constraints: Vec<String>,
+    pub acceptance_criteria: Vec<String>,
+    pub required_evidence: Vec<String>,
+    pub mutability: String,
+    pub metadata: AssignmentMetadataProjection,
+    pub status: String,
+    pub specialist_id: Option<String>,
+    pub result: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct AssignmentMetadataProjection {
+    pub ownership_paths: BTreeSet<String>,
+    pub symbols: BTreeSet<String>,
+    pub domains: BTreeSet<String>,
+    pub dependencies: BTreeSet<String>,
+    pub related_assignments: BTreeSet<String>,
+    pub independent_review_of: BTreeSet<String>,
+}
+
+pub(crate) fn assignment_projection(assignment: &Assignment) -> AssignmentProjection {
+    AssignmentProjection {
+        id: assignment.id.clone(),
+        intent_id: assignment.intent_id.clone(),
+        role: assignment.role.as_str().to_owned(),
+        objective: assignment.objective.clone(),
+        bounded_scope: assignment.bounded_scope.clone(),
+        constraints: assignment.constraints.clone(),
+        acceptance_criteria: assignment.acceptance_criteria.clone(),
+        required_evidence: assignment.required_evidence.clone(),
+        mutability: match assignment.mutability {
+            holycodex_policy::Mutability::ReadOnly => "read_only",
+            holycodex_policy::Mutability::ScopedWrite => "scoped_write",
+            holycodex_policy::Mutability::Operational => "operational",
+        }
+        .to_owned(),
+        metadata: AssignmentMetadataProjection {
+            ownership_paths: assignment.metadata.ownership_paths.clone(),
+            symbols: assignment.metadata.symbols.clone(),
+            domains: assignment.metadata.domains.clone(),
+            dependencies: assignment.metadata.dependencies.iter().cloned().collect(),
+            related_assignments: assignment
+                .metadata
+                .related_assignments
+                .iter()
+                .cloned()
+                .collect(),
+            independent_review_of: assignment
+                .metadata
+                .independent_review_of
+                .iter()
+                .cloned()
+                .collect(),
+        },
+        status: match assignment.status {
+            AssignmentStatus::Ready => "ready",
+            AssignmentStatus::Running => "running",
+            AssignmentStatus::Succeeded => "succeeded",
+            AssignmentStatus::Failed => "failed",
+            AssignmentStatus::Cancelled => "cancelled",
+        }
+        .to_owned(),
+        specialist_id: assignment.specialist_id.clone(),
+        result: assignment.result.clone(),
+    }
+}
+
+impl ControllerState {
+    fn validate(&self) -> Result<(), ControllerError> {
+        validate_policy_state(&PersistedPolicyState {
+            intents: vec![self.intent.clone()],
+            assignments: self.assignments.clone(),
+            specialists: self.specialists.values().cloned().collect(),
+        })?;
+        for assignment in &self.assignments {
+            let route = route_policy(assignment.role).ok_or(LifecycleError::RootNotSpecialist)?;
+            if route
+                .independence
+                .contains(&IndependenceRequirement::IndependentReview)
+                && self.assignments.iter().any(|prior| {
+                    assignment
+                        .metadata
+                        .independent_review_of
+                        .contains(&prior.id)
+                        && assignment.specialist_id.is_some()
+                        && prior.specialist_id == assignment.specialist_id
+                })
+            {
+                return Err(ControllerError::InvalidState(format!(
+                    "review Assignment {} shares a specialist with reviewed work",
+                    assignment.id
+                )));
+            }
+        }
+        if self.specialists.iter().any(|(key, value)| key != &value.id) {
+            return Err(ControllerError::InvalidState(
+                "specialist map key differs from identity".into(),
+            ));
+        }
+        for id in self
+            .launching
+            .iter()
+            .chain(&self.cancellation_requested)
+            .chain(self.finish_reports.keys())
+            .chain(self.execution_errors.keys())
+            .chain(&self.ambiguous_reused_launches)
+        {
+            if self.assignment(id)?.status != AssignmentStatus::Running {
+                return Err(ControllerError::InvalidState(format!(
+                    "execution receipt {id} has no running Assignment"
+                )));
+            }
+        }
+        if self
+            .finish_reports
+            .values()
+            .any(|report| report.result.trim().is_empty())
+        {
+            return Err(ControllerError::EmptyResult);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn assignment(&self, id: &str) -> Result<&Assignment, ControllerError> {
+        self.assignments
+            .iter()
+            .find(|assignment| assignment.id == id)
+            .ok_or_else(|| ControllerError::UnknownAssignment(id.into()))
+    }
+
+    fn reserve(
+        &mut self,
+        mut assignment: Assignment,
+        new_grants: &SpecialistGrants,
+        observed: &BTreeMap<String, SpecialistGrants>,
+    ) -> Result<(Assignment, bool), ControllerError> {
+        validate_dispatch_for_intent(&self.intent, &assignment, &self.assignments)?;
+        let candidates = self
+            .specialists
+            .values()
+            .filter_map(|context| {
+                let grants = observed.get(&context.id)?;
+                if !context.idle || !grants.delegation_disabled {
+                    return None;
+                }
+                let mut context = context.clone();
+                context.available_capabilities = grants.capabilities.clone();
+                context.supports_role_rebinding = grants.supports_role_rebinding;
+                Some(context)
+            })
+            .collect::<Vec<_>>();
+        let (id, is_new, grants) =
+            match select_specialist(&assignment, &self.assignments, &candidates)? {
+                SpecialistSelection::Reuse { specialist_id, .. } => {
+                    let grants = observed
+                        .get(&specialist_id)
+                        .expect("selected observed specialist");
+                    (specialist_id, false, grants)
+                }
+                SpecialistSelection::CreateNew => (Uuid::now_v7().to_string(), true, new_grants),
+            };
+        check_grants(assignment.role, grants)?;
+        if is_new {
+            self.specialists.insert(
+                id.clone(),
+                SpecialistContext {
+                    id: id.clone(),
+                    idle: false,
+                    last_role: None,
+                    last_assignment_id: None,
+                    last_metadata: AssignmentMetadata::default(),
+                    last_status: None,
+                    prior_assignment_ids: BTreeSet::new(),
+                    supports_role_rebinding: grants.supports_role_rebinding,
+                    available_capabilities: grants.capabilities.clone(),
+                },
+            );
+        } else {
+            let context = self
+                .specialists
+                .get_mut(&id)
+                .expect("selected persisted specialist");
+            context.idle = false;
+            context.available_capabilities = grants.capabilities.clone();
+            context.supports_role_rebinding = grants.supports_role_rebinding;
+            // last_* remains the previous terminal Assignment, not current work.
+        }
+        assignment.status = AssignmentStatus::Running;
+        assignment.specialist_id = Some(id);
+        self.launching.insert(assignment.id.clone());
+        self.assignments.push(assignment.clone());
+        Ok((assignment, is_new))
+    }
+
+    fn bind(
+        &mut self,
+        assignment_id: &str,
+        reserved: &str,
+        actual: &str,
+    ) -> Result<(), ControllerError> {
+        let assignment = self
+            .assignments
+            .iter_mut()
+            .find(|a| a.id == assignment_id)
+            .ok_or_else(|| ControllerError::UnknownAssignment(assignment_id.into()))?;
+        if assignment.specialist_id.as_deref() == Some(actual) {
+            return Ok(());
+        }
+        if assignment.specialist_id.as_deref() != Some(reserved)
+            || self.specialists.contains_key(actual)
+        {
+            return Err(ControllerError::InvalidState(
+                "spawn binding changed unexpectedly".into(),
+            ));
+        }
+        assignment.specialist_id = Some(actual.into());
+        let mut context = self
+            .specialists
+            .remove(reserved)
+            .ok_or_else(|| ControllerError::MissingSpecialist(assignment_id.into()))?;
+        context.id = actual.into();
+        self.specialists.insert(actual.into(), context);
+        Ok(())
+    }
+
+    fn rollback_unstarted(
+        &mut self,
+        assignment_id: &str,
+        specialist_id: &str,
+        is_new: bool,
+    ) -> Result<(), ControllerError> {
+        if !self.launching.remove(assignment_id) {
+            return Err(ControllerError::InvalidState(
+                "cannot roll back an assignment after launch reconciliation began".into(),
+            ));
+        }
+        self.assignments
+            .retain(|assignment| assignment.id != assignment_id);
+        if is_new {
+            self.specialists.remove(specialist_id);
+        } else if let Some(specialist) = self.specialists.get_mut(specialist_id) {
+            specialist.idle = true;
+        } else {
+            return Err(ControllerError::MissingSpecialist(assignment_id.into()));
+        }
+        Ok(())
+    }
+
+    fn record_launch_error(
+        &mut self,
+        assignment_id: &str,
+        error: String,
+    ) -> Result<(), ControllerError> {
+        if self.assignment(assignment_id)?.status != AssignmentStatus::Running {
+            return Err(ControllerError::InvalidState(
+                "execution error has no running Assignment".into(),
+            ));
+        }
+        self.execution_errors.insert(assignment_id.into(), error);
+        Ok(())
+    }
+
+    fn observe_reused_turn_running(&mut self, assignment_id: &str) -> Result<(), ControllerError> {
+        if self.ambiguous_reused_launches.contains(assignment_id) {
+            if self.assignment(assignment_id)?.status != AssignmentStatus::Running {
+                return Err(ControllerError::InvalidState(format!(
+                    "ambiguous reused launch {assignment_id} is no longer running"
+                )));
+            }
+            self.ambiguous_reused_launches.remove(assignment_id);
+        }
+        Ok(())
+    }
+
+    fn observe_terminal(
+        &mut self,
+        id: &str,
+        status: AssignmentStatus,
+        result: String,
+        lost: bool,
+    ) -> Result<Assignment, ControllerError> {
+        let current = self
+            .assignments
+            .iter_mut()
+            .find(|a| a.id == id)
+            .ok_or_else(|| ControllerError::UnknownAssignment(id.into()))?;
+        if current.status.is_terminal() {
+            return Ok(current.clone());
+        }
+        current.status = status;
+        current.result = Some(result);
+        let finished = current.clone();
+        let context = self
+            .specialists
+            .get_mut(
+                finished
+                    .specialist_id
+                    .as_deref()
+                    .ok_or_else(|| ControllerError::MissingSpecialist(id.into()))?,
+            )
+            .ok_or_else(|| ControllerError::MissingSpecialist(id.into()))?;
+        context.idle = true;
+        context.last_role = Some(finished.role);
+        context.last_assignment_id = Some(id.into());
+        context.last_metadata = finished.metadata.clone();
+        context.last_status = Some(status);
+        context.prior_assignment_ids.insert(id.into());
+        if lost {
+            context.available_capabilities.clear();
+            context.supports_role_rebinding = false;
+        }
+        self.launching.remove(id);
+        self.cancellation_requested.remove(id);
+        self.finish_reports.remove(id);
+        self.execution_errors.remove(id);
+        self.ambiguous_reused_launches.remove(id);
+        Ok(finished)
+    }
+}
+
+/// Root-owned controller; construct one shared handle for a root session.
+pub struct AssignmentController {
+    store: StateStore,
+    control: LocalAgentControl,
+    root_thread: ThreadId,
+    profile: Profile,
+    authority: Arc<dyn SpecialistAuthority>,
+    poll_interval: Duration,
+}
+
+#[derive(Debug, Error)]
+pub enum ControllerError {
+    #[error(transparent)]
+    Policy(#[from] LifecycleError),
+    #[error("assignment state mutex is poisoned")]
+    Poisoned,
+    #[error("Assignment {0} was not found")]
+    UnknownAssignment(String),
+    #[error("Assignment {0} has no specialist")]
+    MissingSpecialist(String),
+    #[error("thread {thread} does not own Assignment {assignment}")]
+    WrongSpecialist { assignment: String, thread: String },
+    #[error("finish result must be non-empty")]
+    EmptyResult,
+    #[error("finish report was already accepted with different content")]
+    ConflictingFinish,
+    #[error("invalid persisted execution state: {0}")]
+    InvalidState(String),
+    #[error("runtime specialist authority is insufficient: {0}")]
+    Authority(String),
+    #[error("assignment state I/O failed: {0}")]
+    Io(#[from] std::io::Error),
+    #[error("assignment state encoding failed: {0}")]
+    Json(#[from] serde_json::Error),
+    #[error("assignment state TOML decoding failed: {0}")]
+    TomlDecode(#[from] toml::de::Error),
+    #[error("assignment state TOML encoding failed: {0}")]
+    TomlEncode(#[from] toml::ser::Error),
+    #[error("native identity state encoding failed: {0}")]
+    StateEncoding(String),
+    #[error("local Codex agent operation failed: {0}")]
+    Agent(String),
+}
+
+enum LaunchError {
+    BeforeCreation(ControllerError),
+    Acknowledgement(ControllerError),
+}
+
+fn known_precreation_spawn_rejection(error: &CodexErr) -> bool {
+    matches!(error.details(), CodexErrorDetails::AgentLimitReached { .. })
+}
+
+impl AssignmentController {
+    /// Initialize from a new user task or resume validated state under its persistence directory.
+    pub(crate) fn open(
+        persistence_dir: impl AsRef<Path>,
+        control: LocalAgentControl,
+        root_thread: ThreadId,
+        profile: Profile,
+        initial_intent: Intent,
+        authority: Arc<dyn SpecialistAuthority>,
+    ) -> Result<Self, ControllerError> {
+        Ok(Self {
+            store: StateStore::open(persistence_dir.as_ref(), initial_intent)?,
+            control,
+            root_thread,
+            profile,
+            authority,
+            poll_interval: Duration::from_millis(200),
+        })
+    }
+
+    /// Reload the authoritative snapshot for automatic Root context projection.
+    pub fn snapshot(&self) -> Result<ControllerState, ControllerError> {
+        self.store.read()
+    }
+
+    /// Commit a material Intent change; revision overflow and invalid facts are policy errors.
+    pub fn update_intent(
+        &self,
+        objective: String,
+        accepted_scope: Vec<String>,
+        requirements: Vec<String>,
+    ) -> Result<bool, ControllerError> {
+        let changed = self.store.transaction(|state| {
+            Ok(update_intent(
+                &mut state.intent,
+                objective,
+                accepted_scope,
+                requirements,
+            )?)
+        })?;
+        let thread_directory = self.store.path.parent().ok_or_else(|| {
+            ControllerError::InvalidState("controller state path has no parent".into())
+        })?;
+        update_existing_identity_in_directory(thread_directory, self.root_thread, |intent, _| {
+            // The controller state is canonical. Read it after acquiring the
+            // identity lock so concurrent updates cannot persist stale copies.
+            *intent = self.store.read()?.intent;
+            Ok(())
+        })?;
+        Ok(changed)
+    }
+
+    /// Observe live grants, then atomically select and reserve current ownership.
+    pub async fn dispatch(&self, request: DispatchRequest) -> Result<Assignment, ControllerError> {
+        check_route_mutability(request.role, request.mutability)?;
+        let mut initial = self.snapshot()?;
+        let mut candidate = Assignment {
+            id: Uuid::now_v7().to_string(),
+            intent_id: initial.intent.id.clone(),
+            role: request.role,
+            objective: request.objective,
+            bounded_scope: request.bounded_scope,
+            constraints: request.constraints,
+            acceptance_criteria: request.acceptance_criteria,
+            required_evidence: request.required_evidence,
+            mutability: request.mutability,
+            metadata: request.metadata,
+            status: AssignmentStatus::Ready,
+            specialist_id: None,
+            result: None,
+        };
+        loop {
+            candidate.intent_id = initial.intent.id.clone();
+            if let Err(error) =
+                validate_dispatch_for_intent(&initial.intent, &candidate, &initial.assignments)
+            {
+                let refreshed = self.snapshot()?;
+                if refreshed.intent == initial.intent
+                    && refreshed.assignments == initial.assignments
+                {
+                    return Err(error.into());
+                }
+                initial = refreshed;
+                continue;
+            }
+            break;
+        }
+        let prepared = self.authority.prepare(&candidate, self.profile).await?;
+        check_prepared(&prepared, candidate.role, self.profile)?;
+        let _operation = self.store.operation_lock(&candidate.id)?;
+        let mut observed = BTreeMap::new();
+        let mut inspected = BTreeMap::new();
+        let (assignment, is_new) = loop {
+            let snapshot = self.snapshot()?;
+            for context in snapshot.specialists.values().filter(|context| context.idle) {
+                if inspected.get(&context.id) == Some(&context.last_assignment_id) {
+                    continue;
+                }
+                inspected.insert(context.id.clone(), context.last_assignment_id.clone());
+                observed.remove(&context.id);
+                let Ok(thread) = parse_thread_id(&context.id) else {
+                    continue;
+                };
+                if self
+                    .control
+                    .ensure_child_loaded(self.root_thread, thread)
+                    .await
+                    .is_err()
+                {
+                    continue;
+                }
+                if !runtime_idle(&self.control.get_status(thread).await) {
+                    continue;
+                }
+                if let Ok(grants) = self.authority.inspect(thread).await {
+                    observed.insert(context.id.clone(), grants);
+                }
+            }
+            // Concurrent completion can add an idle candidate. Observe and retry
+            // internally; selection and reservation still use the current locked state.
+            let reservation = self.store.transaction(|state| {
+                if state
+                    .specialists
+                    .values()
+                    .any(|s| s.idle && inspected.get(&s.id) != Some(&s.last_assignment_id))
+                {
+                    return Ok(None);
+                }
+                Ok(Some(state.reserve(
+                    candidate.clone(),
+                    &prepared.grants,
+                    &observed,
+                )?))
+            })?;
+            if let Some(reservation) = reservation {
+                break reservation;
+            }
+        };
+        let reserved = assignment
+            .specialist_id
+            .as_deref()
+            .expect("reserved identity");
+        let input = match render_assignment(&assignment) {
+            Ok(input) => input,
+            Err(error) => {
+                self.store.transaction(|state| {
+                    state.rollback_unstarted(&assignment.id, reserved, is_new)
+                })?;
+                return Err(error);
+            }
+        };
+        let execution = if is_new {
+            self.spawn(reserved, assignment.role, prepared.config, input)
+                .await
+        } else {
+            self.reuse(&assignment, input).await
+        };
+        match execution {
+            Ok(thread) => {
+                self.store.transaction(|state| {
+                    if is_new {
+                        state.bind(&assignment.id, reserved, &thread.to_string())?;
+                    }
+                    state.launching.remove(&assignment.id);
+                    Ok(())
+                })?;
+                self.assignment(&assignment.id)
+            }
+            Err(error) => {
+                Err(self.resolve_launch_error(&assignment.id, reserved, is_new, error)?)
+            }
+        }
+    }
+
+    async fn spawn(
+        &self,
+        reserved: &str,
+        role: RoleTask,
+        config: Config,
+        input: String,
+    ) -> Result<ThreadId, LaunchError> {
+        let source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: self.root_thread,
+            depth: 1,
+            agent_path: Some(specialist_path(reserved).map_err(LaunchError::BeforeCreation)?),
+            agent_nickname: None,
+            agent_role: Some(role.as_str().into()),
+        });
+        let (agent, _) = self
+            .control
+            .spawn(SpawnRequest {
+                caller: self.root_thread,
+                config,
+                source,
+                input: text_input(input),
+                options: SpawnAgentOptions {
+                    parent_thread_id: Some(self.root_thread),
+                    ..Default::default()
+                },
+            })
+            .await
+            .map_err(|error| {
+                let known_precreation = known_precreation_spawn_rejection(&error);
+                let error = agent_error(error);
+                if known_precreation {
+                    LaunchError::BeforeCreation(error)
+                } else {
+                    LaunchError::Acknowledgement(error)
+                }
+            })?;
+        Ok(agent.thread_id)
+    }
+
+    fn rollback_unstarted(
+        &self,
+        assignment_id: &str,
+        specialist_id: &str,
+        is_new: bool,
+    ) -> Result<(), ControllerError> {
+        self.store
+            .transaction(|state| state.rollback_unstarted(assignment_id, specialist_id, is_new))
+    }
+
+    fn resolve_launch_error(
+        &self,
+        assignment_id: &str,
+        reserved: &str,
+        is_new: bool,
+        error: LaunchError,
+    ) -> Result<ControllerError, ControllerError> {
+        match error {
+            LaunchError::BeforeCreation(error) => {
+                self.rollback_unstarted(assignment_id, reserved, is_new)?;
+                Ok(error)
+            }
+            LaunchError::Acknowledgement(error) => {
+                // A spawn/send acknowledgement error is ambiguous: the runtime
+                // may already own the reserved specialist. Keep it discoverable
+                // by reconciliation, wait, and cancel.
+                self.store.transaction(|state| {
+                    state.record_launch_error(assignment_id, error.to_string())?;
+                    if !is_new {
+                        state.ambiguous_reused_launches.insert(assignment_id.into());
+                    }
+                    if !is_new
+                        || state.assignment(assignment_id)?.specialist_id.as_deref()
+                            != Some(reserved)
+                    {
+                        state.launching.remove(assignment_id);
+                    }
+                    Ok(())
+                })?;
+                Ok(error)
+            }
+        }
+    }
+
+    async fn reuse(&self, assignment: &Assignment, input: String) -> Result<ThreadId, LaunchError> {
+        let thread = parse_thread_id(assignment.specialist_id.as_deref().expect("reserved"))
+            .map_err(LaunchError::BeforeCreation)?;
+        self.control
+            .ensure_child_loaded(self.root_thread, thread)
+            .await
+            .map_err(agent_error)
+            .map_err(LaunchError::BeforeCreation)?;
+        if !runtime_idle(&self.control.get_status(thread).await) {
+            return Err(LaunchError::BeforeCreation(ControllerError::Agent(
+                "reserved specialist is still executing".into(),
+            )));
+        }
+        let prepared = self
+            .authority
+            .rebind(thread, assignment, self.profile)
+            .await
+            .map_err(LaunchError::BeforeCreation)?;
+        check_prepared(&prepared, assignment.role, self.profile)
+            .map_err(LaunchError::BeforeCreation)?;
+        self.store
+            .transaction(|state| {
+                let context = state
+                    .specialists
+                    .get_mut(&thread.to_string())
+                    .ok_or_else(|| ControllerError::MissingSpecialist(assignment.id.clone()))?;
+                context.available_capabilities = prepared.grants.capabilities.clone();
+                context.supports_role_rebinding = prepared.grants.supports_role_rebinding;
+                Ok(())
+            })
+            .map_err(LaunchError::BeforeCreation)?;
+        self.control
+            .send(SendRequest {
+                caller: self.root_thread,
+                target: AgentTarget::Id(thread),
+                resume_config: prepared.config,
+                input: text_input(input),
+                start_options: TurnStartOptions::default(),
+            })
+            .await
+            .map_err(agent_error)
+            .map_err(LaunchError::Acknowledgement)?;
+        Ok(thread)
+    }
+
+    /// Restore a recorded child before observation; only observed termination releases ownership.
+    pub async fn wait(&self, id: &str) -> Result<Assignment, ControllerError> {
+        loop {
+            let snapshot = self.snapshot()?;
+            let assignment = snapshot.assignment(id)?.clone();
+            if assignment.status.is_terminal() {
+                return Ok(assignment);
+            }
+            if snapshot.launching.contains(id) {
+                if self.store.operation_active(id)? {
+                    tokio::time::sleep(self.poll_interval).await;
+                    continue;
+                }
+                self.reconcile_runtime().await?;
+                if !self.snapshot()?.launching.contains(id) {
+                    continue;
+                }
+                return Err(ControllerError::InvalidState(format!(
+                    "Assignment {id} has no committed runtime identity; it remains reserved until V2 execution can be observed"
+                )));
+            }
+            let thread = parse_thread_id(
+                assignment
+                    .specialist_id
+                    .as_deref()
+                    .ok_or_else(|| ControllerError::MissingSpecialist(id.into()))?,
+            )?;
+            if let Err(error) = self
+                .control
+                .ensure_child_loaded(self.root_thread, thread)
+                .await
+            {
+                return Err(agent_error(error));
+            }
+            let status = self.control.get_status(thread).await;
+            if status == AgentStatus::NotFound {
+                return Err(ControllerError::Agent(format!(
+                    "specialist {thread} has no observable V2 status; Assignment {id} remains reserved"
+                )));
+            }
+            let completed = self.store.transaction(|state| {
+                if state.assignment(id)?.status.is_terminal() {
+                    return Ok(Some(state.assignment(id)?.clone()));
+                }
+                if status == AgentStatus::Running {
+                    state.observe_reused_turn_running(id)?;
+                }
+                let Some((terminal, result)) = terminal_result(state, id, status) else {
+                    return Ok(None);
+                };
+                Ok(Some(state.observe_terminal(id, terminal, result, false)?))
+            })?;
+            if let Some(completed) = completed {
+                return Ok(completed);
+            }
+            tokio::time::sleep(self.poll_interval).await;
+        }
+    }
+
+    /// Reconcile persisted running Assignments against observable V2 child turns.
+    /// Missing parents, unloaded children, and unbound launches remain reserved;
+    /// only a terminal status observed after successful child restoration releases them.
+    pub async fn reconcile_runtime(&self) -> Result<Vec<Assignment>, ControllerError> {
+        let snapshot = self.snapshot()?;
+        let resident_agents = if snapshot.assignments.iter().any(|assignment| {
+            assignment.status == AssignmentStatus::Running
+                && snapshot.launching.contains(&assignment.id)
+        }) {
+            self.control
+                .list_agents(&SessionSource::default(), None)
+                .await
+                .ok()
+        } else {
+            None
+        };
+        let mut completed = Vec::new();
+        for assignment in snapshot
+            .assignments
+            .iter()
+            .filter(|assignment| assignment.status == AssignmentStatus::Running)
+        {
+            let Some(specialist_id) = assignment.specialist_id.as_deref() else {
+                continue;
+            };
+            let is_launching = snapshot.launching.contains(&assignment.id);
+            let (thread, status) = if is_launching {
+                if self.store.operation_active(&assignment.id)? {
+                    continue;
+                }
+                let Ok(expected_path) = specialist_path(specialist_id) else {
+                    continue;
+                };
+                let Some(agent) = resident_agents.as_ref().and_then(|agents| {
+                    agents
+                        .iter()
+                        .find(|agent| agent.metadata.agent_path.as_ref() == Some(&expected_path))
+                }) else {
+                    continue;
+                };
+                (agent.thread_id, agent.status.clone())
+            } else {
+                let Ok(thread) = parse_thread_id(specialist_id) else {
+                    continue;
+                };
+                if self
+                    .control
+                    .ensure_child_loaded(self.root_thread, thread)
+                    .await
+                    .is_err()
+                {
+                    continue;
+                }
+                (thread, self.control.get_status(thread).await)
+            };
+            if status == AgentStatus::Running
+                && snapshot.ambiguous_reused_launches.contains(&assignment.id)
+            {
+                self.store
+                    .transaction(|state| state.observe_reused_turn_running(&assignment.id))?;
+            }
+            if terminal_result(&snapshot, &assignment.id, status.clone()).is_none() {
+                if is_launching {
+                    self.store.transaction(|state| {
+                        let current = state.assignment(&assignment.id)?.clone();
+                        if current.status == AssignmentStatus::Running
+                            && state.launching.contains(&assignment.id)
+                        {
+                            state.bind(&assignment.id, specialist_id, &thread.to_string())?;
+                            state.launching.remove(&assignment.id);
+                        }
+                        Ok(())
+                    })?;
+                }
+                continue;
+            }
+            if let Some(assignment) = self.store.transaction(|state| {
+                let current = state.assignment(&assignment.id)?.clone();
+                if current.status.is_terminal() {
+                    return Ok(None);
+                }
+                if is_launching && state.launching.contains(&assignment.id) {
+                    state.bind(&assignment.id, specialist_id, &thread.to_string())?;
+                    state.launching.remove(&assignment.id);
+                }
+                let Some((terminal, result)) = terminal_result(state, &assignment.id, status)
+                else {
+                    return Ok(None);
+                };
+                Ok(Some(state.observe_terminal(
+                    &assignment.id,
+                    terminal,
+                    result,
+                    false,
+                )?))
+            })? {
+                completed.push(assignment);
+            }
+        }
+        Ok(completed)
+    }
+
+    /// A follow-up is a new bounded Assignment selected through the same safe reuse policy.
+    pub async fn followup(
+        &self,
+        prior_id: &str,
+        mut request: DispatchRequest,
+    ) -> Result<Assignment, ControllerError> {
+        validate_followup(&self.assignment(prior_id)?)?;
+        request.metadata.related_assignments.insert(prior_id.into());
+        self.dispatch(request).await
+    }
+
+    /// Persist cancellation intent, interrupt locally, then await observed turn termination.
+    pub async fn cancel(&self, id: &str) -> Result<Assignment, ControllerError> {
+        loop {
+            let state = self.snapshot()?;
+            if state.assignment(id)?.status.is_terminal() {
+                return Ok(state.assignment(id)?.clone());
+            }
+            if !state.launching.contains(id) {
+                break;
+            }
+            if !self.store.operation_active(id)? {
+                self.reconcile_runtime().await?;
+                let state = self.snapshot()?;
+                if state.assignment(id)?.status.is_terminal() {
+                    return Ok(state.assignment(id)?.clone());
+                }
+                if state.launching.contains(id) {
+                    return Err(ControllerError::InvalidState(format!(
+                        "Assignment {id} has no committed runtime identity; it remains reserved until V2 execution can be observed"
+                    )));
+                }
+                // Reconciliation bound the observed child. Continue below so
+                // cancellation is persisted and interrupted against that ID.
+                continue;
+            }
+            tokio::time::sleep(self.poll_interval).await;
+        }
+        let target = self.store.transaction(|state| {
+            let assignment = state.assignment(id)?.clone();
+            if assignment.status.is_terminal() {
+                return Ok(None);
+            }
+            let thread = parse_thread_id(
+                assignment
+                    .specialist_id
+                    .as_deref()
+                    .ok_or_else(|| ControllerError::MissingSpecialist(id.into()))?,
+            )?;
+            state.cancellation_requested.insert(id.into());
+            Ok(Some(thread))
+        })?;
+        if let Some(target) = target {
+            self.control
+                .interrupt(
+                    self.root_thread,
+                    AgentTarget::Id(target),
+                    MultiAgentVersion::V2,
+                )
+                .await
+                .map_err(agent_error)?;
+        }
+        self.wait(id).await
+    }
+
+    /// Accept the assigned specialist's evidence while runtime termination remains pending.
+    ///
+    /// A finish tool runs inside the active turn. Its accepted report does not make
+    /// the specialist idle; wait commits completion after TurnComplete/TurnAborted.
+    pub fn finish(
+        &self,
+        specialist_thread: ThreadId,
+        id: &str,
+        result: String,
+        success: bool,
+    ) -> Result<Assignment, ControllerError> {
+        if result.trim().is_empty() {
+            return Err(ControllerError::EmptyResult);
+        }
+        let report = FinishReport { result, success };
+        self.store.transaction(|state| {
+            let current = state.assignment(id)?.clone();
+            if current.specialist_id.as_deref() != Some(specialist_thread.to_string().as_str()) {
+                // A fresh child can execute before spawn's acknowledgement returns.
+                // Authenticate its full unique path in the local runtime registry.
+                let reserved = current
+                    .specialist_id
+                    .as_deref()
+                    .ok_or_else(|| ControllerError::MissingSpecialist(id.into()))?;
+                let path_matches = self
+                    .control
+                    .get_agent_metadata(specialist_thread)
+                    .and_then(|metadata| metadata.agent_path)
+                    .is_some_and(|path| {
+                        specialist_path(reserved).is_ok_and(|expected| path == expected)
+                    });
+                if !state.launching.contains(id) || !path_matches {
+                    return Err(ControllerError::WrongSpecialist {
+                        assignment: id.into(),
+                        thread: specialist_thread.to_string(),
+                    });
+                }
+                state.bind(id, reserved, &specialist_thread.to_string())?;
+                state.launching.remove(id);
+            }
+            let current = state.assignment(id)?.clone();
+            if current.status != AssignmentStatus::Running {
+                return Err(LifecycleError::NotRunning(id.into()).into());
+            }
+            if state
+                .finish_reports
+                .get(id)
+                .is_some_and(|existing| existing != &report)
+            {
+                return Err(ControllerError::ConflictingFinish);
+            }
+            state.finish_reports.insert(id.into(), report);
+            Ok(current)
+        })
+    }
+
+    fn assignment(&self, id: &str) -> Result<Assignment, ControllerError> {
+        Ok(self.snapshot()?.assignment(id)?.clone())
+    }
+    fn complete(
+        &self,
+        id: &str,
+        status: AssignmentStatus,
+        result: String,
+        lost: bool,
+    ) -> Result<Assignment, ControllerError> {
+        self.store
+            .transaction(|state| state.observe_terminal(id, status, result, lost))
+    }
+}
+
+fn check_grants(role: RoleTask, grants: &SpecialistGrants) -> Result<(), ControllerError> {
+    let route = route_policy(role).ok_or(LifecycleError::RootNotSpecialist)?;
+    if !grants.delegation_disabled
+        || !route
+            .capabilities
+            .iter()
+            .all(|cap| grants.capabilities.contains(cap))
+    {
+        return Err(ControllerError::Authority(format!(
+            "{} requires restricted delegation and verified capabilities",
+            role.as_str()
+        )));
+    }
+    Ok(())
+}
+
+fn check_route_mutability(
+    role: RoleTask,
+    mutability: holycodex_policy::Mutability,
+) -> Result<(), ControllerError> {
+    let route = route_policy(role).ok_or(LifecycleError::RootNotSpecialist)?;
+    if mutability_rank(mutability) > mutability_rank(route.mutability) {
+        return Err(ControllerError::Authority(format!(
+            "{} is limited to {:?} mutability",
+            role.as_str(),
+            route.mutability
+        )));
+    }
+    Ok(())
+}
+fn check_prepared(
+    prepared: &PreparedSpecialist,
+    role: RoleTask,
+    profile: Profile,
+) -> Result<(), ControllerError> {
+    check_grants(role, &prepared.grants)?;
+    let expected = match route_policy(role)
+        .ok_or(LifecycleError::RootNotSpecialist)?
+        .effort(profile)
+    {
+        holycodex_policy::ReasoningEffort::Low => ReasoningEffort::Low,
+        holycodex_policy::ReasoningEffort::Medium => ReasoningEffort::Medium,
+        holycodex_policy::ReasoningEffort::High => ReasoningEffort::High,
+    };
+    if prepared.config.model.as_deref() != Some("gpt-6-luna")
+        || prepared.config.model_reasoning_effort.as_ref() != Some(&expected)
+    {
+        return Err(ControllerError::Authority(
+            "adapter did not apply the registry's Luna allocation".into(),
+        ));
+    }
+    Ok(())
+}
+fn render_assignment(assignment: &Assignment) -> Result<String, ControllerError> {
+    let route = route_policy(assignment.role).ok_or(LifecycleError::RootNotSpecialist)?;
+    let projection = assignment_projection(assignment);
+    let encoded = encode_toon(&projection).map_err(|error| {
+        ControllerError::StateEncoding(format!("Assignment TOON encoding failed: {error}"))
+    })?;
+    Ok(format!("{}\n\n{}", route.assignment_fragment, encoded))
+}
