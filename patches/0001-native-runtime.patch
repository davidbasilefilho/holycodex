+        managed_codex_path: std::path::PathBuf::from("/managed/codex"),
+        managed_codex_version: None,
+        socket_path: std::path::PathBuf::from("/socket"),
+        cli_version: None,
+        app_server_version: None,
+    };
+    let reused = output(codex_app_server_daemon::LifecycleStatus::AlreadyRunning);
+    assert_eq!(
+        daemon_startup::allow_foreground_fallback(Ok(Some(reused.clone()))).unwrap(),
+        Some(reused)
+    );
+    let started = output(codex_app_server_daemon::LifecycleStatus::Started);
+    assert_eq!(
+        daemon_startup::allow_foreground_fallback(Ok(Some(started.clone()))).unwrap(),
+        Some(started)
+    );
+    let unrelated = anyhow::anyhow!("daemon startup failed");
+    assert!(
+        daemon_startup::allow_foreground_fallback(Err(unrelated))
+            .unwrap_err()
+            .to_string()
+            .contains("daemon startup failed")
+    );
+}
 
