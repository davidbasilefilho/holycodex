+fn runtime_idle(status: &AgentStatus) -> bool {
+    matches!(
+        status,
+        AgentStatus::Completed(_) | AgentStatus::Errored(_) | AgentStatus::Interrupted
+    )
+}
+fn terminal_result(
+    state: &ControllerState,
+    id: &str,
+    status: AgentStatus,
+) -> Option<(AssignmentStatus, String)> {
+    // A reused child retains its previous terminal status until a new turn starts.
+    // Only observing this Assignment's Running state, or its correlated finish
+    // report, makes a terminal status safe to use for releasing ownership.
+    if state.ambiguous_reused_launches.contains(id) && !state.finish_reports.contains_key(id) {
+        return None;
+    }
+    let observed = match status {
+        AgentStatus::Completed(message) => {
+            if let Some(report) = state.finish_reports.get(id) {
+                (
+                    if report.success {
+                        AssignmentStatus::Succeeded
+                    } else {
+                        AssignmentStatus::Failed
+                    },
+                    report.result.clone(),
+                )
+            } else {
+                (
+                    AssignmentStatus::Succeeded,
+                    message
+                        .filter(|text| !text.trim().is_empty())
+                        .unwrap_or_else(|| "runtime turn completed".into()),
+                )
+            }
+        }
+        AgentStatus::Interrupted if state.cancellation_requested.contains(id) => (
+            AssignmentStatus::Cancelled,
+            "cancellation observed in runtime TurnAborted".into(),
+        ),
+        AgentStatus::Interrupted => (
+            AssignmentStatus::Failed,
+            "runtime turn was interrupted".into(),
+        ),
+        AgentStatus::Errored(error) => (
+            AssignmentStatus::Failed,
+            if error.trim().is_empty() {
+                "runtime turn errored".into()
+            } else {
+                error
+            },
+        ),
+        AgentStatus::Shutdown => (AssignmentStatus::Failed, "specialist shut down".into()),
+        AgentStatus::PendingInit | AgentStatus::Running | AgentStatus::NotFound => return None,
+    };
+    Some(if let Some(error) = state.execution_errors.get(id) {
+        (
+            AssignmentStatus::Failed,
+            format!("execution acknowledgement failed: {error}"),
+        )
+    } else {
+        observed
+    })
+}
