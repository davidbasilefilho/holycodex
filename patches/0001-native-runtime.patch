@@ -0,0 +1,55 @@
+use super::*;
+use crate::legacy_core::config::ConfigBuilder;
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+
+fn config_with_update_checks(codex_home: &Path) -> Config {
+    let mut config = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("create config runtime")
+        .block_on(
+            ConfigBuilder::default()
+                .codex_home(codex_home.to_path_buf())
+                .build(),
+        )
+        .expect("load config");
+    config.check_for_update_on_startup = true;
+    config
+}
+
+#[test]
+fn holycodex_ignores_upstream_update_cache() {
+    let codex_home = tempdir().expect("temp codex home");
+    let config = config_with_update_checks(codex_home.path());
+    let version_file = version_filepath(&config);
+
+    for last_checked_at in [Utc::now(), Utc::now() - Duration::hours(21)] {
+        let cached = serde_json::to_string(&VersionInfo {
+            latest_version: "999.0.0".to_string(),
+            last_checked_at,
+            dismissed_version: None,
+        })
+        .expect("serialize version info");
+        std::fs::write(&version_file, &cached).expect("write upstream cache");
+
+        // No Tokio runtime is active here, so accidentally scheduling an
+        // upstream refresh for the stale cache also fails this regression test.
+        assert_eq!(get_upgrade_version(&config), None);
+        assert_eq!(get_upgrade_version_for_popup(&config), None);
+        assert_eq!(
+            std::fs::read_to_string(&version_file).expect("read version info"),
+            cached
+        );
+    }
+}
+
+#[test]
+fn holycodex_update_check_does_not_create_a_cache() {
+    let codex_home = tempdir().expect("temp codex home");
+    let config = config_with_update_checks(codex_home.path());
+
+    assert_eq!(get_upgrade_version(&config), None);
+    assert_eq!(get_upgrade_version_for_popup(&config), None);
+    assert!(!version_filepath(&config).exists());
+}
