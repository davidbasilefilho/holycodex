+fn relative_path_is_within(path: &str, root: &str) -> bool {
+    ownership_path_is_within(path, root)
+}
+
+pub(crate) fn ownership_path_is_within(path: &str, root: &str) -> bool {
+    fn normalize(path: &str) -> Option<String> {
+        if path.is_empty()
+            || path.chars().any(|character| {
+                matches!(character, '\0' | ':' | '*' | '?' | '"' | '<' | '>' | '|')
+            })
+        {
+            return None;
+        }
+        let portable = path.replace('\\', "/");
+        if portable.starts_with('/') {
+            return None;
+        }
+        let components = portable.split('/').collect::<Vec<_>>();
+        if components.iter().any(|component| {
+            component.is_empty()
+                || *component == "."
+                || *component == ".."
+                || component.ends_with('.')
+                || component.ends_with(' ')
+                || component.chars().any(char::is_control)
+        }) {
+            return None;
+        }
+        Some(components.join("/"))
+    }
+
+    let Some(path) = normalize(path) else {
+        return false;
+    };
+    if root == "." {
+        return true;
+    }
+    let Some(root) = normalize(root) else {
+        return false;
+    };
+    path == root || path.starts_with(&format!("{root}/"))
+}
+
+fn assignment_writable_roots(
+    config: &Config,
+    assignment: &Assignment,
+    root_writable_roots: &[PathUri],
+) -> Result<Vec<PathUri>, ControllerError> {
+    let mut writable_roots = Vec::new();
+    if assignment.mutability != Mutability::ScopedWrite {
+        return Ok(writable_roots);
+    }
+    let workspace_roots = config
+        .workspace_roots
+        .iter()
+        .map(|root| PathUri::from_abs_path(root))
+        .collect::<Vec<_>>();
+    for path in &assignment.metadata.ownership_paths {
+        let relative = Path::new(path);
+        if relative
+            .components()
+            .any(|component| !matches!(component, Component::Normal(_)))
+            || relative.as_os_str().is_empty()
+        {
+            return Err(ControllerError::Agent(
+                "assignment ownership path must be a normalized relative path".into(),
+            ));
+        }
+        let joined = PathUri::from_abs_path(&config.cwd.join(relative));
+        if let Some(_root) = workspace_roots.iter().find(|root| joined.starts_with(root))
+            && root_writable_roots
+                .iter()
+                .any(|allowed| joined.starts_with(allowed))
+        {
+            // The PermissionProfile below carries the exact assignment path.
+            // Keep only already-authorized roots in the host binding metadata.
+            if !writable_roots.contains(&joined) {
+                writable_roots.push(joined);
+            }
+        } else {
+            return Err(ControllerError::Agent(
+                "assignment ownership path is outside Root's workspace roots".into(),
+            ));
+        }
+    }
+    Ok(writable_roots)
+}
+
+fn effects_for(
+    capabilities: &BTreeSet<Capability>,
+    mutability: Mutability,
+) -> BTreeSet<NativeEffect> {
+    let mut effects = BTreeSet::new();
+    if capabilities.contains(&Capability::RepositoryRead) {
+        effects.insert(NativeEffect::RepositoryRead);
+    }
+    if capabilities.contains(&Capability::Shell) {
+        effects.insert(NativeEffect::Shell);
+    }
+    if capabilities.contains(&Capability::VisualInspection) {
+        effects.insert(NativeEffect::VisualInspection);
+    }
+    if mutability == Mutability::ScopedWrite {
+        effects.insert(NativeEffect::RepositoryWrite);
+    }
+    effects.insert(NativeEffect::AssignmentFinish);
+    effects
+}
+
+pub(crate) fn mutability_rank(value: Mutability) -> u8 {
+    match value {
+        Mutability::ReadOnly => 0,
+        Mutability::ScopedWrite => 1,
+        Mutability::Operational => 2,
+    }
+}
