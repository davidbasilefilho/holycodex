+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use cap_std::ambient_authority;
+use cap_std::fs::Dir;
+#[cfg(windows)]
+use cap_std::fs::MetadataExt as CapMetadataExt;
+use std::collections::BTreeSet;
+use std::io::Read;
+use std::io::Write;
+#[cfg(windows)]
+use std::os::windows::ffi::OsStringExt;
+#[cfg(windows)]
+use std::os::windows::io::AsRawHandle;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+use std::time::SystemTime;
+use tokio_util::sync::CancellationToken;
+
+const MAX_SNAPSHOT_FILES: usize = 200_000;
+const MAX_SNAPSHOT_BYTES: u64 = 4 * 1024 * 1024 * 1024;
+const MAX_SNAPSHOT_DEPTH: usize = 128;
+const MAX_RETAINED_SNAPSHOTS: usize = 8;
+const SNAPSHOT_RETENTION: Duration = Duration::from_secs(7 * 24 * 60 * 60);
+
+pub(super) struct NpmWorkspaceSnapshot {
+    pub(super) root: PathBuf,
+    pub(super) cwd: PathBuf,
+}
+
+pub(super) fn snapshot_npm_workspace(
+    workspace_root: &Path,
+    requested_cwd: &Path,
+    temporary_root: &Path,
+    artifact_root: &Path,
+    cancellation: &CancellationToken,
+) -> Result<NpmWorkspaceSnapshot> {
+    let artifact_relative = artifact_root
+        .strip_prefix(temporary_root)
+        .context("npm artifact root is outside the operational temporary directory")?;
+    ensure!(
+        artifact_relative
+            .components()
+            .all(|component| matches!(component, Component::Normal(_))),
+        "npm artifact root has an unsafe relative path"
+    );
+    ensure!(
+        workspace_root.is_absolute(),
+        "npm workspace root must be absolute"
+    );
+    let requested_relative = requested_cwd
+        .strip_prefix(workspace_root)
+        .context("requested npm cwd escapes the selected workspace")?;
+    ensure!(
+        requested_relative
+            .components()
+            .all(|component| matches!(component, Component::Normal(_) | Component::CurDir)),
+        "requested npm cwd has an unsafe relative path"
+    );
+
+    // Ambient authority is used only to open the two authorized roots. Every
+    // operation beneath them is relative to an open capability directory.
+    let workspace_dir = Dir::open_ambient_dir(workspace_root, ambient_authority())
+        .with_context(|| format!("opening npm workspace {}", workspace_root.display()))?;
+    let requested_relative = if requested_relative.as_os_str().is_empty() {
+        Path::new(".")
+    } else {
+        requested_relative
+    };
+    let canonical_cwd = workspace_dir
+        .canonicalize(requested_relative)
+        .context("requested npm cwd escapes the selected workspace")?;
+    workspace_dir
+        .open_dir(&canonical_cwd)
+        .context("requested npm cwd is not a directory")?;
+    #[cfg(windows)]
+    let workspace_handle_path = workspace_root
+        .canonicalize()
+        .with_context(|| format!("resolving selected workspace {}", workspace_root.display()))?;
+    #[cfg(not(windows))]
+    let workspace_handle_path = workspace_root.to_path_buf();
+
+    let temporary_dir =
+        Dir::open_ambient_dir(temporary_root, ambient_authority()).with_context(|| {
+            format!(
+                "opening operational temporary directory {}",
+                temporary_root.display()
+            )
+        })?;
+    temporary_dir.create_dir_all(artifact_relative)?;
+    let artifact_dir = temporary_dir.open_dir(artifact_relative)?;
+    prune_expired_snapshots(&artifact_dir, artifact_root)?;
+    ensure!(
+        retained_snapshot_count(&artifact_dir)? < MAX_RETAINED_SNAPSHOTS,
+        "npm snapshot retention limit reached for this agent workspace; expired snapshots are pruned after 7 days"
+    );
+
+    let snapshot_name = format!("npm-workspace-{}", uuid::Uuid::new_v4());
+    artifact_dir.create_dir(&snapshot_name)?;
+    let snapshot_dir = artifact_dir.open_dir(&snapshot_name)?;
+    let snapshot_root = artifact_root.join(&snapshot_name);
+    let mut budget = SnapshotBudget::default();
+    let excluded_artifact = artifact_root
+        .strip_prefix(workspace_root)
+        .ok()
+        .map(Path::to_path_buf);
+    let copied = copy_directory(
+        &workspace_dir,
+        &snapshot_dir,
+        &workspace_dir,
+        Path::new(""),
+        &workspace_handle_path,
+        &snapshot_root,
+        excluded_artifact.as_deref(),
+        0,
+        &mut BTreeSet::new(),
+        &mut budget,
+        cancellation,
+    );
+    if let Err(error) = copied {
+        drop(snapshot_dir);
+        if let Err(cleanup_error) = remove_snapshot_tree(
+            &artifact_dir,
+            std::ffi::OsStr::new(&snapshot_name),
+            &snapshot_root,
+        ) {
+            return Err(error).context(format!("snapshot cleanup failed: {cleanup_error:#}"));
+        }
+        return Err(error).context("copying selected workspace for isolated npm build");
+    }
+
+    let snapshot_cwd = snapshot_root.join(canonical_cwd);
+    Ok(NpmWorkspaceSnapshot {
+        root: snapshot_root,
+        cwd: snapshot_cwd,
+    })
+}
+
+#[derive(Default)]
+struct SnapshotBudget {
+    files: usize,
+    bytes: u64,
+}
+
+fn retained_snapshot_count(artifact_dir: &Dir) -> Result<usize> {
+    let mut count = 0;
+    for entry in artifact_dir.entries()? {
+        let entry = entry?;
+        let file_type = entry.file_type()?;
+        if entry
+            .file_name()
+            .to_string_lossy()
+            .starts_with("npm-workspace-")
+            && file_type.is_dir()
+            && !entry_is_symlink(&entry, &file_type)?
+        {
+            count += 1;
+        }
+    }
+    Ok(count)
+}
+
+fn prune_expired_snapshots(artifact_dir: &Dir, artifact_root: &Path) -> Result<()> {
+    let now = SystemTime::now();
+    for entry in artifact_dir.entries()? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let file_type = entry.file_type()?;
+        if !name.to_string_lossy().starts_with("npm-workspace-")
+            || !file_type.is_dir()
+            || entry_is_symlink(&entry, &file_type)?
+        {
+            continue;
+        }
+        if entry
+            .metadata()?
+            .modified()
+            .ok()
+            .map(cap_std::time::SystemTime::into_std)
+            .and_then(|modified| now.duration_since(modified).ok())
+            .is_some_and(|age| age >= SNAPSHOT_RETENTION)
+        {
+            let snapshot_root = artifact_root.join(&name);
+            remove_snapshot_tree(artifact_dir, &name, &snapshot_root)?;
+        }
+    }
+    Ok(())
+}
+
+fn copy_directory(
+    source: &Dir,
+    destination: &Dir,
+    source_root: &Dir,
+    source_relative: &Path,
+    workspace_root: &Path,
+    snapshot_root: &Path,
+    excluded_artifact: Option<&Path>,
+    depth: usize,
+    active_directories: &mut BTreeSet<PathBuf>,
+    budget: &mut SnapshotBudget,
+    cancellation: &CancellationToken,
+) -> Result<()> {
+    ensure!(
+        depth <= MAX_SNAPSHOT_DEPTH,
+        "npm workspace exceeds the maximum snapshot depth"
+    );
+    for entry in source.entries()? {
+        ensure!(
+            !cancellation.is_cancelled(),
+            "npm workspace snapshot was cancelled"
+        );
+        let entry = entry?;
+        let name = entry.file_name();
+        if name == ".git" {
+            continue;
+        }
+        budget.files += 1;
+        ensure!(
+            budget.files <= MAX_SNAPSHOT_FILES,
+            "npm workspace exceeds the maximum snapshot file count"
+        );
+        let file_type = entry.file_type()?;
+        if entry_is_symlink(&entry, &file_type)? {
+            copy_symlink(
+                source,
+                destination,
+                source_root,
+                &source_relative.join(&name),
+                workspace_root,
+                snapshot_root,
+                excluded_artifact,
+                depth,
+                active_directories,
+                budget,
+                cancellation,
+            )?;
+        } else if file_type.is_dir() {
+            let child_relative = source_relative.join(&name);
+            let child_path = source_root.canonicalize(&child_relative)?;
+            if excluded_artifact.is_some_and(|excluded| child_path.starts_with(excluded)) {
+                continue;
+            }
+            ensure!(
+                active_directories.insert(child_path.clone()),
+                "workspace contains a directory cycle"
+            );
+            destination.create_dir(&name)?;
+            let destination_child = destination.open_dir(&name)?;
+            let source_child = entry.open_dir()?;
+            verify_workspace_handle(&source_child, workspace_root)?;
+            copy_directory(
+                &source_child,
+                &destination_child,
+                source_root,
+                &child_relative,
+                workspace_root,
+                snapshot_root,
+                excluded_artifact,
+                depth + 1,
+                active_directories,
+                budget,
+                cancellation,
+            )?;
+            active_directories.remove(&child_path);
+        } else if file_type.is_file() {
+            let input = entry.open()?;
+            verify_workspace_handle(&input, workspace_root)?;
+            copy_file(input, destination, &name, budget, cancellation)?;
+        } else {
+            anyhow::bail!(
+                "workspace contains an unsupported non-regular entry: {}",
+                name.to_string_lossy()
+            );
+        }
+    }
+    Ok(())
+}
+
+fn entry_is_symlink(
+    entry: &cap_std::fs::DirEntry,
+    file_type: &cap_std::fs::FileType,
+) -> Result<bool> {
+    #[cfg(windows)]
+    {
+        const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x0000_0400;
+        Ok(file_type.is_symlink()
+            || entry.metadata()?.file_attributes() & FILE_ATTRIBUTE_REPARSE_POINT != 0)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = entry;
+        Ok(file_type.is_symlink())
+    }
+}
+
+fn remove_snapshot_tree(parent: &Dir, name: &std::ffi::OsStr, tree_root: &Path) -> Result<()> {
+    let tree = parent.open_dir(name)?;
+    verify_workspace_handle(&tree, tree_root)?;
+    for entry in tree.entries()? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let file_type = entry.file_type()?;
+        if entry_is_symlink(&entry, &file_type)? {
+            let is_dir = file_type.is_dir();
+            drop(entry);
+            if is_dir {
+                tree.remove_dir(&name)?;
+            } else {
+                tree.remove_file(&name)?;
+            }
+        } else if file_type.is_dir() {
+            drop(entry);
+            remove_snapshot_tree(&tree, &name, tree_root)?;
+        } else {
+            drop(entry);
+            tree.remove_file(&name)?;
+        }
+    }
+    drop(tree);
+    parent.remove_dir(name)?;
+    Ok(())
+}
+
+fn copy_file(
+    mut input: cap_std::fs::File,
+    destination: &Dir,
+    name: &std::ffi::OsStr,
+    budget: &mut SnapshotBudget,
+    cancellation: &CancellationToken,
+) -> Result<()> {
+    #[cfg(unix)]
+    let source_mode = {
+        use cap_std::fs::MetadataExt;
+        input.metadata()?.mode() & 0o777
+    };
+    let remaining = MAX_SNAPSHOT_BYTES.saturating_sub(budget.bytes);
+    let mut output = destination.create(name)?;
+    let mut copied = 0_u64;
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        ensure!(
+            !cancellation.is_cancelled(),
+            "npm workspace snapshot was cancelled"
+        );
+        let read = input.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        copied = copied.saturating_add(read as u64);
+        ensure!(
+            copied <= remaining,
+            "npm workspace exceeds the maximum snapshot size"
+        );
+        output.write_all(&buffer[..read])?;
+    }
+    budget.bytes += copied;
+    output.flush()?;
+    #[cfg(unix)]
+    {
+        use cap_std::fs::PermissionsExt;
+        output.set_permissions(cap_std::fs::Permissions::from_mode(source_mode))?;
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn copy_symlink(
+    source: &Dir,
+    destination: &Dir,
+    source_root: &Dir,
+    source_relative: &Path,
+    workspace_root: &Path,
+    snapshot_root: &Path,
+    excluded_artifact: Option<&Path>,
+    depth: usize,
+    active_directories: &mut BTreeSet<PathBuf>,
+    budget: &mut SnapshotBudget,
+    cancellation: &CancellationToken,
+) -> Result<()> {
+    let name = source_relative
+        .file_name()
+        .context("symlink entry has no name")?;
+    #[cfg(unix)]
+    {
+        let target = source.read_link_contents(name)?;
+        let target = if target.is_absolute() {
+            let relative_target = target
+                .strip_prefix(workspace_root)
+                .context("workspace symlink points outside the selected workspace")?;
+            let canonical_target = source_root
+                .canonicalize(relative_target)
+                .context("workspace symlink points outside the selected workspace")?;
+            ensure!(
+                !excluded_artifact.is_some_and(|excluded| canonical_target.starts_with(excluded)),
+                "workspace symlink points into the npm artifact directory"
+            );
+            snapshot_root.join(canonical_target)
+        } else {
+            ensure_relative_link_stays_beneath_root(source_relative, &target)?;
+            let canonical_target = source_root
+                .canonicalize(source_relative)
+                .context("workspace symlink points outside the selected workspace")?;
+            ensure!(
+                !excluded_artifact.is_some_and(|excluded| canonical_target.starts_with(excluded)),
+                "workspace symlink points into the npm artifact directory"
+            );
+            target
+        };
+        if target.is_absolute() {
+            destination.symlink_contents(target, name)?;
+        } else {
+            destination.symlink(target, name)?;
+        }
+    }
+    #[cfg(windows)]
+    {
+        let canonical_target = source_root
+            .canonicalize(source_relative)
+            .context("workspace symlink points outside the selected workspace")?;
+        ensure!(
+            !excluded_artifact.is_some_and(|excluded| canonical_target.starts_with(excluded)),
+            "workspace symlink points into the npm artifact directory"
+        );
+        let file_type = source.metadata(name)?.file_type();
+        if file_type.is_dir() {
+            ensure!(
+                active_directories.insert(canonical_target.clone()),
+                "workspace contains a directory cycle"
+            );
+            destination.create_dir(name)?;
+            let source_child = source.open_dir(name)?;
+            let destination_child = destination.open_dir(name)?;
+            verify_workspace_handle(&source_child, workspace_root)?;
+            copy_directory(
+                &source_child,
+                &destination_child,
+                source_root,
+                &canonical_target,
+                workspace_root,
+                snapshot_root,
+                excluded_artifact,
+                depth + 1,
+                active_directories,
+                budget,
+                cancellation,
+            )?;
+            active_directories.remove(&canonical_target);
+        } else if file_type.is_file() {
+            let input = source.open(name)?;
+            verify_workspace_handle(&input, workspace_root)?;
+            copy_file(input, destination, name, budget, cancellation)?;
+        } else {
+            anyhow::bail!("workspace contains an unsupported symlink target");
+        }
+    }
+    #[cfg(not(any(unix, windows)))]
+    {
+        let _ = (
+            source,
+            destination,
+            source_root,
+            source_relative,
+            workspace_root,
+            snapshot_root,
+            excluded_artifact,
+            depth,
+            active_directories,
+            budget,
+            cancellation,
+        );
+        anyhow::bail!("npm snapshot symlinks are unsupported on this platform");
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+fn verify_workspace_handle(handle: &impl AsRawHandle, workspace_root: &Path) -> Result<()> {
+    use windows_sys::Win32::Storage::FileSystem::FILE_NAME_NORMALIZED;
+    use windows_sys::Win32::Storage::FileSystem::GetFinalPathNameByHandleW;
+    use windows_sys::Win32::Storage::FileSystem::VOLUME_NAME_DOS;
+
+    let flags = FILE_NAME_NORMALIZED | VOLUME_NAME_DOS;
+    let raw = handle.as_raw_handle().cast();
+    let required = unsafe { GetFinalPathNameByHandleW(raw, std::ptr::null_mut(), 0, flags) };
+    ensure!(required != 0, "could not resolve copied file handle");
+    let mut buffer = vec![0_u16; required as usize + 1];
+    let written =
+        unsafe { GetFinalPathNameByHandleW(raw, buffer.as_mut_ptr(), buffer.len() as u32, flags) };
+    ensure!(
+        written != 0 && written < buffer.len() as u32,
+        "could not resolve copied file handle"
+    );
+    let actual = PathBuf::from(std::ffi::OsString::from_wide(&buffer[..written as usize]));
+    let root = normalize_windows_path(&workspace_root.to_string_lossy());
+    let actual = normalize_windows_path(&actual.to_string_lossy());
+    ensure!(
+        actual == root || actual.starts_with(&format!("{root}\\")),
+        "workspace entry resolves outside the selected workspace"
+    );
+    Ok(())
+}
+
+#[cfg(windows)]
+fn normalize_windows_path(path: &str) -> String {
+    let path = if let Some(rest) = path.strip_prefix(r"\\?\UNC\") {
+        format!(r"\\{rest}")
+    } else if let Some(rest) = path.strip_prefix(r"\??\") {
+        rest.to_owned()
+    } else if let Some(rest) = path.strip_prefix(r"\\?\") {
+        rest.to_owned()
+    } else {
+        path.to_owned()
+    };
+    path.trim_end_matches(['\\', '/'])
+        .replace('/', r"\")
+        .to_lowercase()
+}
+
+#[cfg(not(windows))]
+fn verify_workspace_handle(_handle: &impl Sized, _workspace_root: &Path) -> Result<()> {
+    Ok(())
+}
+
+#[cfg(unix)]
+fn ensure_relative_link_stays_beneath_root(link: &Path, target: &Path) -> Result<()> {
+    let mut depth = link
+        .parent()
+        .unwrap_or_else(|| Path::new(""))
+        .components()
+        .count();
+    for component in target.components() {
+        match component {
+            Component::Normal(_) | Component::CurDir => depth += 1,
+            Component::ParentDir if depth > 0 => depth -= 1,
+            _ => anyhow::bail!("workspace symlink has an unsafe relative target"),
+        }
+    }
+    Ok(())
+}
