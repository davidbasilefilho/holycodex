+
+/// Immutable effective Root grants captured from the Root's actual tool binding.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct RootPermissionLease {
+    pub permission_profile: codex_protocol::models::PermissionProfile,
+    pub cwd: codex_utils_absolute_path::AbsolutePathBuf,
+    pub workspace_roots: Vec<codex_utils_absolute_path::AbsolutePathBuf>,
+}
+
+#[derive(Clone)]
+pub(crate) struct RootAuthorityGrants {
+    pub max_mutability: Mutability,
+    pub ownership_paths: BTreeSet<String>,
+    pub capabilities: BTreeSet<Capability>,
+    pub allowed_tools: BTreeSet<codex_tools::ToolName>,
+    pub writable_roots: Vec<PathUri>,
+    pub permission_profile: codex_protocol::models::PermissionProfile,
+    pub permission_lease: RootPermissionLease,
+    pub actual_tool_grants: Arc<Mutex<Option<BTreeSet<codex_tools::ToolName>>>>,
+}
+
+impl SessionSpecialistAuthority {
+    pub(crate) fn new(
+        control: LocalAgentControl,
+        root_thread: ThreadId,
+        root_config: Config,
+        root_grants: Arc<Mutex<RootAuthorityGrants>>,
+        codex_home: PathBuf,
+        contracts: BTreeMap<String, NativeThreadContract>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            control,
+            root_thread,
+            root_config,
+            root_grants,
+            controller: OnceLock::new(),
+            codex_home,
+            contracts: std::sync::Mutex::new(contracts),
+        })
+    }
+
+    pub(crate) fn bind_controller(&self, controller: &Arc<AssignmentController>) {
+        let _ = self.controller.set(Arc::downgrade(controller));
+    }
+
+    async fn actual_root_tool_grants(
+        &self,
+    ) -> Result<
+        (
+            crate::session::HolyCodexRootAuthoritySettings,
+            RootAuthorityGrants,
+            BTreeSet<codex_tools::ToolName>,
+        ),
+        ControllerError,
+    > {
+        let root = self
+            .control
+            .holycodex_thread(self.root_thread)
+            .await
+            .map_err(|error| ControllerError::Agent(error.to_string()))?;
+        let snapshot = root
+            .thread_extension_data()
+            .get::<crate::tools::holycodex_tools::ActualHostToolGrantSnapshot>()
+            .ok_or_else(|| {
+                ControllerError::Agent("Root has no finalized live host tool registry".into())
+            })?;
+        let current = self
+            .root_grants
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        if snapshot.caller != self.root_thread
+            || !Arc::ptr_eq(&snapshot.live, &current.actual_tool_grants)
+            || current
+                .actual_tool_grants
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .as_ref()
+                != Some(&snapshot.tools)
+        {
+            return Err(ControllerError::Agent(
+                "Root's live host tool registry snapshot is stale".into(),
+            ));
+        }
+        let settings = root.session.holycodex_root_authority_settings().await;
+        let mut grants = root_authority_grants(
+            &settings,
+            &root.session.tool_policy,
+            Arc::clone(&current.actual_tool_grants),
+        );
+        let current_settings = grants.clone();
+        let actual = snapshot
+            .tools
+            .iter()
+            .map(|tool| tool.clone().with_default_namespace())
+            .collect::<BTreeSet<_>>();
+        grants
+            .allowed_tools
+            .retain(|tool| actual.contains(&tool.clone().with_default_namespace()));
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("exec_command"))
+        {
+            grants.capabilities.retain(|capability| {
+                !matches!(
+                    capability,
+                    Capability::RepositoryRead | Capability::Search | Capability::Shell
+                )
+            });
+        }
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("apply_patch"))
+        {
+            grants.capabilities.remove(&Capability::FilesystemWrite);
+            grants.max_mutability = if grants.capabilities.contains(&Capability::Shell) {
+                Mutability::Operational
+            } else {
+                Mutability::ReadOnly
+            };
+        }
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("view_image"))
+        {
+            grants.capabilities.remove(&Capability::VisualInspection);
+        }
+        let live = self
+            .root_grants
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if live.permission_lease != current_settings.permission_lease
+            || live.permission_profile != current_settings.permission_profile
+            || live.max_mutability != current_settings.max_mutability
+            || live.ownership_paths != current_settings.ownership_paths
+            || live.capabilities != current_settings.capabilities
+            || live.allowed_tools != current_settings.allowed_tools
+            || live.writable_roots != current_settings.writable_roots
+        {
+            return Err(ControllerError::Agent(
+                "Root's live permission or path authority changed while specialist grants were being prepared".into(),
+            ));
+        }
+        Ok((settings, grants, snapshot.tools.clone()))
+    }
+
+    fn make_prepared(
+        &self,
+        assignment: &Assignment,
+        profile: Profile,
+        settings: &crate::session::HolyCodexRootAuthoritySettings,
+        root_grants: &RootAuthorityGrants,
+        actual_root_tools: &BTreeSet<codex_tools::ToolName>,
+    ) -> Result<
+        (
+            PreparedSpecialist,
+            BTreeSet<codex_tools::ToolName>,
+            Vec<PathUri>,
+        ),
+        ControllerError,
+    > {
+        let route = route_policy(assignment.role)
+            .ok_or_else(|| ControllerError::InvalidState("unknown Role.task".into()))?;
+        if mutability_rank(assignment.mutability) > mutability_rank(route.mutability) {
+            return Err(ControllerError::Authority(format!(
+                "{} is limited to {:?} mutability",
+                assignment.role.as_str(),
+                route.mutability
+            )));
+        }
+        let capabilities = route.capabilities.iter().copied().collect::<BTreeSet<_>>();
+        if !capabilities.is_subset(&root_grants.capabilities) {
+            return Err(ControllerError::Agent(
+                "Root's live authority cannot grant the required specialist capabilities".into(),
+            ));
+        }
+        if mutability_rank(assignment.mutability) > mutability_rank(root_grants.max_mutability) {
+            return Err(ControllerError::Agent(
+                "specialist mutation level exceeds Root's live authority".into(),
+            ));
+        }
+        if assignment.mutability == Mutability::ScopedWrite
+            && (assignment.metadata.ownership_paths.is_empty()
+                || !assignment.metadata.ownership_paths.iter().all(|path| {
+                    root_grants
+                        .ownership_paths
+                        .iter()
+                        .any(|root| relative_path_is_within(path, root))
+                }))
+        {
+            return Err(ControllerError::Agent(
+                "specialist write scope exceeds Root's live ownership grant".into(),
+            ));
+        }
+
+        let root_tools = root_grants
+            .allowed_tools
+            .intersection(actual_root_tools)
+            .cloned()
+            .collect::<BTreeSet<_>>();
+        let allowed_tools = allowed_tools_for(&capabilities, &root_tools)?;
+        let mut config = self.root_config.clone();
+        config.cwd = settings.cwd.clone();
+        config.workspace_roots = settings.workspace_roots.clone();
+        config.holycodex.capabilities = settings.capabilities.clone();
+        config
+            .permissions
+            .set_permission_profile(settings.permission_profile.clone())
+            .map_err(|error| ControllerError::Agent(error.to_string()))?;
+        config.model = Some(ModelId::Gpt6Luna.as_str().to_owned());
+        config.model_reasoning_effort = Some(match route.effort(profile) {
+            ReasoningEffort::Low => codex_protocol::openai_models::ReasoningEffort::Low,
+            ReasoningEffort::Medium => codex_protocol::openai_models::ReasoningEffort::Medium,
+            ReasoningEffort::High => codex_protocol::openai_models::ReasoningEffort::High,
+        });
+        // The controller's typed Assignment renderer supplies the role fragment once.
+        let inherited_instructions = self
+            .root_config
+            .developer_instructions
+            .as_deref()
+            .filter(|instructions| !instructions.trim().is_empty());
+        config.developer_instructions = Some(match inherited_instructions {
+            Some(instructions) => format!("{SPECIALIST_INSTRUCTIONS}\n\n{instructions}"),
+            None => SPECIALIST_INSTRUCTIONS.to_owned(),
+        });
+        let scoped_write_paths = if assignment.mutability == Mutability::ScopedWrite {
+            normalize_writable_roots(assignment_writable_roots(
+                &config,
+                assignment,
+                &root_grants.writable_roots,
+            )?)
+        } else {
+            Vec::new()
+        };
+        let permission_profile = if assignment.mutability != Mutability::ScopedWrite {
+            crate::tools::holycodex_tools::read_only_profile_with_root_temp_write(
+                &root_grants.permission_profile,
+            )
+            .ok_or_else(|| ControllerError::Agent("Root permissions cannot be restricted".into()))?
+        } else {
+            if scoped_write_paths.is_empty() {
+                return Err(ControllerError::Agent(
+                    "writable specialist scope did not resolve to an authorized workspace root"
+                        .into(),
+                ));
+            }
+            codex_protocol::models::PermissionProfile::workspace_write_with_path_uris(
+                &scoped_write_paths,
+                NetworkSandboxPolicy::Restricted,
+                false,
+                false,
+            )
+        };
+        config
+            .permissions
+            .set_permission_profile(permission_profile.clone())
+            .map_err(|error| ControllerError::Agent(error.to_string()))?;
+        Ok((
+            PreparedSpecialist {
+                config,
+                grants: SpecialistGrants {
+                    capabilities,
+                    supports_role_rebinding: true,
+                    delegation_disabled: true,
+                },
+            },
+            allowed_tools,
+            scoped_write_paths,
+        ))
+    }
+}
+
+/// Bind or restore a top-level native Root using its stable typed thread path.
+/// A new Intent is created only when the first accepted top-level user input is
+/// supplied; subsequent calls reattach the saved Intent and controller unchanged.
+pub(crate) async fn initialize_root_session(
+    session: &Session,
+    first_user_input: Option<&[UserInput]>,
+    reconcile: bool,
+) -> anyhow::Result<bool> {
+    let root_thread = session.thread_id();
+    if session.session_id() != SessionId::from(root_thread) {
+        return Ok(false);
+    }
+    if let Some(binding) = session
+        .services
+        .thread_extension_data
+        .get::<HolyCodexToolBinding>()
+    {
+        if !matches!(binding.principal, HolyCodexPrincipal::Root) || binding.caller != root_thread {
+            anyhow::bail!("native Root thread has a conflicting live authority binding");
+        }
+        if reconcile {
+            binding
+                .controller
+                .reconcile_runtime()
+                .await
+                .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+        }
+        return Ok(true);
+    }
+
+    let config = session.get_config().await;
+    let home = config.codex_home.as_path();
+    let saved =
+        read_identity(home, root_thread).map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let Some((saved_intent, contracts)) = saved else {
+        let Some(objective) = first_user_input.and_then(first_task_text) else {
+            return Ok(false);
+        };
+        let initial_intent = Intent {
+            id: uuid::Uuid::now_v7().to_string(),
+            objective,
+            accepted_scope: Vec::new(),
+            requirements: Vec::new(),
+            revision: 0,
+        };
+        return bind_root(
+            session,
+            config.as_ref(),
+            initial_intent,
+            BTreeMap::new(),
+            reconcile,
+        )
+        .await
+        .map(|()| true);
+    };
+
+    let root_contract = contracts.get(&root_thread.to_string()).ok_or_else(|| {
+        anyhow::anyhow!("saved native Root identity is missing its Root thread contract")
+    })?;
+    validate_contract(root_contract).map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    if root_contract.role != RoleTask::Root
+        || root_contract.thread_id != root_thread.to_string()
+        || root_contract.root_thread_id != root_thread.to_string()
+    {
+        anyhow::bail!("saved native Root contract does not match the live Root thread");
+    }
+    bind_root(session, config.as_ref(), saved_intent, contracts, reconcile).await?;
+    Ok(true)
+}
+
+/// Bind a newly spawned or resumed specialist from its actual parent Root's
+/// controller state and the child's runtime Role.task metadata.
+pub(crate) async fn bind_specialist_session(
+    session: &Session,
+    source: &codex_protocol::protocol::SessionSource,
+) -> anyhow::Result<()> {
+    let codex_protocol::protocol::SessionSource::SubAgent(
+        codex_protocol::protocol::SubAgentSource::ThreadSpawn {
+            parent_thread_id,
+            depth: 1,
+            agent_path: Some(agent_path),
+            agent_role: Some(role_name),
+            ..
+        },
+    ) = source
+    else {
+        anyhow::bail!("native specialist is missing its direct Root spawn identity");
+    };
+    let role = RoleTask::parse(role_name)
+        .filter(|role| *role != RoleTask::Root)
+        .ok_or_else(|| anyhow::anyhow!("native specialist has an invalid Role.task"))?;
+    let root_control = session
+        .services
+        .local_agent_runtime
+        .control(SessionId::from(*parent_thread_id));
+    let root = root_control
+        .holycodex_thread(*parent_thread_id)
+        .await
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let root_binding = root
+        .thread_extension_data()
+        .get::<HolyCodexToolBinding>()
+        .ok_or_else(|| anyhow::anyhow!("native specialist Root has no live binding"))?;
+    if !matches!(root_binding.principal, HolyCodexPrincipal::Root)
+        || root_binding.caller != *parent_thread_id
+    {
+        anyhow::bail!("native specialist parent is not its bound Root");
+    }
+    let authority = root
+        .thread_extension_data()
+        .get::<Arc<SessionSpecialistAuthority>>()
+        .ok_or_else(|| anyhow::anyhow!("native Root authority adapter is unavailable"))?;
+    let controller_state = root_binding
+        .controller
+        .snapshot()
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let reserved = crate::holycodex::reserved_specialist_id(agent_path)
+        .ok_or_else(|| anyhow::anyhow!("specialist path is not a controller assignment"))?;
+    let thread_id = session.thread_id();
+    let mut assignment = controller_state
+        .assignments
+        .iter()
+        .find(|assignment| {
+            assignment.role == role
+                && assignment
+                    .specialist_id
+                    .as_deref()
+                    .is_some_and(|id| id == reserved.as_str() || id == thread_id.to_string())
+        })
+        .cloned()
+        .ok_or_else(|| anyhow::anyhow!("Root controller has no matching native Assignment"))?;
+    assignment.specialist_id = Some(thread_id.to_string());
+    let home = session
+        .get_config()
+        .await
+        .codex_home
+        .as_path()
+        .to_path_buf();
+    let (_, contracts) = read_identity(&home, *parent_thread_id)
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?
+        .ok_or_else(|| anyhow::anyhow!("native Root Intent identity is not persisted"))?;
+    let existing = contracts.get(&thread_id.to_string()).cloned();
+    if let Some(contract) = &existing {
+        validate_contract(contract).map_err(|error| anyhow::anyhow!(error.to_string()))?;
+        if contract.root_thread_id != parent_thread_id.to_string()
+            || contract.thread_id != thread_id.to_string()
+            || contract.role != role
+            || !contract
+                .assignment
+                .as_ref()
+                .is_some_and(|saved| same_assignment_contract(&assignment, saved))
+        {
+            anyhow::bail!("resumed specialist differs from its saved native contract");
+        }
+    }
+    let (settings, root_grants, actual_root_tools) = authority.actual_root_tool_grants().await?;
+    let (prepared, allowed_tools, writable_roots) = authority
+        .make_prepared(
+            &assignment,
+            settings.profile,
+            &settings,
+            &root_grants,
+            &actual_root_tools,
+        )
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let child_config = session.get_config().await;
+    if child_config.model.as_deref() != Some(ModelId::Gpt6Luna.as_str())
+        || child_config.model_reasoning_effort.as_ref()
+            != prepared.config.model_reasoning_effort.as_ref()
+        || child_config.permissions.effective_permission_profile()
+            != prepared.config.permissions.effective_permission_profile()
+        || child_config.cwd != prepared.config.cwd
+        || child_config.workspace_roots != prepared.config.workspace_roots
+    {
+        anyhow::bail!("specialist startup configuration does not match live Root grants");
+    }
+    let required_capabilities = route_policy(role)
+        .expect("validated Role.task has canonical route")
+        .capabilities
+        .iter()
+        .copied()
+        .collect::<BTreeSet<_>>();
+    if prepared.grants.capabilities != required_capabilities {
+        anyhow::bail!("specialist effective grants differ from its canonical route");
+    }
+    let binding = HolyCodexToolBinding {
+        controller: Arc::clone(&root_binding.controller),
+        caller: thread_id,
+        principal: HolyCodexPrincipal::Specialist {
+            assignment_id: assignment.id.clone(),
+        },
+        max_mutability: assignment.mutability,
+        ownership_paths: assignment.metadata.ownership_paths.clone(),
+        capabilities: prepared.grants.capabilities.clone(),
+        allowed_tools: allowed_tools.clone(),
+        writable_roots,
+        permission_profile: prepared.config.permissions.effective_permission_profile(),
+        root_permission_lease: root_grants.permission_lease.clone(),
+        actual_tool_grants: Arc::new(Mutex::new(None)),
+        root_authority: Arc::clone(&root_binding.root_authority),
+    };
+    let route = route_policy(role).expect("validated Role.task has canonical route");
+    let instruction_sha1 = assignment_instruction_sha1(&assignment);
+    let contract = NativeThreadContract {
+        schema: IDENTITY_SCHEMA,
+        native_id: existing
+            .as_ref()
+            .map(|contract| contract.native_id.clone())
+            .unwrap_or_else(|| uuid::Uuid::now_v7().to_string()),
+        root_thread_id: parent_thread_id.to_string(),
+        thread_id: thread_id.to_string(),
+        role,
+        assignment: Some(assignment.clone()),
+        model: ModelId::Gpt6Luna,
+        effort: route.effort(authority.root_config.holycodex.profile),
+        profile: authority.root_config.holycodex.profile,
+        instruction_sha1,
+        grants: prepared.grants.capabilities.clone(),
+        authority: NativeAuthorityContract {
+            max_mutability: binding.max_mutability,
+            ownership_paths: binding.ownership_paths.clone(),
+            allowed_tools: allowed_tools.iter().map(|tool| tool.name.clone()).collect(),
+            delegation_disabled: true,
+            max_agent_depth: 1,
+        },
+        effects: effects_for(&prepared.grants.capabilities, binding.max_mutability),
+    };
+    validate_contract(&contract).map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    update_identity(&home, *parent_thread_id, |_intent, contracts| {
+        contracts.insert(thread_id.to_string(), contract.clone());
+        Ok(())
+    })
+    .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let (_, contracts) = read_identity(&home, *parent_thread_id)
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?
+        .ok_or_else(|| anyhow::anyhow!("native Root Intent identity is not persisted"))?;
+    *authority
+        .contracts
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = contracts;
+    session.services.thread_extension_data.insert(contract);
+    crate::holycodex::bind_holycodex_tools(&session.services.thread_extension_data, binding);
+    Ok(())
+}
+
+async fn bind_root(
+    session: &Session,
+    config: &Config,
+    initial_intent: Intent,
+    mut contracts: BTreeMap<String, NativeThreadContract>,
+    reconcile: bool,
+) -> anyhow::Result<()> {
+    let root_thread = session.thread_id();
+    let control = session
+        .services
+        .local_agent_runtime
+        .control(session.session_id());
+    let config = config.clone();
+    let actual_tool_grants = Arc::new(Mutex::new(None));
+    let settings = root_authority_settings_from_config(&config);
+    let root_grants = root_authority_grants(
+        &settings,
+        &session.tool_policy,
+        Arc::clone(&actual_tool_grants),
+    );
+    let root_authority = Arc::new(Mutex::new(root_grants.clone()));
+    let prior_native_id = contracts
+        .get(&root_thread.to_string())
+        .map(|contract| contract.native_id.clone());
+    let authority = SessionSpecialistAuthority::new(
+        control.clone(),
+        root_thread,
+        config.clone(),
+        Arc::clone(&root_authority),
+        config.codex_home.as_path().to_path_buf(),
+        contracts
+            .iter()
+            .filter(|(thread_id, _)| *thread_id != &root_thread.to_string())
+            .map(|(thread_id, contract)| (thread_id.clone(), contract.clone()))
+            .collect(),
+    );
+    let path = identity_path(config.codex_home.as_path(), root_thread);
+    let directory = path
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("native identity path has no directory"))?;
+    let controller = Arc::new(
+        AssignmentController::open(
+            directory,
+            control,
+            root_thread,
+            config.holycodex.profile,
+            initial_intent,
+            authority.clone(),
+        )
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?,
+    );
+    authority.bind_controller(&controller);
+    let snapshot = controller
+        .snapshot()
+        .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let route = route_policy(RoleTask::Root).expect("canonical Root role");
+    let root_contract = NativeThreadContract {
+        schema: IDENTITY_SCHEMA,
+        native_id: prior_native_id.unwrap_or_else(|| uuid::Uuid::now_v7().to_string()),
+        root_thread_id: root_thread.to_string(),
+        thread_id: root_thread.to_string(),
+        role: RoleTask::Root,
+        assignment: None,
+        model: ModelId::Gpt61Sol,
+        effort: route.effort(config.holycodex.profile),
+        profile: config.holycodex.profile,
+        instruction_sha1: instruction_sha1(RoleTask::Root),
+        grants: root_grants.capabilities.clone(),
+        authority: NativeAuthorityContract {
+            max_mutability: root_grants.max_mutability,
+            ownership_paths: root_grants.ownership_paths.clone(),
+            allowed_tools: root_grants
+                .allowed_tools
+                .iter()
+                .map(|tool| tool.name.clone())
+                .collect(),
+            delegation_disabled: true,
+            max_agent_depth: 1,
+        },
+        effects: effects_for(&root_grants.capabilities, root_grants.max_mutability),
+    };
+    validate_contract(&root_contract).map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    contracts.insert(root_thread.to_string(), root_contract.clone());
+    // Mirror the controller's canonical Intent while merging the Root contract
+    // with child binds under the shared per-Root transaction lock.
+    update_identity_or_initialize(
+        config.codex_home.as_path(),
+        root_thread,
+        snapshot.intent.clone(),
+        |intent, contracts| {
+            *intent = snapshot.intent.clone();
+            contracts.insert(root_thread.to_string(), root_contract.clone());
+            Ok(())
+        },
+    )
+    .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let binding = HolyCodexToolBinding {
+        controller,
+        caller: root_thread,
+        principal: HolyCodexPrincipal::Root,
+        max_mutability: root_grants.max_mutability,
+        ownership_paths: root_grants.ownership_paths,
+        capabilities: root_grants.capabilities,
+        allowed_tools: root_grants.allowed_tools,
+        writable_roots: root_grants.writable_roots,
+        root_permission_lease: root_grants.permission_lease.clone(),
+        permission_profile: root_grants.permission_profile,
+        actual_tool_grants: Arc::clone(&root_grants.actual_tool_grants),
+        root_authority,
+    };
+    session.services.thread_extension_data.insert(authority);
+    session.services.thread_extension_data.insert(root_contract);
+    crate::holycodex::bind_holycodex_tools(
+        &session.services.thread_extension_data,
+        binding.clone(),
+    );
+    if reconcile {
+        binding
+            .controller
+            .reconcile_runtime()
+            .await
+            .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    }
+    Ok(())
+}
+
+pub(crate) fn refresh_root_authority_config(
+    thread_store: &codex_extension_api::ExtensionData,
+    config: &Config,
+    tool_policy: &codex_extension_api::ToolPolicy,
+) {
+    let Some(binding) = thread_store.get::<HolyCodexToolBinding>() else {
+        return;
+    };
+    if !matches!(binding.principal, HolyCodexPrincipal::Root) {
+        return;
+    }
+    let settings = root_authority_settings_from_config(config);
+    refresh_root_authority_settings(thread_store, &settings, tool_policy);
+}
+
+fn root_authority_settings_from_config(
+    config: &Config,
+) -> crate::session::HolyCodexRootAuthoritySettings {
+    crate::session::HolyCodexRootAuthoritySettings {
+        permission_profile: config.permissions.effective_permission_profile(),
+        cwd: config.cwd.clone(),
+        workspace_roots: config.workspace_roots.clone(),
+        profile: config.holycodex.profile,
+        capabilities: config.holycodex.capabilities.clone(),
+    }
+}
+
+fn root_authority_grants(
+    settings: &crate::session::HolyCodexRootAuthoritySettings,
+    tool_policy: &codex_extension_api::ToolPolicy,
+    actual_tool_grants: Arc<Mutex<Option<BTreeSet<codex_tools::ToolName>>>>,
+) -> RootAuthorityGrants {
+    let permission_profile = settings.permission_profile.clone();
+    let file_system = permission_profile.file_system_sandbox_policy();
+    let cwd = settings.cwd.as_path();
+    let exec = codex_tools::ToolName::plain("exec_command");
+    let apply_patch = codex_tools::ToolName::plain("apply_patch");
+    let view_image = codex_tools::ToolName::plain("view_image");
+    let writable_path_roots = permission_profile
+        .file_system_sandbox_policy()
+        .get_writable_roots_with_cwd_preserving_mutable_paths(cwd)
+        .into_iter()
+        .map(|root| root.root)
+        .collect::<Vec<_>>();
+    let writable_roots = writable_path_roots
+        .iter()
+        .map(PathUri::from_abs_path)
+        .collect::<Vec<_>>();
+    let mut allowed_tools = BTreeSet::new();
+    let mut capabilities = BTreeSet::new();
+    if tool_policy.allows(&exec) && file_system.can_read_local_path_with_cwd(cwd, cwd) {
+        allowed_tools.insert(exec);
+        capabilities.extend([
+            Capability::RepositoryRead,
+            Capability::Search,
+            Capability::Shell,
+        ]);
+    }
+    if tool_policy.allows(&view_image) {
+        allowed_tools.insert(view_image.clone());
+        capabilities.insert(Capability::VisualInspection);
+    }
+    let mut ownership_paths = BTreeSet::new();
+    if !writable_path_roots.is_empty() {
+        for workspace_root in &settings.workspace_roots {
+            let root = writable_path_roots.iter().find_map(|root| {
+                if root.as_path().starts_with(workspace_root.as_path()) {
+                    Some(root.as_path())
+                } else if workspace_root.as_path().starts_with(root.as_path()) {
+                    Some(workspace_root.as_path())
+                } else {
+                    None
+                }
+            });
+            if let Some(root) = root {
+                if let Ok(relative) = root.strip_prefix(cwd) {
+                    let relative = relative.to_string_lossy().replace('\\', "/");
+                    ownership_paths.insert(if relative.is_empty() {
+                        ".".to_owned()
+                    } else {
+                        relative
+                    });
+                }
+            }
+        }
+    }
+    let can_write = !writable_roots.is_empty()
+        && !ownership_paths.is_empty()
+        && tool_policy.allows(&apply_patch);
+    if can_write {
+        allowed_tools.insert(apply_patch);
+        capabilities.insert(Capability::FilesystemWrite);
+    }
+    RootAuthorityGrants {
+        max_mutability: if capabilities.contains(&Capability::Shell) {
+            Mutability::Operational
+        } else if can_write {
+            Mutability::ScopedWrite
+        } else {
+            Mutability::ReadOnly
+        },
+        ownership_paths,
+        capabilities,
+        allowed_tools,
+        writable_roots: normalize_writable_roots(writable_roots),
+        permission_profile,
+        permission_lease: RootPermissionLease {
+            permission_profile: settings.permission_profile.clone(),
+            cwd: settings.cwd.clone(),
+            workspace_roots: settings.workspace_roots.clone(),
+        },
+        actual_tool_grants,
+    }
+}
+
+pub(crate) fn refresh_root_authority_settings(
+    thread_store: &codex_extension_api::ExtensionData,
+    settings: &crate::session::HolyCodexRootAuthoritySettings,
+    tool_policy: &codex_extension_api::ToolPolicy,
+) {
+    let Some(binding) = thread_store.get::<HolyCodexToolBinding>() else {
+        return;
+    };
+    if !matches!(binding.principal, HolyCodexPrincipal::Root) {
+        return;
+    }
+    let mut grants = root_authority_grants(
+        settings,
+        tool_policy,
+        Arc::clone(&binding.actual_tool_grants),
+    );
+    let actual = binding
+        .actual_tool_grants
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    if let Some(actual) = actual {
+        let actual = actual
+            .iter()
+            .map(|tool| tool.clone().with_default_namespace())
+            .collect::<BTreeSet<_>>();
+        grants
+            .allowed_tools
+            .retain(|tool| actual.contains(&tool.clone().with_default_namespace()));
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("exec_command"))
+        {
+            grants.capabilities.retain(|capability| {
+                !matches!(
+                    capability,
+                    Capability::RepositoryRead | Capability::Search | Capability::Shell
+                )
+            });
+        }
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("apply_patch"))
+        {
+            grants.capabilities.remove(&Capability::FilesystemWrite);
+            grants.max_mutability = max_mutability_for_filtered_tools(&grants);
+        }
+        if !grants
+            .allowed_tools
+            .contains(&codex_tools::ToolName::plain("view_image"))
+        {
+            grants.capabilities.remove(&Capability::VisualInspection);
+        }
+    } else {
+        grants.max_mutability = Mutability::ReadOnly;
+        grants.capabilities.clear();
+        grants.allowed_tools.clear();
+    }
+    *binding
+        .root_authority
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = grants;
+}
+
+fn max_mutability_for_filtered_tools(grants: &RootAuthorityGrants) -> Mutability {
+    if grants.capabilities.contains(&Capability::Shell) {
+        Mutability::Operational
+    } else {
+        Mutability::ReadOnly
+    }
+}
+
+fn first_task_text(input: &[UserInput]) -> Option<String> {
+    let text = input
+        .iter()
+        .filter_map(|item| match item {
+            UserInput::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    (!text.trim().is_empty()).then_some(text)
+}
+
+impl SpecialistAuthority for SessionSpecialistAuthority {
+    fn prepare<'a>(
+        &'a self,
+        assignment: &'a Assignment,
+        profile: Profile,
+    ) -> futures::future::BoxFuture<'a, Result<PreparedSpecialist, ControllerError>> {
+        Box::pin(async move {
+            let (settings, root_grants, actual_root_tools) = self.actual_root_tool_grants().await?;
+            let (prepared, _, _) = self.make_prepared(
+                assignment,
+                profile,
+                &settings,
+                &root_grants,
+                &actual_root_tools,
+            )?;
+            Ok(prepared)
+        })
+    }
+
+    fn inspect(
+        &self,
+        thread: ThreadId,
+    ) -> futures::future::BoxFuture<'_, Result<SpecialistGrants, ControllerError>> {
+        Box::pin(async move {
+            let thread_id = thread;
+            let thread = self
+                .control
+                .holycodex_thread(thread_id)
+                .await
+                .map_err(|error| ControllerError::Agent(error.to_string()))?;
+            let binding = thread
+                .thread_extension_data()
+                .get::<HolyCodexToolBinding>()
+                .ok_or_else(|| {
+                    ControllerError::Agent("specialist has no live HolyCodex tool binding".into())
+                })?;
+            let contract = thread
+                .thread_extension_data()
+                .get::<NativeThreadContract>()
+                .ok_or_else(|| {
+                    ControllerError::Agent(
+                        "specialist has no live native Role.task contract".into(),
+                    )
+                })?;
+            let (_root_settings, root_grants, _root_tools) = self.actual_root_tool_grants().await?;
+            let snapshot = thread.config_snapshot().await;
+            let is_specialist = matches!(binding.principal, HolyCodexPrincipal::Specialist { .. });
+            let role_binding_matches = match (&binding.principal, &contract.assignment) {
+                (HolyCodexPrincipal::Specialist { assignment_id }, Some(assignment)) => {
+                    if assignment.id != *assignment_id || assignment.role != contract.role {
+                        false
+                    } else {
+                        binding
+                            .controller
+                            .snapshot()
+                            .ok()
+                            .and_then(|state| {
+                                state
+                                    .assignments
+                                    .into_iter()
+                                    .find(|current| current.id == *assignment_id)
+                            })
+                            .is_some_and(|current| same_assignment_contract(&current, assignment))
+                    }
+                }
+                _ => false,
+            };
+            let effort_matches = snapshot.reasoning_effort.as_ref().is_some_and(|effort| {
+                matches!(
+                    (effort, contract.effort),
+                    (
+                        codex_protocol::openai_models::ReasoningEffort::Low,
+                        ReasoningEffort::Low
+                    ) | (
+                        codex_protocol::openai_models::ReasoningEffort::Medium,
+                        ReasoningEffort::Medium
+                    ) | (
+                        codex_protocol::openai_models::ReasoningEffort::High,
+                        ReasoningEffort::High
+                    )
+                )
+            });
+            if snapshot.model != ModelId::Gpt6Luna.as_str()
+                || !is_specialist
+                || binding.caller != thread_id
+                || contract.thread_id != thread_id.to_string()
+                || contract.role == RoleTask::Root
+                || contract.model != ModelId::Gpt6Luna
+                || contract.grants != binding.capabilities
+                || !binding.capabilities.is_subset(&root_grants.capabilities)
+                || mutability_rank(binding.max_mutability)
+                    > mutability_rank(root_grants.max_mutability)
+                || !binding.allowed_tools.is_subset(&root_grants.allowed_tools)
+                || !binding.ownership_paths.iter().all(|path| {
+                    root_grants
+                        .ownership_paths
+                        .iter()
+                        .any(|root| relative_path_is_within(path, root))
+                })
+                || !binding.writable_roots.iter().all(|path| {
+                    root_grants
+                        .writable_roots
+                        .iter()
+                        .any(|root| path.starts_with(root))
+                })
+                || !Arc::ptr_eq(&binding.root_authority, &self.root_grants)
+                || !role_binding_matches
+                || !effort_matches
+                || !binding
+                    .allowed_tools
+                    .iter()
+                    .all(|tool| !tool.name.starts_with("spawn_") && tool.name != "send_input")
+                || !binding.permission_profile.eq(&snapshot.permission_profile)
+                || binding.root_permission_lease != root_grants.permission_lease
+            {
+                return Err(ControllerError::Agent(
+                    "live specialist identity or effective grants no longer match its authority binding".into(),
+                ));
+            }
+            Ok(SpecialistGrants {
+                capabilities: binding.capabilities.clone(),
+                supports_role_rebinding: true,
+                delegation_disabled: true,
+            })
+        })
+    }
+
+    fn rebind<'a>(
+        &'a self,
+        thread: ThreadId,
+        assignment: &'a Assignment,
+        profile: Profile,
+    ) -> futures::future::BoxFuture<'a, Result<PreparedSpecialist, ControllerError>> {
+        Box::pin(async move {
+            let (settings, root_grants, actual_root_tools) = self.actual_root_tool_grants().await?;
+            let (prepared, allowed_tools, writable_roots) = self.make_prepared(
+                assignment,
+                profile,
+                &settings,
+                &root_grants,
+                &actual_root_tools,
+            )?;
+            let controller = self
+                .controller
+                .get()
+                .and_then(Weak::upgrade)
+                .ok_or_else(|| ControllerError::Agent("Root controller is not bound".into()))?;
+            let intent = controller.snapshot()?.intent;
+            let binding = HolyCodexToolBinding {
+                controller,
+                caller: thread,
+                principal: HolyCodexPrincipal::Specialist {
+                    assignment_id: assignment.id.clone(),
+                },
+                max_mutability: assignment.mutability,
+                ownership_paths: assignment.metadata.ownership_paths.clone(),
+                capabilities: prepared.grants.capabilities.clone(),
+                allowed_tools: allowed_tools.clone(),
+                writable_roots: writable_roots.clone(),
+                permission_profile: prepared.config.permissions.permission_profile().clone(),
+                root_permission_lease: root_grants.permission_lease.clone(),
+                actual_tool_grants: Arc::new(Mutex::new(None)),
+                root_authority: Arc::clone(&self.root_grants),
+            };
+            let mut bound_assignment = assignment.clone();
+            bound_assignment.specialist_id = Some(thread.to_string());
+            let contracts = self
+                .contracts
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clone();
+            let native_id = contracts
+                .get(&thread.to_string())
+                .map(|contract| contract.native_id.clone())
+                .unwrap_or_else(|| uuid::Uuid::now_v7().to_string());
+            let contract = NativeThreadContract {
+                schema: IDENTITY_SCHEMA,
+                native_id,
+                root_thread_id: self.root_thread.to_string(),
+                thread_id: thread.to_string(),
+                role: assignment.role,
+                assignment: Some(bound_assignment.clone()),
+                model: ModelId::Gpt6Luna,
+                effort: route_policy(assignment.role)
+                    .ok_or_else(|| ControllerError::InvalidState("unknown Role.task".into()))?
+                    .effort(profile),
+                profile,
+                instruction_sha1: assignment_instruction_sha1(&bound_assignment),
+                grants: prepared.grants.capabilities.clone(),
+                authority: NativeAuthorityContract {
+                    max_mutability: assignment.mutability,
+                    ownership_paths: assignment.metadata.ownership_paths.clone(),
+                    allowed_tools: allowed_tools.iter().map(|tool| tool.name.clone()).collect(),
+                    delegation_disabled: true,
+                    max_agent_depth: 1,
+                },
+                effects: effects_for(&prepared.grants.capabilities, assignment.mutability),
+            };
+            validate_contract(&contract)?;
+            let mut next_contracts = contracts;
+            next_contracts.insert(thread.to_string(), contract.clone());
+            self.control
+                .reallocate_specialist(ReallocateSpecialistRequest {
+                    caller_root: self.root_thread,
+                    target: thread,
+                    assignment: bound_assignment,
+                    config: prepared.config.clone(),
+                    binding,
+                    contract: contract.clone(),
+                    codex_home: self.codex_home.clone(),
+                    intent,
+                })
+                .await
+                .map_err(|error| ControllerError::Agent(error.to_string()))?;
+            *self
+                .contracts
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner) = next_contracts;
+            Ok(prepared)
+        })
+    }
+}
