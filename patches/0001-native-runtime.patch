+const DISCOVERY: &str = "https://auth.openai.com/.well-known/openid-configuration";
+const TIMEOUT: Duration = Duration::from_secs(10);
+const LEGACY_REVOKE_TIMEOUT: Duration = Duration::from_secs(10);
+#[derive(Deserialize)]
+struct Discovery {
+    issuer: String,
+    authorization_endpoint: String,
+    token_endpoint: String,
+    jwks_uri: String,
+    revocation_endpoint: String,
+}
+impl Discovery {
+    fn validated_revocation_endpoint(&self) -> io::Result<url::Url> {
+        if self.issuer != siwc::ISSUER
+            || self.authorization_endpoint != siwc::AUTHORIZE_ENDPOINT
+            || self.token_endpoint != siwc::TOKEN_ENDPOINT
+            || self.jwks_uri != siwc::JWKS_ENDPOINT
+        {
+            return Err(io::Error::other("Invalid OpenAI SIWC discovery metadata"));
+        }
+        let url = url::Url::parse(&self.revocation_endpoint).map_err(io::Error::other)?;
+        if url.scheme() != "https"
+            || url.host_str() != Some("auth.openai.com")
+            || url.port_or_known_default() != Some(443)
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.query().is_some()
+            || url.fragment().is_some()
+            || url.path() == "/"
+        {
+            return Err(io::Error::other("Untrusted SIWC revocation endpoint"));
+        }
+        Ok(url)
+    }
+}
+fn revoke_form(token: &str, hint: &str, client: &siwc::IssuedClientId) -> String {
+    url::form_urlencoded::Serializer::new(String::new())
+        .append_pair("token", token)
+        .append_pair("token_type_hint", hint)
+        .append_pair("client_id", client.as_str())
+        .finish()
+}
+pub(super) async fn revoke_auth_tokens(
+    auth: Option<&AuthDotJson>,
+    route: &AuthRouteConfig,
+) -> io::Result<()> {
+    let Some(auth) = auth else {
+        return Ok(());
+    };
+    if auth.auth_mode.is_some_and(|mode| mode != AuthMode::Chatgpt) || auth.openai_api_key.is_some()
+    {
+        return Ok(());
+    }
+    let Some(tokens) = auth.tokens.as_ref() else {
+        return Ok(());
+    };
+    let Some(registration) = tokens.siwc.as_ref() else {
+        let Some((token, kind)) = legacy_revocable_token(auth) else {
+            return Ok(());
+        };
+        let endpoint = legacy_revoke_token_endpoint();
+        let client = create_default_auth_client(&endpoint, route)?;
+        return revoke_legacy_oauth_token(
+            &client,
+            endpoint.as_str(),
+            token,
+            kind,
+            LEGACY_REVOKE_TIMEOUT,
+        )
+        .await;
+    };
+    let (token, hint) = if !tokens.refresh_token.is_empty() {
+        (&tokens.refresh_token, "refresh_token")
+    } else if !tokens.access_token.is_empty() {
+        (&tokens.access_token, "access_token")
+    } else {
+        return Ok(());
+    };
+    let client = create_default_auth_client(DISCOVERY, route)?;
+    let response = client
+        .get(DISCOVERY)
+        .timeout(TIMEOUT)
+        .send()
+        .await
+        .map_err(io::Error::other)?;
+    if !response.status().is_success() {
+        return Err(io::Error::other(
+            "OpenAI discovery unavailable; remote revocation unconfirmed",
+        ));
+    }
+    let discovery: Discovery =
+        serde_json::from_str(&response.text().await.map_err(io::Error::other)?)?;
+    let endpoint = discovery.validated_revocation_endpoint()?;
+    let client = create_default_auth_client(endpoint.as_str(), route)?;
+    let body = revoke_form(token, hint, registration.client_id());
+    for attempt in 0..3 {
+        let response = client
+            .post(endpoint.as_str())
+            .timeout(TIMEOUT)
+            .header("Content-Type", "application/x-www-form-urlencoded")
+            .body(body.clone())
+            .send()
+            .await;
+        match response {
+            Ok(response) if response.status().is_success() => return Ok(()),
+            Ok(response) if !response.status().is_server_error() => break,
+            _ => {}
+        }
+        if attempt < 2 {
+            tokio::time::sleep(Duration::from_millis(100 * (1 << attempt))).await;
+        }
+    }
+    Err(io::Error::other(
+        "Remote SIWC revocation unconfirmed; local logout still proceeds",
+    ))
+}
 
