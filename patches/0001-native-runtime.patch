+fn is_safe_read_only_shell(command: &str) -> bool {
+    let commands = parse_shell_script(command);
+    !commands.is_empty()
+        && commands.iter().all(|command| {
+            matches!(
+                command,
+                ParsedCommand::Read { .. }
+                    | ParsedCommand::ListFiles { .. }
+                    | ParsedCommand::Search { .. }
+            )
+        })
+}
+
+fn is_safe_specialist_shell(command: &str) -> bool {
+    if is_read_only_vcs_inspection_command(command) {
+        return true;
+    }
+    if contains_forbidden_shell_capability(command) {
+        return false;
+    }
+    let parsed = parse_shell_script(command);
+    !parsed.is_empty()
+        && parsed.iter().all(|parsed_command| {
+            matches!(
+                parsed_command,
+                ParsedCommand::Read { .. }
+                    | ParsedCommand::ListFiles { .. }
+                    | ParsedCommand::Search { .. }
+            ) || matches!(parsed_command, ParsedCommand::Unknown { .. })
+        })
+        && (!parsed
+            .iter()
+            .any(|parsed_command| matches!(parsed_command, ParsedCommand::Unknown { .. }))
+            || (parsed.len() == 1
+                && is_shell_quality_command(command)
+                && quality_command_is_non_mutating(command)))
+}
+
+fn is_shell_quality_command(command: &str) -> bool {
+    if command.chars().any(|character| {
+        matches!(
+            character,
+            ';' | '|' | '&' | '>' | '<' | '`' | '$' | '%' | '!' | '\n' | '\r'
+        )
+    }) {
+        return false;
+    }
+    shlex::split(command).is_some_and(|words| is_shell_quality_words(&words))
+}
+
+fn quality_command_is_non_mutating(command: &str) -> bool {
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    if words
+        .iter()
+        .any(|word| matches!(word.as_str(), "--fix" | "--write" | "--apply"))
+    {
+        return false;
+    }
+    if matches!(
+        words.first().map(String::as_str),
+        Some("cargo" | "cargo.exe")
+    ) && words.get(1).is_some_and(|word| word == "fmt")
+    {
+        return words.iter().any(|word| word == "--check");
+    }
+    true
+}
+
+fn is_shell_quality_words(words: &[String]) -> bool {
+    if cargo_quality_command(words).is_some() {
+        return true;
+    }
+    let Some(executable) = words.first() else {
+        return false;
+    };
+    let Some(operation) = words.get(1).map(String::as_str) else {
+        return false;
+    };
+    (match executable.as_str() {
+        "npm" | "npm.cmd" | "npm.exe" => {
+            matches!(operation, "test")
+                || (operation == "run"
+                    && words
+                        .get(2)
+                        .is_some_and(|script| matches!(script.as_str(), "test" | "build")))
+        }
+        _ => false,
+    }) || matches!(executable.as_str(), "mise" | "mise.exe")
+        && operation == "run"
+        && words.len() == 3
+        && words
+            .get(2)
+            .is_some_and(|task| matches!(task.as_str(), "test" | "lint" | "fmt-check"))
+        || matches!(executable.as_str(), "just" | "just.exe")
+            && words.len() == 2
+            && matches!(operation, "test" | "nextest")
+}
+
+/// Return the Cargo operation and first argument positions for supported, pinned invocations.
+fn cargo_quality_command(words: &[String]) -> Option<(usize, usize)> {
+    let operation_index = match words.first()?.as_str() {
+        "cargo" | "cargo.exe" => {
+            if let Some(selector) = words.get(1).filter(|word| word.starts_with('+')) {
+                is_pinned_toolchain(&selector[1..]).then_some(2)?
+            } else {
+                1
+            }
+        }
+        "rustup" | "rustup.exe"
+            if words.get(1).is_some_and(|word| word == "run")
+                && words.get(2).is_some_and(|word| is_pinned_toolchain(word))
+                && words
+                    .get(3)
+                    .is_some_and(|word| matches!(word.as_str(), "cargo" | "cargo.exe")) =>
+        {
+            4
+        }
+        _ => return None,
+    };
+    let operation = words.get(operation_index)?.as_str();
+    let is_quality_operation = match operation {
+        "test" | "build" | "clippy" | "check" => true,
+        "fmt" => words[operation_index + 1..]
+            .iter()
+            .any(|word| word == "--check"),
+        _ => false,
+    };
+    is_quality_operation.then_some((operation_index, operation_index + 1))
+}
+
+fn is_pinned_toolchain(version: &str) -> bool {
+    let mut components = version.split('.');
+    components.next().is_some_and(|component| {
+        !component.is_empty() && component.bytes().all(|b| b.is_ascii_digit())
+    }) && components.next().is_some_and(|component| {
+        !component.is_empty() && component.bytes().all(|b| b.is_ascii_digit())
+    }) && components.next().is_some_and(|component| {
+        !component.is_empty() && component.bytes().all(|b| b.is_ascii_digit())
+    }) && components.next().is_none()
+}
+
+pub(crate) fn shell_quality_command(command: &str) -> bool {
+    is_shell_quality_command(command)
+}
+
+pub(crate) fn shell_quality_command_requires_artifacts(command: &str) -> bool {
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    if let Some((operation_index, _)) = cargo_quality_command(&words) {
+        return words[operation_index] != "fmt";
+    }
+    match (
+        words.first().map(String::as_str),
+        words.get(1).map(String::as_str),
+    ) {
+        (Some("npm" | "npm.cmd" | "npm.exe"), Some("test")) => true,
+        (Some("npm" | "npm.cmd" | "npm.exe"), Some("run")) => words
+            .get(2)
+            .is_some_and(|task| matches!(task.as_str(), "test" | "build")),
+        (Some("mise" | "mise.exe"), Some("run")) => words
+            .get(2)
+            .is_some_and(|task| matches!(task.as_str(), "test" | "lint")),
+        (Some("just" | "just.exe"), Some("test" | "nextest")) => true,
+        _ => false,
+    }
+}
+
+pub(crate) fn shell_npm_workspace_command(command: &str) -> bool {
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    match (
+        words.first().map(String::as_str),
+        words.get(1).map(String::as_str),
+    ) {
+        (Some("npm" | "npm.cmd" | "npm.exe"), Some("test")) => true,
+        (Some("npm" | "npm.cmd" | "npm.exe"), Some("run")) => words
+            .get(2)
+            .is_some_and(|task| matches!(task.as_str(), "test" | "build")),
+        _ => false,
+    }
+}
+
+fn npm_workspace_command_uses_only_relative_paths(command: &str) -> bool {
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    const PATH_OPTIONS: &[&str] = &[
+        "--prefix",
+        "--workspace",
+        "-w",
+        "-C",
+        "--cache",
+        "--userconfig",
+        "--globalconfig",
+        "--coverageDirectory",
+        "--coverage-dir",
+        "--outputDir",
+        "--output-dir",
+    ];
+    let is_relative = |value: &str, reject_parent: bool| {
+        !value.starts_with('~')
+            && !Path::new(value).is_absolute()
+            && !matches!(value.as_bytes(), [drive, b':', ..] if drive.is_ascii_alphabetic())
+            && !value.starts_with('\\')
+            && !value.starts_with('/')
+            && (!reject_parent
+                || !Path::new(&value.replace('\\', "/"))
+                    .components()
+                    .any(|component| component == Component::ParentDir))
+    };
+    let mut index = 1;
+    while index < words.len() {
+        let word = &words[index];
+        let (option, inline_value) = word
+            .split_once('=')
+            .map_or((word.as_str(), None), |(option, value)| {
+                (option, Some(value))
+            });
+        if PATH_OPTIONS.contains(&option) {
+            let value = if let Some(value) = inline_value {
+                value
+            } else {
+                index += 1;
+                let Some(value) = words.get(index) else {
+                    return false;
+                };
+                value
+            };
+            if !is_relative(value, true) {
+                return false;
+            }
+        } else {
+            // npm and forwarded test-runner options also accept inline absolute paths.
+            // Reject path traversal in path-like values so a relative output such as
+            // --coverageDirectory=../../victim cannot leave the isolated workspace.
+            let value = inline_value.unwrap_or(word);
+            if !is_relative(value, looks_like_path(value)) {
+                return false;
+            }
+        }
+        index += 1;
+    }
+    true
+}
+
+fn contains_forbidden_shell_capability(command: &str) -> bool {
+    command
+        .to_ascii_lowercase()
+        .split(|ch: char| !ch.is_ascii_alphanumeric() && ch != '_' && ch != '-')
+        .any(|token| {
+            matches!(
+                token,
+                "git"
+                    | "gh"
+                    | "curl"
+                    | "wget"
+                    | "ssh"
+                    | "scp"
+                    | "sudo"
+                    | "aws"
+                    | "az"
+                    | "gcloud"
+                    | "kubectl"
+                    | "terraform"
+                    | "docker"
+            )
+        })
+}
+
+fn is_read_only_vcs_inspection_command(command: &str) -> bool {
+    if command.chars().any(|character| {
+        matches!(
+            character,
+            ';' | '|' | '&' | '>' | '<' | '`' | '$' | '%' | '!' | '\n' | '\r'
+        )
+    }) {
+        return false;
+    }
+    let Some(words) = shlex::split(command) else {
+        return false;
+    };
+    match words.first().map(String::as_str) {
+        Some("git" | "git.exe") => is_read_only_git_inspection(&words),
+        Some("gh" | "gh.exe") => is_read_only_gh_inspection(&words),
+        _ => false,
+    }
+}
+
+fn is_read_only_git_inspection(words: &[String]) -> bool {
+    let Some(operation) = words.get(1).map(String::as_str) else {
+        return false;
+    };
+    match operation {
+        "status" => words.iter().skip(2).all(|word| {
+            matches!(
+                word.as_str(),
+                "--short"
+                    | "-s"
+                    | "--branch"
+                    | "--porcelain"
+                    | "--porcelain=v1"
+                    | "--porcelain=v2"
+                    | "--untracked-files=no"
+                    | "--untracked-files=normal"
+                    | "--untracked-files=all"
+            )
+        }),
+        "rev-parse" => {
+            matches!(
+                words.get(2).map(String::as_str),
+                Some("--show-toplevel" | "--show-prefix" | "--show-cdup" | "--is-inside-work-tree")
+            ) && words.len() == 3
+        }
+        "show" => {
+            let mut revision_seen = false;
+            words.iter().skip(2).all(|word| {
+                if matches!(word.as_str(), "--stat" | "--oneline" | "--no-patch") {
+                    !revision_seen
+                } else if !revision_seen && is_git_revision(word) {
+                    revision_seen = true;
+                    true
+                } else {
+                    false
+                }
+            })
+        }
+        _ => false,
+    }
+}
+
+fn is_git_revision(value: &str) -> bool {
+    value
+        .as_bytes()
+        .first()
+        .is_some_and(u8::is_ascii_alphanumeric)
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.' | b'/' | b'^' | b'~')
+        })
+}
+
+fn is_read_only_gh_inspection(words: &[String]) -> bool {
+    match words.get(1).map(String::as_str) {
+        Some("run") if words.get(2).is_some_and(|word| word == "view") => {
+            let mut run_id_seen = false;
+            let mut index = 3;
+            while index < words.len() {
+                let word = &words[index];
+                if !run_id_seen
+                    && !word.is_empty()
+                    && word.bytes().all(|byte| byte.is_ascii_digit())
+                {
+                    run_id_seen = true;
+                } else if matches!(word.as_str(), "--log" | "--log-failed" | "--exit-status") {
+                } else {
+                    return false;
+                }
+                index += 1;
+            }
+            true
+        }
+        Some("pr") if words.get(2).is_some_and(|word| word == "checks") => {
+            let mut pull_request_seen = false;
+            words.iter().skip(3).all(|word| {
+                if !pull_request_seen
+                    && !word.is_empty()
+                    && word.bytes().all(|byte| byte.is_ascii_digit())
+                {
+                    pull_request_seen = true;
+                    true
+                } else {
+                    matches!(word.as_str(), "--required" | "--fail-fast")
+                }
+            })
+        }
+        _ => false,
+    }
+}
+
+fn assignment_permission_profile_is_bounded(
+    binding: &HolyCodexToolBinding,
+    current: &PermissionProfile,
+) -> bool {
+    if current != &binding.permission_profile {
+        return false;
+    }
+    match binding.max_mutability {
+        Mutability::ReadOnly | Mutability::Operational => read_only_profile_with_root_temp_write(
+            &binding.root_permission_lease.permission_profile,
+        )
+        .is_some_and(|read_only| read_only == *current),
+        Mutability::ScopedWrite => {
+            if binding.writable_roots.is_empty() {
+                return false;
+            }
+            let roots = binding.writable_roots.iter().cloned().collect::<Vec<_>>();
+            let expected = PermissionProfile::workspace_write_with_path_uris(
+                &roots,
+                NetworkSandboxPolicy::Restricted,
+                false,
+                false,
+            );
+            current == &expected
+        }
+    }
+}
