+    assert!(wrapped.contains(&npm_snapshot));
+    assert!(wrapped.ends_with("npm run build"));
+
+    for (shell_type, prefix, npm_cache, build_path) in [
+        (
+            ShellType::PowerShell,
+            "$env:CARGO_TARGET_DIR='",
+            "$env:npm_config_cache='",
+            "$env:BUILD_PATH='",
+        ),
+        (
+            ShellType::Cmd,
+            "set \"CARGO_TARGET_DIR=",
+            "set \"npm_config_cache=",
+            "set \"BUILD_PATH=",
+        ),
+    ] {
+        let mut command = vec!["shell".to_owned(), "cargo clippy".to_owned()];
+        super::exec_command::scope_quality_artifacts(
+            &mut command,
+            shell_type,
+            Some(&temporary_root),
+            Some("specialist-workspace-cache"),
+            None,
+        )
+        .map_err(anyhow::Error::msg)?;
+        assert!(command[1].starts_with(prefix));
+        assert!(command[1].contains(npm_cache));
+        assert!(command[1].contains(build_path));
+        assert!(command[1].ends_with("cargo clippy"));
+    }
+    assert!(
+        super::exec_command::scope_quality_artifacts(
+            &mut command,
+            ShellType::Bash,
+            None,
+            Some("cache"),
+            None
+        )
+        .is_err(),
+        "no unreported temp path may be used as a writable artifact target"
+    );
+
+    let mut root_command = vec!["bash".to_owned(), "-lc".to_owned(), "cargo test".to_owned()];
+    let original = root_command.clone();
+    super::exec_command::scope_quality_artifacts(
+        &mut root_command,
+        ShellType::Bash,
+        None,
+        None,
+        None,
+    )
+    .map_err(anyhow::Error::msg)?;
+    assert_eq!(
+        root_command, original,
+        "Root keeps Cargo's normal artifact behavior"
+    );
+    Ok(())
+}
