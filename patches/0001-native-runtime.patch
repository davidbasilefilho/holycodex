 }
 
+/// Verify that a local app-server socket is owned by the supported Holy runtime.
+pub async fn validate_holy_runtime(socket_path: &Path) -> Result<()> {
+    let info = client::probe(socket_path).await?;
+    ensure_holy_runtime(&info)
+}
+
+/// Verify the runtime identity reported by an already initialized connection.
+pub fn validate_holy_runtime_user_agent(user_agent: &str) -> Result<()> {
+    let expected_suffix = format!(
+        " {} codex_upstream/{}",
+        codex_app_server_protocol::HOLYCODEX_RUNTIME_MARKER,
+        env!("CARGO_PKG_VERSION")
+    );
+    if user_agent.strip_suffix(&expected_suffix).is_none() {
+        return Err(ForeignAppServerRuntime.into());
+    }
+    Ok(())
+}
+
+fn ensure_holy_runtime(info: &client::ProbeInfo) -> Result<()> {
+    if !info.is_holy_runtime || info.app_server_version != env!("CARGO_PKG_VERSION") {
+        return Err(ForeignAppServerRuntime.into());
+    }
+    Ok(())
+}
