diff --git a/codex-rs/ext/skills/src/holy_optional_workflows.rs b/codex-rs/ext/skills/src/holy_optional_workflows.rs
new file mode 100644
index 0000000..6e62a0c
--- /dev/null
+++ b/codex-rs/ext/skills/src/holy_optional_workflows.rs
@@ -0,0 +1,53 @@
+use crate::HolyCodexOptionalWorkflows;
+use crate::catalog::SkillCatalog;
+use crate::catalog::SkillCatalogEntry;
+use crate::catalog::SkillSourceKind;
+use codex_protocol::protocol::SkillScope;
+
+pub(crate) fn retain_available_holy_workflows(
+    catalog: &mut SkillCatalog,
+    workflows: HolyCodexOptionalWorkflows,
+    root_allowed: bool,
+) {
+    catalog.entries.retain(|entry| {
+        let Some(workflow) = canonical_holy_workflow(entry) else {
+            return true;
+        };
+        root_allowed
+            && match workflow {
+                HolyWorkflow::SessionAudit => workflows.session_audit,
+                HolyWorkflow::AutoReset => workflows.auto_reset,
+            }
+    });
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum HolyWorkflow {
+    SessionAudit,
+    AutoReset,
+}
+
+fn canonical_holy_workflow(entry: &SkillCatalogEntry) -> Option<HolyWorkflow> {
+    if entry.authority.kind != SkillSourceKind::Host
+        || entry.prompt_scope() != Some(SkillScope::System)
+        || entry.id.0 != entry.main_prompt.as_str()
+    {
+        return None;
+    }
+
+    let workflow = match entry.name.as_str() {
+        "session-audit" => HolyWorkflow::SessionAudit,
+        "auto-reset" => HolyWorkflow::AutoReset,
+        _ => return None,
+    };
+    let path = entry.main_prompt.as_str().replace('\\', "/");
+    let suffix = match workflow {
+        HolyWorkflow::SessionAudit => "/skills/.system/session-audit/SKILL.md",
+        HolyWorkflow::AutoReset => "/skills/.system/auto-reset/SKILL.md",
+    };
+    path.ends_with(suffix).then_some(workflow)
+}
+
+#[cfg(test)]
+#[path = "holy_optional_workflows_tests.rs"]
+mod tests;
diff --git a/codex-rs/ext/skills/src/holy_optional_workflows_tests.rs b/codex-rs/ext/skills/src/holy_optional_workflows_tests.rs
