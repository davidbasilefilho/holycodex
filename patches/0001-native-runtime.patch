+#[tokio::test]
+async fn holycodex_installer_transport_rejects_before_network_access() {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("loopback listener");
+    listener
+        .set_nonblocking(true)
+        .expect("nonblocking listener");
+    let url = format!(
+        "http://{}/install.sh",
+        listener.local_addr().expect("address")
+    );
+    let http = holycodex_production_installer_http();
+    let error = tokio::time::timeout(
+        std::time::Duration::from_secs(1),
+        InstallerHttp::get(&http, &url),
+    )
+    .await
+    .expect("policy rejection must not wait for HTTP")
+    .expect_err("upstream installer transport must be disabled");
+    assert!(
+        error
+            .to_string()
+            .contains("HolyCodex upstream installer updates are disabled")
+    );
+    assert_eq!(
+        listener
+            .accept()
+            .expect_err("no connection may be made")
+            .kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+    let error = fetch_installer_script(&http)
+        .await
+        .expect_err("the configured upstream installer must also be blocked");
+    assert!(error.to_string().contains("--from-cli"));
+}
