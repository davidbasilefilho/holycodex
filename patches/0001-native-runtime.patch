+    let home = TempDir::new().expect("home");
+    let (daemon, _) = manual_update_daemon(&home);
+    let settings = crate::settings::DaemonSettings::default();
+    let backend = crate::backend::pid_backend(daemon.backend_paths(&settings));
+    let updater = crate::backend::pid_update_loop_backend(daemon.backend_paths(&settings));
+    let selected = super::selected_release(&daemon).expect("selection");
+    let binary = std::fs::read(&daemon.managed_codex_bin).expect("binary");
+    backend.start().await.expect("old managed daemon");
+    updater.start().await.expect("old updater fixture");
+    let result = daemon.ensure_managed_updater(&settings).await;
+    let updater_running = updater.is_starting_or_running().await;
+    let bootstrapped = daemon.is_bootstrapped(&settings).await;
+    // Always clean up test processes before checking results.
+    updater.stop().await.expect("cleanup updater");
+    backend.stop().await.expect("cleanup daemon");
+    assert!(!result.expect("retire updater"));
+    assert!(!updater_running.expect("updater state"));
+    assert!(bootstrapped.expect("daemon remains bootstrapped without an updater"));
+    assert_eq!(
+        super::selected_release(&daemon).expect("selection"),
+        selected
+    );
+    assert_eq!(
+        std::fs::read(&daemon.managed_codex_bin).expect("binary"),
+        binary
+    );
+    assert!(!daemon.settings_file.exists());
+    assert!(
+        !daemon
+            .ensure_managed_updater(&settings)
+            .await
+            .expect("do not respawn")
+    );
+    assert!(!updater.is_starting_or_running().await.expect("no updater"));
