+/// Apply HolyCodex's normal context profile after provider and user configuration resolve.
+///
+/// The catalog maximum remains intact. An explicit smaller context setting remains authoritative;
+/// otherwise models with a known maximum use up to 372K and derive compaction from that window.
+pub fn holy_context(
+    model: &ModelInfo,
+    config: &ModelsManagerConfig,
+) -> Result<holycodex_policy::EffectiveContext, String> {
+    effective_context(&holy_model_metadata(model, config)).map_err(|error| error.to_string())
+}
+
+/// Adapt resolved provider capabilities for the single native policy registry.
+/// Invalid or missing capacities become zero and are rejected by the fallible allocation policy.
+pub fn holy_model_metadata(model: &ModelInfo, config: &ModelsManagerConfig) -> ModelMetadata {
+    let maximum = model
+        .max_context_window
+        .or(model.context_window)
+        .and_then(|capacity| u32::try_from(capacity).ok())
+        .unwrap_or_default();
+    let hard = config
+        .model_context_window
+        .map(|limit| u32::try_from(limit).unwrap_or_default().min(maximum));
+    let normal = holycodex_policy::NORMAL_CONTEXT_TOKENS
+        .min(maximum)
+        .min(hard.unwrap_or(maximum));
+    let margin = if (1..=100).contains(&model.effective_context_window_percent) {
+        normal.saturating_mul((100 - model.effective_context_window_percent) as u32) / 100
+    } else {
+        normal
+    };
+    ModelMetadata {
+        id: model.slug.clone(),
+        context_window_tokens: maximum,
+        maximum_context_tokens: maximum,
+        hard_context_limit_tokens: hard,
+        provider_safety_margin_tokens: (margin > 0).then_some(margin),
+    }
+}
+
+/// Recognize only exact required catalog identifiers; prefixes and provider aliases are not substitutes.
+pub fn holy_model_id(slug: &str) -> Option<ModelId> {
+    [ModelId::Gpt61Sol, ModelId::Gpt6Luna]
+        .into_iter()
+        .find(|model| model.as_str() == slug)
+}
+
+/// Validate resolved metadata before inference; an unknown-model descriptor cannot authorize a request.
+pub fn validate_holycodex_model_info(model: &ModelInfo) -> Result<(), String> {
+    if holy_model_id(&model.slug).is_some() {
+        if model.used_fallback_model_metadata {
+            return Err(format!(
+                "required model {} is absent from the supported catalog",
+                model.slug
+            ));
+        }
+        holy_context(model, &ModelsManagerConfig::default())?;
+    }
+    Ok(())
+}
