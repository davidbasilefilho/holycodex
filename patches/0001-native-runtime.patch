+        let cwd_path = codex_utils_absolute_path::AbsolutePathBuf::try_from(cwd.path()).unwrap();
+        let outside_root =
+            codex_utils_absolute_path::AbsolutePathBuf::try_from(outside.path()).unwrap();
+        let outside_path =
+            codex_utils_absolute_path::AbsolutePathBuf::try_from(outside.path().join("secret.txt"))
+                .unwrap();
+        let root_filesystem =
+            FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: PathUri::from_abs_path(&cwd_path),
+                },
+                FileSystemAccessMode::Read,
+            )]);
+        let current_root_profile = PermissionProfile::from_runtime_permissions(
+            &root_filesystem,
+            NetworkSandboxPolicy::Restricted,
+        );
+        assert!(root_filesystem.can_read_local_path_with_cwd(cwd.path(), cwd.path()));
+        assert!(!root_filesystem.can_read_local_path_with_cwd(outside_path.as_path(), cwd.path(),));
+
+        let broad_read_profile = PermissionProfile::workspace_write_with_path_uris(
+            &[
+                PathUri::from_abs_path(&cwd_path),
+                PathUri::from_abs_path(&outside_root),
+            ],
+            NetworkSandboxPolicy::Enabled,
+            false,
+            false,
+        )
+        .intersect_with_read_only()
+        .unwrap();
+        let (broad_filesystem, _) = broad_read_profile.to_runtime_permissions();
+        assert!(broad_filesystem.can_read_local_path_with_cwd(outside_path.as_path(), cwd.path(),));
+        let make_root_settings =
+            |permission_profile, workspace_roots| crate::session::HolyCodexRootAuthoritySettings {
+                permission_profile,
+                cwd: cwd_path.clone(),
+                workspace_roots,
+                profile: holycodex_policy::Profile::Default,
+                capabilities: holycodex_policy::CapabilityConfig::default(),
+            };
+        let (_root_dir, root_binding) = test_binding(HolyCodexPrincipal::root());
+        let root_store = ExtensionData::new("live-root");
+        bind_holycodex_tools(&root_store, root_binding.clone());
+        let root_authority = Arc::clone(&root_binding.root_authority);
+        crate::holycodex_identity::refresh_root_authority_settings(
+            &root_store,
+            &make_root_settings(
+                broad_read_profile.clone(),
+                vec![cwd_path.clone(), outside_root],
+            ),
+            &codex_extension_api::ToolPolicy::default(),
+        );
+        let old_root_lease = root_authority.lock().unwrap().permission_lease.clone();
+        let mut binding = test_binding(HolyCodexPrincipal::specialist("a-1".into())).1;
+        binding.capabilities = [
+            Capability::RepositoryRead,
+            Capability::Search,
+            Capability::Shell,
+        ]
+        .into();
+        binding.allowed_tools = ["exec_command"].into_iter().map(ToolName::plain).collect();
+        binding.permission_profile =
+            read_only_profile_with_root_temp_write(&broad_read_profile).unwrap();
+        binding.root_permission_lease = old_root_lease;
+        binding.root_authority = root_authority;
+        binding
+            .actual_tool_grants
+            .lock()
+            .unwrap()
+            .as_mut()
+            .unwrap()
+            .insert(ToolName::plain("assignment.finish").with_default_namespace());
+        assert!(
+            binding
+                .actual_tool_grants
+                .lock()
+                .unwrap()
+                .as_ref()
+                .is_some_and(|actual| {
+                    actual.contains(&ToolName::plain("exec_command").with_default_namespace())
+                })
+        );
+        let read_outside = format!(
+            "cat \"{}\"",
+            outside_path.as_path().to_string_lossy().replace('\\', "/")
+        );
+        let search_outside = format!(
+            "rg secret \"{}\"",
+            outside.path().to_string_lossy().replace('\\', "/")
+        );
+        assert!(assignment_permission_profile_is_bounded(
+            &binding,
+            &binding.permission_profile
+        ));
+        assert!(is_safe_specialist_shell(&read_outside));
+        let outside_read_authorization = authorize_tool_call(
+            &binding,
+            &ToolName::plain("exec_command"),
+            false,
+            Some(&read_outside),
+            &binding.permission_profile,
+        );
+        assert!(
+            outside_read_authorization.is_ok(),
