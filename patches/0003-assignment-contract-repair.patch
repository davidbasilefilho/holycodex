+    async fn intent_read_exposes_initial_and_updated_revision_only_to_root() {
+        let (_dir, binding) = test_binding(HolyCodexPrincipal::root());
+        let tool = HolyCodexTool {
+            binding,
+            name: "intent.read",
+        };
+        let before = tool.binding.controller.snapshot().unwrap();
+        let payload = encode_toon(&json!({})).unwrap();
+        let output = tool.execute(payload.clone()).await.unwrap();
+        let read: holycodex_policy::Intent = decode_toon(&output).unwrap();
+        assert_eq!(read, before.intent);
+        assert!(read.revision > 0);
+        assert!(before.assignments.is_empty());
+        assert_eq!(tool.binding.controller.snapshot().unwrap(), before);
+        tool.binding
+            .controller
+            .update_intent("changed".into(), vec![], vec![])
+            .unwrap();
+        let current: holycodex_policy::Intent =
+            decode_toon(&tool.execute(payload.clone()).await.unwrap()).unwrap();
+        assert_eq!(current.revision, read.revision + 1);
+        let (_dir, binding) = test_binding(HolyCodexPrincipal::specialist("assigned".into()));
+        let specialist = HolyCodexTool {
+            binding,
+            name: "intent.read",
