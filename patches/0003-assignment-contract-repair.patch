+        let request = DispatchRequest {
+            intent_revision: assignment.intent_revision,
+            role: assignment.role,
+            objective: assignment.objective,
+            bounded_scope: assignment.bounded_scope,
+            constraints: assignment.constraints,
+            acceptance_criteria: assignment.acceptance_criteria,
+            required_evidence: assignment.required_evidence,
+            mutability: assignment.mutability,
+            metadata: assignment.metadata,
+        };
