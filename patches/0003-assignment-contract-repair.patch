+    #[test]
+    fn independent_controllers_revalidate_released_ownership_and_restart() {
+        let dir = tempfile::tempdir().unwrap();
+        let dispatcher = StateStore::open(dir.path(), intent()).unwrap();
+        let updater = StateStore::open(dir.path(), intent()).unwrap();
+        let active = running(&updater, "src/a", RoleTask::WorkerImplementation);
+        let pending = candidate("src/a", RoleTask::WorkerImplementation);
+        let initial = dispatcher.read().unwrap();
+        assert!(
+            validate_dispatch_for_intent(&initial.intent, &pending, &initial.assignments).is_err()
+        );
+        updater
+            .transaction(|state| {
+                state.observe_terminal(
+                    &active.id,
+                    AssignmentStatus::Cancelled,
+                    "cancelled".into(),
+                    false,
+                )
+            })
+            .unwrap();
+        let (reserved, _) = dispatcher
+            .transaction(|state| state.reserve(pending, &grants(true), &BTreeMap::new()))
+            .unwrap();
+        let reopened = StateStore::open(dir.path(), intent()).unwrap();
+        let state = reopened.read().unwrap();
+        assert_eq!(state.intent.revision, initial.intent.revision);
+        assert_eq!(
+            state
+                .assignments
+                .iter()
+                .filter(|a| a.status == AssignmentStatus::Running)
+                .count(),
+            1
+        );
+        assert_eq!(
+            state.assignments.iter().find(|a| a.id == reserved.id),
+            Some(&reserved)
+        );
+        let before = state;
+        assert!(
+            reopened
+                .transaction(|state| state.reserve(
+                    candidate("src/a", RoleTask::WorkerImplementation),
+                    &grants(true),
+                    &BTreeMap::new()
+                ))
+                .is_err()
+        );
+        assert_eq!(reopened.read().unwrap(), before);
+    }
