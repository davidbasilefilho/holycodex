{
  "name": "@holycodex/lsp-core",
  "private": true,
  "description": "HolyCodex Language Server Protocol engine and typed tool adapters.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "import": "./src/tools.ts"
    },
    "./request-context": {
      "types": "./src/request-context.ts",
      "import": "./src/request-context.ts"
    },
    "./lsp/*": {
      "types": "./src/lsp/*.ts",
      "import": "./src/lsp/*.ts"
    }
  },
  "scripts": {
    "test": "bun test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
