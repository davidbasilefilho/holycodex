{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/version.ts\"",
            "commandWindows": "\"C:/Program Files/Git/bin/bash.exe\" -lc \"bun \\\"${PLUGIN_ROOT}/hooks/version.ts\\\"\"",
            "timeout": 10,
            "statusMessage": "HolyCodex: reporting version"
          }
        ]
      }
    ]
  }
}
