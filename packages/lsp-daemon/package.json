{
  "name": "@holycodex/lsp-daemon",
  "private": true,
  "description": "HolyCodex reusable local LSP daemon transport.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "bun test src/**/*.test.ts test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@holycodex/lsp-core": "workspace:*",
    "effect": "3.22.1"
  },
  "engines": {
    "node": ">=20"
  }
}
