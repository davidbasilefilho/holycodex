# Deliberately retained workspace inputs and safe templates
!bun.lock
!**/bun.lock
!mise.toml
!**/mise.toml
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
!*.example
!**/*.example
!*.sample
!**/*.sample
!*.template
!**/*.template
!*.tmpl
!**/*.tmpl
