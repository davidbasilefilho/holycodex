{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["packages/codex/generated/**"],
  "plugins": ["typescript", "eslint", "import", "jsdoc", "oxc", "unicorn"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "eslint/no-unused-vars": "off",
        "typescript/await-thenable": "off"
      }
    }
  ]
}
